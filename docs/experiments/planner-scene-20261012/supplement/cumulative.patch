+}
+
+bool scaling_ok(double value, double cap)
+{
+  return std::isfinite(value) && value > 0.0 && value <= cap;
+}
+
+/// 轨迹首点与期望起点（按名称）是否一致。
+bool starts_at(const mtc::core::TimedTrajectory & trajectory, const JointStateSnapshot & start)
+{
