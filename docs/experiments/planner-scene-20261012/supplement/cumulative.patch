+MoveItPlannerPort::MoveItPlannerPort(
+  PlanningBackendPtr backend,
+  PlannerConfig config,
+  mtc::core::ClockPtr clock,
+  bool asynchronous)
+: backend_(std::move(backend)),
+  config_(std::move(config)),
+  clock_(std::move(clock)),
+  asynchronous_(asynchronous)
+{
+}
+
+MoveItPlannerPort::~MoveItPlannerPort()
+{
+  std::map<std::string, std::future<PlanResult>> pending;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending.swap(jobs_);
+  }
+  for (auto & entry : pending) {
+    if (entry.second.valid()) {
+      entry.second.wait();
+    }
+  }
+}
+
+std::string MoveItPlannerPort::make_key(const mtc::manipulation::PlanTarget & target)
+{
+  std::ostringstream os;
+  os << std::setprecision(17);
+  os << target.phase << '|' << target.object_id << '|' << target.slot << '|';
+  for (const auto & primitive : target.primitives) {
+    os << primitive.name << ',';
+  }
+  os << '|' << target.has_ring_pose;
+  if (target.has_ring_pose) {
+    const auto & p = target.ring_pose;
+    os << '|' << p.frame_id << ',' << p.stamp_s << ',' << p.position.x << ',' << p.position.y <<
+      ',' << p.position.z << ',' << p.orientation.x << ',' << p.orientation.y << ',' <<
+      p.orientation.z << ',' << p.orientation.w;
+  }
+  return os.str();
+}
+
+std::optional<PlanResult> MoveItPlannerPort::plan(const mtc::manipulation::PlanTarget & target)
+{
+  if (!asynchronous_) {
+    return plan_blocking(target);
+  }
+  const auto key = make_key(target);
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto found = jobs_.find(key);
+  if (found != jobs_.end()) {
+    if (found->second.wait_for(std::chrono::seconds(0)) != std::future_status::ready) {
+      return std::nullopt;
+    }
+    PlanResult result = found->second.get();
+    jobs_.erase(found);
+    return result;
+  }
+  jobs_.emplace(key, std::async(std::launch::async, [this, target]() {
+      return plan_blocking(target);
+    }));
+  return std::nullopt;
+}
+
+PlanReport MoveItPlannerPort::last_report() const
+{
+  std::lock_guard<std::mutex> lock(mutex_);
+  return last_report_;
+}
+
+PlanResult MoveItPlannerPort::plan_blocking(
+  const mtc::manipulation::PlanTarget & target,
+  const std::optional<JointStateSnapshot> & start_override)
+{
+  PlanOptions options;
+  options.start = start_override;
+  return plan_blocking(target, options);
+}
+
+PlanResult MoveItPlannerPort::replan_primitive(
+  const mtc::manipulation::PlanTarget & original,
+  const std::string & primitive_name,
+  const JointStateSnapshot & current)
+{
+  mtc::manipulation::PlanTarget target = original;
+  target.phase = original.phase + "/REPLAN";
+  target.primitives.clear();
+  target.primitive_names.clear();
+  for (const auto & primitive : original.primitives) {
+    if (primitive.name == primitive_name) {
+      target.primitives.push_back(primitive);
+      target.primitive_names.push_back(primitive.name);
+      break;
+    }
+  }
+  PlanOptions options;
+  options.start = current;
+  options.skip_tool_gaps = true;
+  return plan_blocking(target, options);
+}
+
+PlanResult MoveItPlannerPort::plan_blocking(
+  const mtc::manipulation::PlanTarget & target, const PlanOptions & options)
+{
+  const auto & start_override = options.start;
+  std::lock_guard<std::mutex> backend_lock(backend_mutex_);
+
+  PlanReport report;
+  report.phase = target.phase;
+
+  auto finish = [this, &report](PlanResult result) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      last_report_ = report;
+      return result;
+    };
+  auto fail = [&](const std::string & reason, const std::string & primitive,
+      const std::string & detail) {
+      PlanResult failed;
+      failed.ok = false;
+      failed.error_code = ErrorCodes::PLANNING_FAILED;
+      failed.primitives = target.primitives;
+      failed.message = "[" + reason + "] " + (primitive.empty() ? "plan" : primitive) + ": " +
+        detail;
+      report.simulation_only = true;
+      return finish(failed);
+    };
+
+  if (!backend_) {
+    return fail("NO_BACKEND", "", "planning backend is not configured");
+  }
+  report.planning_frame = backend_->planning_frame();
+  report.end_effector_link = backend_->end_effector_link();
+  if (target.primitives.empty()) {
+    return fail("EMPTY_TARGET", "", "PlanTarget has no primitives");
+  }
+  if (!scaling_ok(config_.velocity_scaling, config_.scaling_cap) ||
+    !scaling_ok(config_.acceleration_scaling, config_.scaling_cap) ||
+    config_.joint_names.empty() || !(config_.timeout_factor >= 1.0) ||
+    report.planning_frame.empty())
+  {
+    return fail("INVALID_CONFIG", "",
+             "scaling must be in (0, " + fmt(config_.scaling_cap) +
+             "], timeout_factor >= 1, joint names and planning frame non-empty");
+  }
+
+  std::optional<JointStateSnapshot> start = start_override;
+  if (!start) {
+    start = backend_->current_state();
+  }
+  if (!start || !start->shape_is_valid()) {
+    return fail("NO_CURRENT_STATE", "", "robot state unavailable (is /joint_states published?)");
+  }
+  report.start_state = *start;
+  JointStateSnapshot chain = *start;
+  std::string start_assumption = start_override ? "explicit_start_state" : "current_state";
+
+  std::vector<std::string> uncalibrated;
+  auto accept_calibration = [&](const std::string & item, CalibrationStatus status) {
+      if (status == CalibrationStatus::MEASURED) {
+        return true;
+      }
+      if (status == CalibrationStatus::UNKNOWN || !config_.allow_uncalibrated_geometry) {
+        return false;
+      }
+      const std::string entry = item + "=" + to_string(status);
+      if (std::find(uncalibrated.begin(), uncalibrated.end(), entry) == uncalibrated.end()) {
+        uncalibrated.push_back(entry);
+      }
+      return true;
+    };
+
+  const Transform tcp_to_ee = inverse(config_.ee_to_tcp);
+  double stamp = clock_ ? clock_->now() : 0.0;
+  if (!std::isfinite(stamp) || stamp < 0.0) {
+    stamp = 0.0;
+  }
+
+  std::optional<AttachedPayload> payload;   // 试提时附着，释放后不再附着
+  bool payload_released = false;
+
+  std::vector<mtc::core::MotionCommand> commands;
+  for (const auto & primitive : target.primitives) {
+    PrimitivePlanReport entry;
+    entry.primitive_name = primitive.name;
+    entry.start_assumption = start_assumption;
+    auto fail_primitive = [&](const std::string & reason, const std::string & detail) {
+        entry.ok = false;
+        entry.reason = reason;
+        entry.message = detail;
+        report.primitives.push_back(entry);
+        return fail(reason, primitive.name, detail);
+      };
+
+    if (config_.tool_owned_primitives.count(primitive.name) != 0u) {
+      return fail_primitive("TOOL_OWNED_PRIMITIVE",
+               "executed by ToolPort; the planner must not emit a trajectory for it");
+    }
+    const auto spec_it = config_.primitives.find(primitive.name);
+    if (spec_it == config_.primitives.end()) {
+      return fail_primitive("UNKNOWN_PRIMITIVE", "no planning rule for this primitive");
+    }
+    const PrimitiveSpec & spec = spec_it->second;
+    entry.mode = to_string(spec.mode);
+    entry.goal_kind = to_string(spec.goal);
+    entry.contact_intent_only = spec.contact_intent_only;
+    if (!primitive.is_usable()) {
+      return fail_primitive("INVALID_PRIMITIVE",
+               "empty name, non-positive speed limit or unusable target_pose");
+    }
+
+    auto make_request = [&](const std::string & label, MotionMode mode, const Pose6D & goal) {
+        BackendRequest request;
+        request.label = label;
+        request.mode = mode;
+        request.ee_goal = goal;
+        request.start = chain;
+        request.velocity_scaling = config_.velocity_scaling;
+        request.acceleration_scaling = config_.acceleration_scaling;
+        request.max_linear_speed_m_s = primitive.max_linear_speed;
+        request.max_angular_speed_rad_s = primitive.max_angular_speed;
+        request.planning_time_s = config_.planning_time_s;
+        request.cartesian_step_m = config_.cartesian_step_m;
+        request.min_cartesian_fraction = config_.min_cartesian_fraction;
+        request.joint_bounds = config_.joint_position_limits;
+        request.prefer_straight_line =
+          mode == MotionMode::FREE_SPACE && config_.prefer_straight_line_free_space;
+        return request;
+      };
+
+    // ---- 原语前的 ToolPort 动作：只假设其终点，不输出轨迹 ----
+    if (spec.gap_before != ToolGapBefore::NONE && !options.skip_tool_gaps) {
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose for tool gap");
+      }
+      const double sign = spec.gap_before == ToolGapBefore::ENGAGE_INSERT ? 1.0 : -1.0;
+      const auto tcp_gap = offset_along_local_axis(
+        apply(*ee_now, config_.ee_to_tcp), config_.insertion_axis, sign * spec.gap_distance_m);
+      const auto gap = backend_->plan(make_request(
+          std::string("simulated_") + to_string(spec.gap_before), MotionMode::CARTESIAN,
+          apply(tcp_gap, tcp_to_ee)));
+      if (!gap.ok || !gap.end_state.shape_is_valid()) {
+        return fail_primitive("TOOL_GAP_SIMULATION_FAILED", gap.reason + ": " + gap.message);
+      }
+      chain = gap.end_state;
+      entry.start_assumption = std::string("simulated ") + to_string(spec.gap_before) + " " +
+        fmt(spec.gap_distance_m) + " m along TCP axis " + std::to_string(config_.insertion_axis) +
+        " (ToolPort motion, not emitted)";
+    }
+
+    // ---- 目标位姿（planning frame 中的 ee_link）----
+    Pose6D ee_goal;
+    if (spec.goal == GoalKind::RING_STANDOFF) {
+      std::optional<Pose6D> ring;
+      if (primitive.target_pose && primitive.target_pose->is_usable()) {
+        ring = *primitive.target_pose;
+      } else if (target.has_ring_pose && target.ring_pose.is_usable()) {
+        ring = target.ring_pose;
+      }
+      if (!ring) {
+        return fail_primitive("TARGET_POSE_MISSING",
+                 "no usable ring pose (valid, frame_id, unit quaternion) in primitive or target");
+      }
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      const auto ring_in_frame = backend_->transform_to_planning_frame(*ring);
+      if (!ring_in_frame) {
+        return fail_primitive("TF_UNAVAILABLE",
+                 "cannot transform ring pose from '" + ring->frame_id + "' to '" +
+                 report.planning_frame + "'");
+      }
+      const auto tcp_goal = offset_along_local_axis(
+        *ring_in_frame, config_.insertion_axis, -spec.distance_m);
+      ee_goal = apply(tcp_goal, tcp_to_ee);
+    } else if (spec.goal == GoalKind::RELATIVE_UP) {
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose at start state");
+      }
+      ee_goal = translate_in_frame(*ee_now, mtc::core::Vector3{0.0, 0.0, spec.distance_m});
+    } else {
+      const std::string & slot_name = target.slot;
+      if (!primitive.target_label.empty() && config_.slots.count(primitive.target_label) != 0u &&
+        primitive.target_label != slot_name)
+      {
+        return fail_primitive("SLOT_MISMATCH",
+                 "primitive targets '" + primitive.target_label + "' but request slot is '" +
+                 slot_name + "'");
+      }
+      const auto slot_it = config_.slots.find(slot_name);
+      if (slot_it == config_.slots.end() ||
+        slot_it->second.status == CalibrationStatus::UNKNOWN)
+      {
+        return fail_primitive("SLOT_POSE_UNKNOWN", "no pose for slot '" + slot_name + "'");
+      }
+      if (!accept_calibration("slot " + slot_name, slot_it->second.status)) {
+        return fail_primitive("SLOT_NOT_CALIBRATED",
+                 "slot '" + slot_name + "' is " + to_string(slot_it->second.status));
+      }
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      if (!slot_it->second.pose.is_usable()) {
+        return fail_primitive("SLOT_POSE_INVALID", "slot pose has no frame or invalid quaternion");
+      }
+      const auto slot_in_frame = backend_->transform_to_planning_frame(slot_it->second.pose);
+      if (!slot_in_frame) {
+        return fail_primitive("TF_UNAVAILABLE",
+                 "cannot transform slot '" + slot_name + "' from '" +
+                 slot_it->second.pose.frame_id + "' to '" + report.planning_frame + "'");
+      }
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose at start state");
+      }
+      // 搬运/落座保持抓取时的工具姿态（不旋转电池），只改变位置。
+      Pose6D tcp_goal = apply(*ee_now, config_.ee_to_tcp);
+      tcp_goal.position = slot_in_frame->position;
+      tcp_goal.position.z += spec.distance_m;
+      ee_goal = apply(tcp_goal, tcp_to_ee);
+    }
+    ee_goal.valid = true;
+    entry.ee_goal = ee_goal;
+
+    // ---- 载荷：试提起附着在 ee_link 上，释放后（非 carries_payload 原语）移除 ----
+    if (spec.carries_payload && config_.payload.enabled && !payload_released) {
+      if (!payload) {
+        if (!accept_calibration("payload", config_.payload.status)) {
+          return fail_primitive("PAYLOAD_UNKNOWN", "battery payload geometry is not available");
+        }
+        const auto ee_now = backend_->end_effector_pose(chain);
+        if (!ee_now) {
+          return fail_primitive("FK_FAILED", "cannot compute end-effector pose to attach payload");
+        }
+        // 电池靠重力挂在钩尖（TCP）正下方，姿态与 planning frame 对齐。
+        const auto tcp_now = apply(*ee_now, config_.ee_to_tcp);
+        Transform world_payload;
+        world_payload.translation = tcp_now.position;
+        world_payload.translation.z -= config_.payload.hang_below_tcp_m;
+        AttachedPayload attached;
+        attached.size_m = config_.payload.size_m;
+        attached.touch_links = config_.payload.touch_links;
+        attached.ee_to_payload = compose(inverse(to_transform(*ee_now)), world_payload);
+        payload = attached;
+      }
+    } else if (payload) {
+      payload.reset();
+      payload_released = true;
+    }
+    entry.payload_attached = payload.has_value();
+
+    // ---- 规划 ----
+    auto request = make_request(primitive.name, spec.mode, ee_goal);
+    request.payload = payload;
+    const auto planned = backend_->plan(request);
+    entry.planning_time_s = planned.planning_time_s;
+    entry.cartesian_fraction = planned.cartesian_fraction;
+    entry.time_scale_applied = planned.time_scale_applied;
+    entry.max_linear_speed_m_s = planned.max_linear_speed_m_s;
+    entry.max_angular_speed_rad_s = planned.max_angular_speed_rad_s;
+    entry.method = planned.method;
+    entry.backend_message = planned.message;
+    if (!planned.ok) {
+      return fail_primitive(planned.reason.empty() ? "NO_PLAN" : planned.reason, planned.message);
+    }
+
+    auto converted = to_timed_trajectory(
+      planned.trajectory, config_.joint_names, report.planning_frame, stamp);
+    if (!converted.ok) {
+      return fail_primitive("INVALID_TRAJECTORY", converted.error);
+    }
+    const auto & trajectory = converted.trajectory;
+    if (!starts_at(trajectory, chain)) {
+      return fail_primitive("START_STATE_MISMATCH",
+               "trajectory does not start at the expected start state (tolerance " +
+               fmt(kStartToleranceRad) + " rad)");
+    }
+    for (size_t j = 0; j < trajectory.joint_names.size(); ++j) {
+      const auto limit = config_.joint_position_limits.find(trajectory.joint_names[j]);
+      if (limit == config_.joint_position_limits.end()) {
+        continue;
+      }
+      for (const auto & point : trajectory.points) {
+        const double value = point.positions_rad[j];
+        if (value < limit->second.first || value > limit->second.second) {
+          return fail_primitive("JOINT_LIMIT_VIOLATION",
+                   trajectory.joint_names[j] + "=" + fmt(value) + " rad outside [" +
+                   fmt(limit->second.first) + ", " + fmt(limit->second.second) + "]");
+        }
+      }
+    }
+    const double duration = trajectory.duration_s();
+    const auto watchdog_it = config_.state_timeouts.find(spec.executing_state);
+    const double watchdog = watchdog_it != config_.state_timeouts.end() ? watchdog_it->second : 0.0;
+    entry.state_watchdog_s = watchdog;
+    entry.point_count = trajectory.points.size();
+    entry.duration_s = duration;
+    if (watchdog > 0.0 && duration > watchdog * config_.state_timeout_usage) {
+      return fail_primitive("EXCEEDS_STATE_WATCHDOG",
+               "trajectory lasts " + fmt(duration) + " s, more than " +
+               fmt(config_.state_timeout_usage * 100.0) + "% of the " +
+               mtc::manipulation::to_string(spec.executing_state) + " watchdog (" +
+               fmt(watchdog) + " s)");
+    }
+    const auto timeout_ms = static_cast<uint32_t>(
+      std::ceil(duration * config_.timeout_factor * 1000.0)) + config_.timeout_margin_ms;
+    entry.timeout_ms = timeout_ms;
+
+    mtc::core::MotionCommand command;
+    command.joint_names = trajectory.joint_names;
+    command.target_rad.clear();
+    command.velocity_scaling = config_.velocity_scaling;
+    command.acceleration_scaling = config_.acceleration_scaling;
+    command.timeout_ms = timeout_ms;
+    command.primitive_name = primitive.name;
+    command.requires_contact = primitive.requires_contact;
+    command.intent = primitive;
+    command.trajectory = trajectory;
+    commands.push_back(std::move(command));
+
+    entry.ok = true;
+    report.primitives.push_back(entry);
+    chain = planned.end_state.shape_is_valid() ?
+      planned.end_state :
+      JointStateSnapshot{trajectory.joint_names, final_positions(trajectory)};
+    start_assumption = "previous_primitive_end";
+  }
+
+  const bool simulation_only = config_.force_simulation_only || !uncalibrated.empty();
+  for (auto & command : commands) {
+    command.simulation_only = simulation_only;
+  }
+  report.simulation_only = simulation_only;
+  report.uncalibrated_inputs = uncalibrated;
+
+  PlanResult result;
+  result.ok = true;
+  result.error_code = ErrorCodes::OK;
+  result.primitives = target.primitives;
+  result.commands = std::move(commands);
+  std::ostringstream message;
+  message << "planned " << result.commands.size() << " primitive(s) in frame '" <<
+    report.planning_frame << "' for '" << report.end_effector_link <<
+    "'; simulation_only=" << (simulation_only ? "true" : "false");
+  if (!uncalibrated.empty()) {
+    message << " (uncalibrated:";
+    for (const auto & item : uncalibrated) {
+      message << ' ' << item;
+    }
+    message << ')';
+  }
+  result.message = message.str();
+  return finish(result);
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp b/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp
new file mode 100644
index 0000000..40b0f4d
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp
@@ -0,0 +1,206 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 单块电池基础任务的运动阶段规划（Mock，仅规划不执行）。
+//
+// 用已合入的 ToolStrategy 生成与 PickPlaceFsm **完全相同**的两次规划请求：
+//   ACQUIRE   = make_acquire_plan + make_test_lift_plan            （PLAN_ACQUIRE 状态）
+//   TRANSPORT = lift + transport + pre_seat + seat_contact + retreat（LIFT 状态）
+// 第二次以第一次 test_lift 轨迹终点为起点（模拟 FSM 中试提已执行完）。
+// 提环位姿与工位均为占位值（见 config/planner.yaml），输出 simulation_only=true。
+
+#include <iomanip>
+#include <memory>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rclcpp/rclcpp.hpp>
+
+#include "mtc_core_cpp/clock.hpp"
+#include "mtc_manipulation_cpp/tool_strategy.hpp"
+#include "mtc_moveit_planner/move_group_backend.hpp"
+#include "mtc_moveit_planner/moveit_planner_port.hpp"
+#include "mtc_moveit_planner/plan_report_io.hpp"
+#include "mtc_moveit_planner/ros_params.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace
+{
+
+using mtc::manipulation::PlanTarget;
+using mtc::moveit_planner::JointStateSnapshot;
+using mtc::moveit_planner::MoveGroupBackend;
+using mtc::moveit_planner::MoveItPlannerPort;
+
+PlanTarget make_target(
+  const std::string & phase, const mtc::core::PoseEstimate & ring, const std::string & slot,
+  const mtc::core::MotionPrimitiveList & primitives)
+{
+  PlanTarget target;
+  target.phase = phase;
+  target.object_id = ring.object_id;
+  target.slot = slot;
+  target.has_ring_pose = ring.has_ring_pose();
+  target.ring_pose = ring.ring_pose;
+  target.primitives = primitives;
+  for (const auto & p : primitives) {
+    target.primitive_names.push_back(p.name);
+  }
+  return target;
+}
+
+void log_report(const rclcpp::Logger & logger, const mtc::core::PlanResult & result,
+  const mtc::moveit_planner::PlanReport & report)
+{
+  RCLCPP_INFO(logger, "[%s] ok=%s code=%u %s", report.phase.c_str(), result.ok ? "true" : "false",
+    result.error_code, result.message.c_str());
+  for (const auto & p : report.primitives) {
+    RCLCPP_INFO(logger,
+      "  %-13s %-10s %-19s %s ok=%-5s plan=%.3fs dur=%.2fs pts=%zu scale=%.2f v=%.3fm/s w=%.3frad/s "
+      "watchdog=%.0fs %s%s",
+      p.primitive_name.c_str(), p.mode.c_str(), p.method.c_str(),
+      p.payload_attached ? "[payload]" : "         ", p.ok ? "true" : "false",
+      p.planning_time_s,
+      p.duration_s, p.point_count, p.time_scale_applied, p.max_linear_speed_m_s,
+      p.max_angular_speed_rad_s, p.state_watchdog_s,
+      p.contact_intent_only ? "[contact intent only] " : "",
+      p.ok ? p.start_assumption.c_str() : (p.reason + ": " + p.message).c_str());
+    if (!p.backend_message.empty() && p.backend_message != "ok") {
+      RCLCPP_INFO(logger, "      backend: %s", p.backend_message.c_str());
+    }
+  }
+}
+
+int run(const std::shared_ptr<rclcpp::Node> & node)
+{
+  const auto logger = node->get_logger();
+  const auto config = mtc::moveit_planner::load_planner_config(*node);
+  const auto options = mtc::moveit_planner::load_backend_options(*node);
+  const std::string output_dir = node->get_parameter_or<std::string>("output_dir", "planning_evidence");
+  const std::string tool = node->get_parameter_or<std::string>(
+    "sequence.tool_type", mtc::manipulation::TOOL_PASSIVE_HOOK_V1);
+  const std::string slot = node->get_parameter_or<std::string>("sequence.slot", "T0");
+  // 规划起点：SRDF 命名状态（默认 "home"）；为空则用 /joint_states 当前状态。只规划，不移动机器人。
+  const std::string start_named_state =
+    node->get_parameter_or<std::string>("sequence.start_named_state", "home");
+
+  mtc::core::PoseEstimate ring;
+  ring.object_id = node->get_parameter_or<std::string>("sequence.object_id", "battery_1");
+  ring.color = static_cast<int>(node->get_parameter_or<int64_t>("sequence.color", 1));
+  const auto xyz = node->get_parameter_or<std::vector<double>>(
+    "sequence.ring.xyz", {0.40, -0.05, 0.13});
+  const auto q = node->get_parameter_or<std::vector<double>>(
+    "sequence.ring.quat_xyzw", {0.0, 0.70710678, 0.0, 0.70710678});
+  if (xyz.size() != 3 || q.size() != 4) {
+    RCLCPP_ERROR(logger, "sequence.ring.xyz needs 3 values, sequence.ring.quat_xyzw needs 4");
+    return 2;
+  }
+  ring.has_ring_pose_value = true;
+  ring.ring_pose_valid = true;
+  ring.ring_pose.frame_id = node->get_parameter_or<std::string>("sequence.ring.frame_id", "base_link");
+  ring.ring_pose.position = mtc::core::Vector3{xyz[0], xyz[1], xyz[2]};
+  ring.ring_pose.orientation = mtc::core::Quaternion{q[0], q[1], q[2], q[3]};
+  ring.ring_pose.stamp_s = 0.0;
+  ring.ring_pose.valid = true;
+
+  const auto strategy = mtc::manipulation::make_strategy(tool);
+  auto backend = std::make_shared<MoveGroupBackend>(node, options);
+  if (!backend->apply_scene(config.scene_boxes)) {
+    RCLCPP_ERROR(logger, "failed to apply planning scene obstacles");
+    return 2;
+  }
+  RCLCPP_INFO(logger, "planning scene: %zu static obstacle(s) applied",
+    config.scene_boxes.size());
+  MoveItPlannerPort port(backend, config, std::make_shared<mtc::core::SteadyClock>(), false);
+
+  auto acquire_primitives = strategy->make_acquire_plan(ring);
+  const auto test_lift = strategy->make_test_lift_plan(ring);
+  acquire_primitives.insert(acquire_primitives.end(), test_lift.begin(), test_lift.end());
+  const auto acquire = make_target("ACQUIRE", ring, slot, acquire_primitives);
+  std::optional<JointStateSnapshot> acquire_start;
+  if (!start_named_state.empty()) {
+    acquire_start = backend->named_state(start_named_state);
+    if (!acquire_start) {
+      RCLCPP_ERROR(logger, "SRDF named state '%s' not found", start_named_state.c_str());
+      return 2;
+    }
+  }
+  const auto acquire_result = port.plan_blocking(acquire, acquire_start);
+  const auto acquire_report = port.last_report();
+  log_report(logger, acquire_result, acquire_report);
+
+  std::ostringstream yaml;
+  yaml << "# mtc_moveit_planner plan_battery_sequence 证据（Mock，仅规划，未执行）\n";
+  yaml << "# 提环位姿与工位均为占位值；接触段只代表规划意图，不代表可安全执行。\n";
+  yaml << "tool: plan_battery_sequence\n";
+  yaml << "wall_time: \"" << mtc::moveit_planner::timestamp_for_filename() << "\"\n";
+  yaml << "tool_type: \"" << tool << "\"\n";
+  yaml << "slot: \"" << slot << "\"\n";
+  yaml << "start: \"" << (start_named_state.empty() ? std::string("current /joint_states") :
+    "SRDF named state " + start_named_state) << "\"\n";
+  yaml << "ring_pose:\n" << mtc::moveit_planner::pose_to_yaml(ring.ring_pose, "  ");
+  yaml << "tcp:\n";
+  yaml << "  status: \"" << mtc::moveit_planner::to_string(config.tcp_status) << "\"\n";
+  yaml << "  xyz: [" << config.ee_to_tcp.translation.x << ", " << config.ee_to_tcp.translation.y <<
+    ", " << config.ee_to_tcp.translation.z << "]\n";
+  yaml << "phases:\n";
+  yaml << "  - " << mtc::moveit_planner::plan_to_yaml(acquire_result, acquire_report, "    ").substr(4);
+
+  bool ok = acquire_result.ok;
+  if (acquire_result.ok && !acquire_result.commands.empty() &&
+    acquire_result.commands.back().trajectory)
+  {
+    const auto & last = *acquire_result.commands.back().trajectory;
+    const JointStateSnapshot after_test_lift{
+      last.joint_names, mtc::moveit_planner::final_positions(last)};
+    auto transport_primitives = strategy->make_lift_plan(ring);
+    for (const auto & extra : {
+        strategy->make_transport_plan(ring, slot), strategy->make_seat_plan(slot),
+        strategy->make_seat_contact_plan(slot), strategy->make_retreat_plan(slot)})
+    {
+      transport_primitives.insert(transport_primitives.end(), extra.begin(), extra.end());
+    }
+    const auto transport = make_target("TRANSPORT", ring, slot, transport_primitives);
+    const auto transport_result = port.plan_blocking(transport, after_test_lift);
+    const auto transport_report = port.last_report();
+    log_report(logger, transport_result, transport_report);
+    yaml << "  - " <<
+      mtc::moveit_planner::plan_to_yaml(transport_result, transport_report, "    ").substr(4);
+    ok = ok && transport_result.ok;
+  }
+
+  const std::string path = output_dir + "/battery_sequence_" + tool + "_" + slot + "_" +
+    mtc::moveit_planner::timestamp_for_filename() + ".yaml";
+  if (!mtc::moveit_planner::write_text_file(path, yaml.str())) {
+    RCLCPP_ERROR(logger, "failed to write %s", path.c_str());
+    return 3;
+  }
+  RCLCPP_INFO(logger, "%s -> %s", ok ? "SEQUENCE PLAN OK" : "SEQUENCE PLAN FAILED", path.c_str());
+  return ok ? 0 : 1;
+}
+
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  rclcpp::init(argc, argv);
+  rclcpp::NodeOptions node_options;
+  node_options.automatically_declare_parameters_from_overrides(true);
+  auto node = std::make_shared<rclcpp::Node>("mtc_plan_battery_sequence", node_options);
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(node);
+  std::thread spinner([&executor]() {executor.spin();});
+  int rc = 1;
+  try {
+    rc = run(node);
+  } catch (const std::exception & error) {
+    RCLCPP_ERROR(node->get_logger(), "fatal: %s", error.what());
+    rc = 4;
+  }
+  executor.cancel();
+  spinner.join();
+  rclcpp::shutdown();
+  return rc;
+}
diff --git a/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp b/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp
new file mode 100644
index 0000000..dba076d
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp
@@ -0,0 +1,209 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// P0 证据工具：从当前机器人状态规划到一个**固定、可复现**的 6D 目标位姿，
+// 输出返回状态、规划耗时与完整时间参数化轨迹（YAML）。只规划，不执行。
+//
+// 默认目标：SRDF 命名状态 "home" 的 ee_link 正运动学位姿（保证可达、可复现）。
+// 也可用参数 target.mode:=pose 指定 target.frame_id / target.xyz / target.quat_xyzw。
+
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rclcpp/rclcpp.hpp>
+
+#include "mtc_moveit_planner/move_group_backend.hpp"
+#include "mtc_moveit_planner/plan_report_io.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+#include "mtc_moveit_planner/ros_params.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace
+{
+
+using mtc::moveit_planner::BackendRequest;
+using mtc::moveit_planner::JointStateSnapshot;
+using mtc::moveit_planner::MotionMode;
+using mtc::moveit_planner::MoveGroupBackend;
+
+std::string num(double v)
+{
+  std::ostringstream os;
+  os << std::setprecision(10) << v;
+  return os.str();
+}
+
+int run(const std::shared_ptr<rclcpp::Node> & node)
+{
+  const auto logger = node->get_logger();
+  const auto planner_config = mtc::moveit_planner::load_planner_config(*node);
+  const auto options = mtc::moveit_planner::load_backend_options(*node);
+  const std::string output_dir = node->get_parameter_or<std::string>("output_dir", "planning_evidence");
+  const std::string target_mode = node->get_parameter_or<std::string>("target.mode", "named_state_fk");
+  const std::string named = node->get_parameter_or<std::string>("target.named_state", "home");
+
+  auto backend = std::make_shared<MoveGroupBackend>(node, options);
+  if (!backend->apply_scene(planner_config.scene_boxes)) {
+    RCLCPP_ERROR(logger, "failed to apply planning scene obstacles");
+    return 2;
+  }
+  RCLCPP_INFO(logger, "planning scene: %zu static obstacle(s) applied",
+    planner_config.scene_boxes.size());
+  RCLCPP_INFO(logger, "planning frame='%s' ee_link='%s' group='%s' pipeline='%s' planner='%s'",
+    backend->planning_frame().c_str(), backend->end_effector_link().c_str(),
+    options.planning_group.c_str(), options.planning_pipeline.c_str(), options.planner_id.c_str());
+
+  std::optional<JointStateSnapshot> start;
+  for (int i = 0; i < 10 && !start; ++i) {
+    start = backend->current_state();
+  }
+  if (!start) {
+    RCLCPP_ERROR(logger, "no current robot state from /joint_states");
+    return 2;
+  }
+
+  mtc::core::Pose6D target;
+  if (target_mode == "named_state_fk") {
+    const auto js = backend->named_state(named);
+    if (!js) {
+      RCLCPP_ERROR(logger, "SRDF named state '%s' not found", named.c_str());
+      return 2;
+    }
+    const auto fk = backend->end_effector_pose(*js);
+    if (!fk) {
+      RCLCPP_ERROR(logger, "FK failed for named state '%s'", named.c_str());
+      return 2;
+    }
+    target = *fk;
+  } else {
+    const auto xyz = node->get_parameter_or<std::vector<double>>("target.xyz", {});
+    const auto q = node->get_parameter_or<std::vector<double>>("target.quat_xyzw", {});
+    if (xyz.size() != 3 || q.size() != 4) {
+      RCLCPP_ERROR(logger, "target.xyz needs 3 values and target.quat_xyzw needs 4");
+      return 2;
+    }
+    target.frame_id = node->get_parameter_or<std::string>("target.frame_id", backend->planning_frame());
+    target.position = mtc::core::Vector3{xyz[0], xyz[1], xyz[2]};
+    target.orientation = mtc::core::Quaternion{q[0], q[1], q[2], q[3]};
+    target.valid = true;
+    if (!target.orientation.is_normalized()) {
+      RCLCPP_ERROR(logger, "target quaternion is not normalized (norm=%f)", target.orientation.norm());
+      return 2;
+    }
+  }
+
+  BackendRequest request;
+  request.label = "fixed_pose_test";
+  request.mode = MotionMode::FREE_SPACE;
+  request.ee_goal = target;
+  request.start = *start;
+  request.velocity_scaling = planner_config.velocity_scaling;
+  request.acceleration_scaling = planner_config.acceleration_scaling;
+  request.max_linear_speed_m_s = node->get_parameter_or("target.max_linear_speed_m_s", 0.0);
+  request.max_angular_speed_rad_s = node->get_parameter_or("target.max_angular_speed_rad_s", 0.0);
+  request.planning_time_s = planner_config.planning_time_s;
+  request.joint_bounds = planner_config.joint_position_limits;
+
+  const auto result = backend->plan(request);
+  const double stamp = node->now().seconds();
+  mtc::moveit_planner::ConversionResult converted;
+  double position_error = -1.0;
+  double angle_error = -1.0;
+  if (result.ok) {
+    converted = mtc::moveit_planner::to_timed_trajectory(
+      result.trajectory, planner_config.joint_names, backend->planning_frame(), stamp);
+    const auto target_in_frame = backend->transform_to_planning_frame(target);
+    const auto reached = backend->end_effector_pose(result.end_state);
+    if (target_in_frame && reached) {
+      position_error = mtc::moveit_planner::distance_between(
+        reached->position, target_in_frame->position);
+      angle_error = mtc::moveit_planner::angle_between(
+        reached->orientation, target_in_frame->orientation);
+    }
+  }
+  const bool ok = result.ok && converted.ok;
+
+  std::ostringstream yaml;
+  yaml << "# mtc_moveit_planner plan_fixed_pose 证据（Mock / Fake Hardware，仅规划，未执行）\n";
+  yaml << "tool: plan_fixed_pose\n";
+  yaml << "wall_time: \"" << mtc::moveit_planner::timestamp_for_filename() << "\"\n";
+  yaml << "ros_time_s: " << num(stamp) << '\n';
+  yaml << "configuration:\n";
+  yaml << "  planning_group: \"" << options.planning_group << "\"\n";
+  yaml << "  planning_frame: \"" << backend->planning_frame() << "\"\n";
+  yaml << "  end_effector_link: \"" << backend->end_effector_link() << "\"\n";
+  yaml << "  planning_pipeline: \"" << options.planning_pipeline << "\"\n";
+  yaml << "  planner_id: \"" << options.planner_id << "\"\n";
+  yaml << "  velocity_scaling: " << num(request.velocity_scaling) << '\n';
+  yaml << "  acceleration_scaling: " << num(request.acceleration_scaling) << '\n';
+  yaml << "  planning_time_limit_s: " << num(request.planning_time_s) << '\n';
+  yaml << "start_state:\n" << mtc::moveit_planner::joint_state_to_yaml(*start, "  ");
+  yaml << "target:\n";
+  yaml << "  mode: \"" << target_mode << "\"\n";
+  if (target_mode == "named_state_fk") {
+    yaml << "  named_state: \"" << named << "\"\n";
+  }
+  yaml << "  ee_link_pose:\n" << mtc::moveit_planner::pose_to_yaml(target, "    ");
+  yaml << "result:\n";
+  yaml << "  ok: " << (ok ? "true" : "false") << '\n';
+  yaml << "  reason: \"" << (result.ok ? (converted.ok ? "" : "INVALID_TRAJECTORY") : result.reason) << "\"\n";
+  yaml << "  message: \"" << (result.ok && !converted.ok ? converted.error : result.message) << "\"\n";
+  yaml << "  planning_time_s: " << num(result.planning_time_s) << '\n';
+  yaml << "  time_scale_applied: " << num(result.time_scale_applied) << '\n';
+  yaml << "  max_ee_linear_speed_m_s: " << num(result.max_linear_speed_m_s) << '\n';
+  yaml << "  max_ee_angular_speed_rad_s: " << num(result.max_angular_speed_rad_s) << '\n';
+  yaml << "  final_position_error_m: " << num(position_error) << '\n';
+  yaml << "  final_orientation_error_rad: " << num(angle_error) << '\n';
+  if (ok) {
+    yaml << "  end_state:\n" << mtc::moveit_planner::joint_state_to_yaml(result.end_state, "    ");
+    yaml << "trajectory:  # mtc::core::TimedTrajectory，关节顺序 = PickPlaceConfig::joint_names\n";
+    yaml << mtc::moveit_planner::trajectory_to_yaml(converted.trajectory, "  ");
+  }
+
+  const std::string path = output_dir + "/fixed_pose_plan_" +
+    mtc::moveit_planner::timestamp_for_filename() + ".yaml";
+  if (!mtc::moveit_planner::write_text_file(path, yaml.str())) {
+    RCLCPP_ERROR(logger, "failed to write %s", path.c_str());
+    return 3;
+  }
+  if (ok) {
+    RCLCPP_INFO(logger,
+      "PLAN OK: planning_time=%.3f s, duration=%.3f s, points=%zu, final_pos_err=%.2e m, "
+      "final_rot_err=%.2e rad -> %s",
+      result.planning_time_s, converted.trajectory.duration_s(), converted.trajectory.points.size(),
+      position_error, angle_error, path.c_str());
+  } else {
+    RCLCPP_ERROR(logger, "PLAN FAILED [%s] %s -> %s", result.reason.c_str(),
+      result.message.c_str(), path.c_str());
+  }
+  return ok ? 0 : 1;
+}
+
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  rclcpp::init(argc, argv);
+  rclcpp::NodeOptions node_options;
+  node_options.automatically_declare_parameters_from_overrides(true);
+  auto node = std::make_shared<rclcpp::Node>("mtc_plan_fixed_pose", node_options);
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(node);
+  std::thread spinner([&executor]() {executor.spin();});
+  int rc = 1;
+  try {
+    rc = run(node);
+  } catch (const std::exception & error) {
+    RCLCPP_ERROR(node->get_logger(), "fatal: %s", error.what());
+    rc = 4;
+  }
+  executor.cancel();
+  spinner.join();
+  rclcpp::shutdown();
+  return rc;
+}
diff --git a/src/mtc_moveit_planner/src/plan_report_io.cpp b/src/mtc_moveit_planner/src/plan_report_io.cpp
new file mode 100644
index 0000000..9fd1ff3
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_report_io.cpp
@@ -0,0 +1,193 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/plan_report_io.hpp"
+
+#include <chrono>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+namespace
+{
+
+std::string num(double value)
+{
+  std::ostringstream os;
+  os << std::setprecision(10) << value;
+  return os.str();
+}
+
+std::string list(const std::vector<double> & values)
+{
+  std::ostringstream os;
+  os << '[';
+  for (size_t i = 0; i < values.size(); ++i) {
+    os << (i ? ", " : "") << num(values[i]);
+  }
+  os << ']';
+  return os.str();
+}
+
+std::string list(const std::vector<std::string> & values)
+{
+  std::ostringstream os;
+  os << '[';
+  for (size_t i = 0; i < values.size(); ++i) {
+    os << (i ? ", " : "") << '"' << values[i] << '"';
+  }
+  os << ']';
+  return os.str();
+}
+
+std::string quoted(const std::string & text)
+{
+  std::string out = "\"";
+  for (char c : text) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+    }
+    out += c;
+  }
+  return out + "\"";
+}
+
+}  // namespace
+
+std::string pose_to_yaml(const mtc::core::Pose6D & pose, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "frame_id: " << quoted(pose.frame_id) << '\n';
+  os << indent << "position_m: " << list({pose.position.x, pose.position.y, pose.position.z}) <<
+    '\n';
+  os << indent << "orientation_xyzw: " <<
+    list({pose.orientation.x, pose.orientation.y, pose.orientation.z, pose.orientation.w}) << '\n';
+  return os.str();
+}
+
+std::string joint_state_to_yaml(const JointStateSnapshot & state, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "joint_names: " << list(state.names) << '\n';
+  os << indent << "positions_rad: " << list(state.positions) << '\n';
+  return os.str();
+}
+
+std::string trajectory_to_yaml(
+  const mtc::core::TimedTrajectory & trajectory, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "trajectory_id: " << quoted(trajectory.trajectory_id) << '\n';
+  os << indent << "header_frame_id: " << quoted(trajectory.header_frame_id) << '\n';
+  os << indent << "stamp_s: " << num(trajectory.stamp_s) << '\n';
+  os << indent << "shape_is_valid: " << (trajectory.shape_is_valid() ? "true" : "false") << '\n';
+  os << indent << "duration_s: " << num(trajectory.duration_s()) << '\n';
+  os << indent << "point_count: " << trajectory.points.size() << '\n';
+  os << indent << "joint_names: " << list(trajectory.joint_names) << '\n';
+  os << indent << "points:\n";
+  for (const auto & point : trajectory.points) {
+    os << indent << "  - time_from_start_s: " << num(point.time_from_start_s) << '\n';
+    os << indent << "    positions_rad: " << list(point.positions_rad) << '\n';
+    if (!point.velocities_rad_s.empty()) {
+      os << indent << "    velocities_rad_s: " << list(point.velocities_rad_s) << '\n';
+    }
+    if (!point.accelerations_rad_s2.empty()) {
+      os << indent << "    accelerations_rad_s2: " << list(point.accelerations_rad_s2) << '\n';
+    }
+  }
+  return os.str();
+}
+
+std::string plan_to_yaml(
+  const mtc::core::PlanResult & result, const PlanReport & report, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "phase: " << quoted(report.phase) << '\n';
+  os << indent << "ok: " << (result.ok ? "true" : "false") << '\n';
+  os << indent << "error_code: " << result.error_code << '\n';
+  os << indent << "message: " << quoted(result.message) << '\n';
+  os << indent << "planning_frame: " << quoted(report.planning_frame) << '\n';
+  os << indent << "end_effector_link: " << quoted(report.end_effector_link) << '\n';
+  os << indent << "simulation_only: " << (report.simulation_only ? "true" : "false") << '\n';
+  os << indent << "uncalibrated_inputs: " << list(report.uncalibrated_inputs) << '\n';
+  os << indent << "start_state:\n" << joint_state_to_yaml(report.start_state, indent + "  ");
+  os << indent << "primitives:\n";
+  for (const auto & p : report.primitives) {
+    os << indent << "  - primitive_name: " << quoted(p.primitive_name) << '\n';
+    os << indent << "    ok: " << (p.ok ? "true" : "false") << '\n';
+    if (!p.ok) {
+      os << indent << "    reason: " << quoted(p.reason) << '\n';
+    }
+    os << indent << "    message: " << quoted(p.message) << '\n';
+    os << indent << "    mode: " << quoted(p.mode) << '\n';
+    os << indent << "    method: " << quoted(p.method) << '\n';
+    os << indent << "    backend_message: " << quoted(p.backend_message) << '\n';
+    os << indent << "    payload_attached: " << (p.payload_attached ? "true" : "false") << '\n';
+    os << indent << "    goal_kind: " << quoted(p.goal_kind) << '\n';
+    os << indent << "    start_assumption: " << quoted(p.start_assumption) << '\n';
+    os << indent << "    contact_intent_only: " << (p.contact_intent_only ? "true" : "false") <<
+      '\n';
+    os << indent << "    ee_goal:\n" << pose_to_yaml(p.ee_goal, indent + "      ");
+    os << indent << "    planning_time_s: " << num(p.planning_time_s) << '\n';
+    os << indent << "    cartesian_fraction: " << num(p.cartesian_fraction) << '\n';
+    os << indent << "    time_scale_applied: " << num(p.time_scale_applied) << '\n';
+    os << indent << "    max_ee_linear_speed_m_s: " << num(p.max_linear_speed_m_s) << '\n';
+    os << indent << "    max_ee_angular_speed_rad_s: " << num(p.max_angular_speed_rad_s) << '\n';
+    os << indent << "    duration_s: " << num(p.duration_s) << '\n';
+    os << indent << "    point_count: " << p.point_count << '\n';
+    os << indent << "    timeout_ms: " << p.timeout_ms << '\n';
+    os << indent << "    state_watchdog_s: " << num(p.state_watchdog_s) << '\n';
+  }
+  os << indent << "commands:\n";
+  for (const auto & c : result.commands) {
+    os << indent << "  - primitive_name: " << quoted(c.primitive_name) << '\n';
+    os << indent << "    command_id: " << quoted(c.command_id) << "  # FSM 在派发时赋值\n";
+    os << indent << "    velocity_scaling: " << num(c.velocity_scaling) << '\n';
+    os << indent << "    acceleration_scaling: " << num(c.acceleration_scaling) << '\n';
+    os << indent << "    timeout_ms: " << c.timeout_ms << '\n';
+    os << indent << "    requires_contact: " << (c.requires_contact ? "true" : "false") << '\n';
+    os << indent << "    simulation_only: " << (c.simulation_only ? "true" : "false") << '\n';
+    os << indent << "    target_rad: " << list(c.target_rad) << '\n';
+    if (c.trajectory) {
+      os << indent << "    trajectory:\n" << trajectory_to_yaml(*c.trajectory, indent + "      ");
+    }
+  }
+  return os.str();
+}
+
+bool write_text_file(const std::string & path, const std::string & content)
+{
+  try {
+    const std::filesystem::path p(path);
+    if (p.has_parent_path()) {
+      std::filesystem::create_directories(p.parent_path());
+    }
+    std::ofstream out(path);
+    if (!out) {
+      return false;
+    }
+    out << content;
+    return static_cast<bool>(out);
+  } catch (const std::exception &) {
+    return false;
+  }
+}
+
+std::string timestamp_for_filename()
+{
+  const auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+  std::tm local{};
+  localtime_r(&now, &local);
+  std::ostringstream os;
+  os << std::put_time(&local, "%Y%m%d_%H%M%S");
+  return os.str();
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/src/planner_config.cpp b/src/mtc_moveit_planner/src/planner_config.cpp
new file mode 100644
index 0000000..12b1235
--- /dev/null
+++ b/src/mtc_moveit_planner/src/planner_config.cpp
@@ -0,0 +1,158 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/planner_config.hpp"
+
+#include <cmath>
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+using mtc::manipulation::PickPlaceState;
+
+const char * to_string(MotionMode mode)
+{
+  switch (mode) {
+    case MotionMode::FREE_SPACE: return "FREE_SPACE";
+    case MotionMode::CARTESIAN: return "CARTESIAN";
+  }
+  return "UNKNOWN";
+}
+
+const char * to_string(CalibrationStatus status)
+{
+  switch (status) {
+    case CalibrationStatus::MEASURED: return "MEASURED";
+    case CalibrationStatus::ESTIMATED: return "ESTIMATED";
+    case CalibrationStatus::PLACEHOLDER: return "PLACEHOLDER";
+    case CalibrationStatus::UNKNOWN: return "UNKNOWN";
+  }
+  return "UNKNOWN";
+}
+
+std::optional<CalibrationStatus> calibration_status_from_string(const std::string & text)
+{
+  if (text == "MEASURED") {return CalibrationStatus::MEASURED;}
+  if (text == "ESTIMATED") {return CalibrationStatus::ESTIMATED;}
+  if (text == "PLACEHOLDER") {return CalibrationStatus::PLACEHOLDER;}
+  if (text == "UNKNOWN") {return CalibrationStatus::UNKNOWN;}
+  return std::nullopt;
+}
+
+const char * to_string(GoalKind kind)
+{
+  switch (kind) {
+    case GoalKind::RING_STANDOFF: return "RING_STANDOFF";
+    case GoalKind::RELATIVE_UP: return "RELATIVE_UP";
+    case GoalKind::SLOT_OFFSET: return "SLOT_OFFSET";
+  }
+  return "UNKNOWN";
+}
+
+const char * to_string(ToolGapBefore gap)
+{
+  switch (gap) {
+    case ToolGapBefore::NONE: return "NONE";
+    case ToolGapBefore::ENGAGE_INSERT: return "ENGAGE_INSERT";
+    case ToolGapBefore::WITHDRAW: return "WITHDRAW";
+  }
+  return "UNKNOWN";
+}
+
+namespace
+{
+
+PrimitiveSpec spec(
+  MotionMode mode, GoalKind goal, double distance_m, PickPlaceState state,
+  ToolGapBefore gap = ToolGapBefore::NONE, double gap_distance_m = 0.0,
+  bool contact_intent_only = false)
+{
+  PrimitiveSpec out;
+  out.mode = mode;
+  out.goal = goal;
+  out.distance_m = distance_m;
+  out.executing_state = state;
+  out.gap_before = gap;
+  out.gap_distance_m = gap_distance_m;
+  out.contact_intent_only = contact_intent_only;
+  return out;
+}
+
+SlotSpec placeholder_slot(double x, double y, double z)
+{
+  SlotSpec slot;
+  slot.pose.position = mtc::core::Vector3{x, y, z};
+  slot.pose.orientation = mtc::core::Quaternion{0.0, 0.0, 0.0, 1.0};
+  slot.pose.frame_id = "base_link";
+  slot.pose.stamp_s = 0.0;
+  slot.pose.valid = true;
+  slot.status = CalibrationStatus::PLACEHOLDER;
+  return slot;
+}
+
+}  // namespace
+
+PlannerConfig default_planner_config()
+{
+  PlannerConfig config;
+
+  // 距离取自 config/motion_profiles.yaml（全部为占位值）：
+  //   engage.distance_m=0.03（预对准退让 = 插入行程）、test_lift 0.01、lift 0.05、
+  //   seat.distance_m=0.02（落座前余量）、disengage 0.03、retreat 0.10；
+  //   config/manipulation.yaml slot_approach_height_m=0.10。
+  constexpr double kInsertTravel = 0.03;
+  constexpr double kTestLift = 0.01;
+  constexpr double kLift = 0.05;
+  constexpr double kSlotApproachHeight = 0.10;
+  constexpr double kPreSeatClearance = 0.02;
+  constexpr double kWithdrawTravel = 0.03;
+  constexpr double kRetreat = 0.10;
+
+  auto & p = config.primitives;
+  // 抓取侧（PLAN_ACQUIRE 一次规划 acquire + test_lift）
+  p["side_insert"] = spec(MotionMode::FREE_SPACE, GoalKind::RING_STANDOFF, kInsertTravel,
+      PickPlaceState::MOVE_PRE_ALIGN);
+  p["top_insert"] = spec(MotionMode::FREE_SPACE, GoalKind::RING_STANDOFF, kInsertTravel,
+      PickPlaceState::MOVE_PRE_ALIGN);
+  p["test_lift"] = spec(MotionMode::CARTESIAN, GoalKind::RELATIVE_UP, kTestLift,
+      PickPlaceState::TEST_LIFT, ToolGapBefore::ENGAGE_INSERT, kInsertTravel);
+  // 搬运侧（LIFT 状态一次规划 lift + transport + pre_seat + seat_contact + retreat）
+  p["lift"] = spec(MotionMode::CARTESIAN, GoalKind::RELATIVE_UP, kLift, PickPlaceState::LIFT);
+  p["transport"] = spec(MotionMode::FREE_SPACE, GoalKind::SLOT_OFFSET, kSlotApproachHeight,
+      PickPlaceState::TRANSPORT);
+  p["pre_seat"] = spec(MotionMode::CARTESIAN, GoalKind::SLOT_OFFSET, kPreSeatClearance,
+      PickPlaceState::MOVE_PRE_SEAT);
+  p["seat_contact"] = spec(MotionMode::CARTESIAN, GoalKind::SLOT_OFFSET, 0.0,
+      PickPlaceState::SEAT, ToolGapBefore::NONE, 0.0, true);
+  // 试提之后、释放之前，末端挂着电池。
+  for (const char * name : {"test_lift", "lift", "transport", "pre_seat", "seat_contact"}) {
+    p[name].carries_payload = true;
+  }
+  p["retreat"] = spec(MotionMode::CARTESIAN, GoalKind::RELATIVE_UP, kRetreat,
+      PickPlaceState::RETREAT, ToolGapBefore::WITHDRAW, kWithdrawTravel);
+
+  // 由 ToolPort 执行的接触动作：规划器拒绝为其输出轨迹。
+  config.tool_owned_primitives = {"hook_engage", "auto_lock", "unload", "side_withdraw", "withdraw"};
+
+  // aubo_description/urdf/xacro/inc/aubo.ros2_control.xacro 的 command_interface min/max。
+  const double two_pi = 2.0 * M_PI;
+  config.joint_position_limits = {
+    {"shoulder_joint", {-two_pi, two_pi}},
+    {"upperArm_joint", {-two_pi, two_pi}},
+    {"foreArm_joint", {-2.41, 2.41}},
+    {"wrist1_joint", {-2.66, 2.66}},
+    {"wrist2_joint", {-two_pi, two_pi}},
+    {"wrist3_joint", {-2.23, 2.23}},
+  };
+
+  // 占位工位（base_link，单位 m）：只为 Mock 规划可达，非实测，禁止用于真实运动。
+  config.slots["T0"] = placeholder_slot(0.35, -0.20, 0.13);
+  config.slots["P1"] = placeholder_slot(0.35, -0.05, 0.13);
+  config.slots["P2"] = placeholder_slot(0.35, 0.10, 0.13);
+  config.slots["P3"] = placeholder_slot(0.35, 0.25, 0.13);
+  return config;
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
