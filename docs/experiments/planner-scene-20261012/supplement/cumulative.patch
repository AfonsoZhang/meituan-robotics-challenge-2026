+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 规划层配置：原语 -> 规划方式表、工位位姿、TCP、速度缩放与超时策略。
+//
+// 数值默认来自 config/motion_profiles.yaml 与 config/manipulation.yaml（均为占位值），
+// 工位与 TCP 由韩明赫（Calibration/TF/TCP）提供实测值后替换。
+// 任一几何输入不是 MEASURED 时，输出强制 simulation_only=true。
+
+#ifndef MTC_MOVEIT_PLANNER__PLANNER_CONFIG_HPP_
+#define MTC_MOVEIT_PLANNER__PLANNER_CONFIG_HPP_
+
+#include <cstdint>
+#include <map>
+#include <optional>
+#include <set>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "mtc_core_cpp/pose.hpp"
+#include "mtc_manipulation_cpp/pick_place_types.hpp"
+#include "mtc_moveit_planner/planning_backend.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+/// 标定状态，与 TF_AND_CALIBRATION_HANDOFF 的 MEASURED / ESTIMATED / UNKNOWN 对齐；
+/// PLACEHOLDER 表示规划层为仿真临时填写的值。
+enum class CalibrationStatus
+{
+  MEASURED,
+  ESTIMATED,
+  PLACEHOLDER,
+  UNKNOWN,
+};
+
+const char * to_string(CalibrationStatus status);
+std::optional<CalibrationStatus> calibration_status_from_string(const std::string & text);
+
+/// 原语目标如何求得。
+enum class GoalKind
+{
+  RING_STANDOFF,  ///< 提环位姿沿插入轴后退 distance_m（预对准位）
+  RELATIVE_UP,    ///< 从起点末端位姿沿 planning frame +Z 平移 distance_m
+  SLOT_OFFSET,    ///< 工位位姿上方 distance_m，保持当前工具姿态
+};
+
+/// 原语之前存在、但不由规划器输出的工具动作（ToolPort 负责）。
+/// 规划器只能**假设**其结束位置来计算后续起点，并在报告中写明。
+enum class ToolGapBefore
+{
+  NONE,
+  ENGAGE_INSERT,  ///< 沿插入轴前进 gap_distance_m（hook_engage / auto_lock）
+  WITHDRAW,       ///< 沿插入轴后退 gap_distance_m（side_withdraw / withdraw）
+};
+
+const char * to_string(GoalKind kind);
+const char * to_string(ToolGapBefore gap);
+
+struct PrimitiveSpec
+{
+  MotionMode mode = MotionMode::FREE_SPACE;
+  GoalKind goal = GoalKind::RELATIVE_UP;
+  double distance_m = 0.0;
+  ToolGapBefore gap_before = ToolGapBefore::NONE;
+  double gap_distance_m = 0.0;
+  /// 执行该原语的 PickPlace 状态；用其看门狗限制轨迹时长。
+  mtc::manipulation::PickPlaceState executing_state = mtc::manipulation::PickPlaceState::LIFT;
+  /// 接触类：只作为规划意图 / 仿真验证，不代表可安全执行。
+  bool contact_intent_only = false;
+  /// 规划该原语时末端挂着电池（试提之后、释放之前）。
+  bool carries_payload = false;
+};
+
+/// 电池载荷的规划几何（PLACEHOLDER，待实物尺寸）。
+struct PayloadSpec
+{
+  bool enabled = true;
+  mtc::core::Vector3 size_m{0.06, 0.06, 0.10};
+  /// 载荷中心位于钩尖（TCP）正下方（planning frame -Z）的距离：电池靠重力挂在提环下方。
+  double hang_below_tcp_m = 0.07;
+  std::vector<std::string> touch_links{"ee_link", "wrist3_Link"};
+  CalibrationStatus status = CalibrationStatus::PLACEHOLDER;
+};
+
+struct SlotSpec
+{
+  mtc::core::Pose6D pose;  ///< 工位中心（落座时 TCP 所在高度为 z + 0）
+  CalibrationStatus status = CalibrationStatus::UNKNOWN;
+};
+
+struct PlannerConfig
+{
+  /// FSM 期望的关节顺序（PickPlaceConfig::joint_names）。
+  std::vector<std::string> joint_names = mtc::manipulation::PickPlaceConfig().joint_names;
+
+  double velocity_scaling = 0.1;       ///< config/manipulation.yaml default_velocity_scaling
+  double acceleration_scaling = 0.1;   ///< config/manipulation.yaml default_acceleration_scaling
+  double scaling_cap = 0.2;            ///< 执行层与 PickPlaceConfig 的硬上限
+
+  double planning_time_s = 1.0;        ///< PLAN_ACQUIRE 看门狗仅 2.0 s，单次必须小于它
+  double cartesian_step_m = 0.005;
+  double min_cartesian_fraction = 1.0; ///< 直线段必须完整，不接受部分路径
+
+  double timeout_factor = 1.5;         ///< timeout_ms = duration * factor + margin
+  uint32_t timeout_margin_ms = 1000;
+  double state_timeout_usage = 0.8;    ///< 轨迹时长不得超过对应状态看门狗的 80%
+  std::map<mtc::manipulation::PickPlaceState, double> state_timeouts =
+    mtc::manipulation::default_state_timeouts();
+
+  /// 额外关节位置限位（rad，[min, max]）。MoveIt 只用 URDF 限位；
+  /// aubo.ros2_control.xacro 中 foreArm/wrist1/wrist3 的指令限位更窄，在此复核。
+  std::map<std::string, std::pair<double, double>> joint_position_limits;
+
+  PayloadSpec payload;
+  /// 静态场景障碍物（桌面等），由工具在规划前写入 move_group。
+  std::vector<SceneBox> scene_boxes;
+
+  /// FREE_SPACE 原语先试末端直线（最短、可预测），不可行再用 OMPL。
+  bool prefer_straight_line_free_space = true;
+
+  /// 提环 / TCP 局部坐标中的插入方向轴（TF_CONVENTIONS §2.1 提案：+Z）。
+  int insertion_axis = 2;
+
+  /// ee_link -> hook_tcp。未标定时为单位变换。
+  Transform ee_to_tcp;
+  CalibrationStatus tcp_status = CalibrationStatus::PLACEHOLDER;
+
+  std::map<std::string, SlotSpec> slots;
+  std::map<std::string, PrimitiveSpec> primitives;
+  std::set<std::string> tool_owned_primitives;
+
+  /// 允许使用非 MEASURED 的几何输入（今晚 Mock 必须为 true）。
+  bool allow_uncalibrated_geometry = true;
+  /// 无论标定状态如何都标记 simulation_only（团队批准前保持 true）。
+  bool force_simulation_only = true;
+};
+
+/// 默认配置：原语表 + 工具原语清单 + 占位工位（仅仿真）。
+PlannerConfig default_planner_config();
+
+}  // namespace moveit_planner
+}  // namespace mtc
+
+#endif  // MTC_MOVEIT_PLANNER__PLANNER_CONFIG_HPP_
diff --git a/src/mtc_moveit_planner/include/mtc_moveit_planner/planning_backend.hpp b/src/mtc_moveit_planner/include/mtc_moveit_planner/planning_backend.hpp
new file mode 100644
index 0000000..970480f
--- /dev/null
+++ b/src/mtc_moveit_planner/include/mtc_moveit_planner/planning_backend.hpp
@@ -0,0 +1,134 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 规划后端抽象：把"MoveIt 怎么规划"与"PlannerPort 怎么组装结果"分开。
+//
+// MoveItPlannerPort 只依赖本接口，因此可以用假后端做离线 GTest；
+// 真正的 MoveGroupInterface + tf2 实现在 move_group_backend.hpp（ROS 外壳）。
+
+#ifndef MTC_MOVEIT_PLANNER__PLANNING_BACKEND_HPP_
+#define MTC_MOVEIT_PLANNER__PLANNING_BACKEND_HPP_
+
+#include <map>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "mtc_core_cpp/pose.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+/// 规划组的关节状态快照（名称与位置按索引对应，不假定顺序）。
+struct JointStateSnapshot
+{
+  std::vector<std::string> names;
+  std::vector<double> positions;
+
+  bool shape_is_valid() const {return !names.empty() && names.size() == positions.size();}
+};
+
+/// 随末端一起运动的载荷（电池）碰撞体：长方体，位姿相对规划末端 link（ee_link）固定。
+/// 只附着在**规划起点状态**上参与碰撞检查，不修改 move_group 的全局规划场景。
+struct AttachedPayload
+{
+  std::string id = "battery_payload";
+  mtc::core::Vector3 size_m{0.06, 0.06, 0.10};
+  Transform ee_to_payload;                 ///< ee_link -> 载荷中心
+  std::vector<std::string> touch_links{"ee_link", "wrist3_Link"};
+};
+
+/// 静态场景障碍物（长方体），写入 move_group 规划场景。
+struct SceneBox
+{
+  std::string id;
+  mtc::core::Pose6D pose;                  ///< 中心位姿（frame_id 必须可 TF 到 planning frame）
+  mtc::core::Vector3 size_m;
+};
+
+enum class MotionMode
+{
+  FREE_SPACE,  ///< OMPL 关节空间规划到末端位姿
+  CARTESIAN,   ///< 末端直线（computeCartesianPath）
+};
+
+const char * to_string(MotionMode mode);
+
+struct BackendRequest
+{
+  std::string label;                ///< 原语名或"simulated_*"，仅用于日志
+  MotionMode mode = MotionMode::FREE_SPACE;
+  mtc::core::Pose6D ee_goal;        ///< 规划末端 link（ee_link）的目标位姿，已做 TCP 补偿
+  JointStateSnapshot start;         ///< 显式起点；不使用"隐式当前状态"
+  double velocity_scaling = 0.1;
+  double acceleration_scaling = 0.1;
+  double max_linear_speed_m_s = 0.0;     ///< <=0 表示不限制
+  double max_angular_speed_rad_s = 0.0;  ///< <=0 表示不限制
+  double planning_time_s = 1.0;
+  double cartesian_step_m = 0.005;
+  double min_cartesian_fraction = 1.0;
+  bool avoid_collisions = true;
+  /// 规划时随末端一起运动的载荷；空表示末端无载荷。
+  std::optional<AttachedPayload> payload;
+  /// FREE_SPACE 时先尝试末端直线（完整、无碰撞、满足关节约束才采用），失败再用 OMPL。
+  bool prefer_straight_line = false;
+  /// 额外关节位置约束（rad）：作为 MoveIt 路径约束下发，使解落在控制器限位内。
+  std::map<std::string, std::pair<double, double>> joint_bounds;
+};
+
+struct BackendResult
+{
+  bool ok = false;
+  std::string reason;               ///< 失败分类：NO_PLAN / CARTESIAN_INCOMPLETE / ...
+  std::string message;
+  double planning_time_s = 0.0;
+  double cartesian_fraction = 0.0;  ///< 仅 CARTESIAN 有意义
+  double time_scale_applied = 1.0;  ///< 为满足末端线速度/角速度上限而做的均匀拉伸倍数
+  std::string method;               ///< cartesian_preferred / joint_interpolated_ik / ompl_seeded_ik / ompl / cartesian
+  double max_linear_speed_m_s = 0.0;   ///< 拉伸后实测末端最大线速度
+  double max_angular_speed_rad_s = 0.0;
+  RawTrajectory trajectory;         ///< 已时间参数化（含速度/加速度）
+  JointStateSnapshot end_state;
+};
+
+class PlanningBackend
+{
+public:
+  virtual ~PlanningBackend() = default;
+
+  /// 规划参考坐标系（MoveIt planning frame）。
+  virtual std::string planning_frame() const = 0;
+
+  /// 规划末端 link 名（PlannerPort 的 ee 目标对应此 link）。
+  virtual std::string end_effector_link() const = 0;
+
+  /// 当前机器人状态（来自 /joint_states）；不可得返回 nullopt。
+  virtual std::optional<JointStateSnapshot> current_state() = 0;
+
+  /// 给定关节状态下末端 link 在 planning frame 中的位姿（正运动学）。
+  virtual std::optional<mtc::core::Pose6D> end_effector_pose(const JointStateSnapshot & state) = 0;
+
+  /// 用 TF 把位姿变换到 planning frame；TF 不连通 / 超时返回 nullopt（绝不复制 XYZ 兜底）。
+  virtual std::optional<mtc::core::Pose6D> transform_to_planning_frame(
+    const mtc::core::Pose6D & pose) = 0;
+
+  virtual BackendResult plan(const BackendRequest & request) = 0;
+
+  /// 用静态障碍物替换本后端此前写入的场景对象；返回是否成功（默认实现：不支持）。
+  virtual bool apply_scene(const std::vector<SceneBox> & boxes)
+  {
+    return boxes.empty();
+  }
+};
+
+using PlanningBackendPtr = std::shared_ptr<PlanningBackend>;
+
+}  // namespace moveit_planner
+}  // namespace mtc
+
+#endif  // MTC_MOVEIT_PLANNER__PLANNING_BACKEND_HPP_
diff --git a/src/mtc_moveit_planner/include/mtc_moveit_planner/pose_math.hpp b/src/mtc_moveit_planner/include/mtc_moveit_planner/pose_math.hpp
new file mode 100644
index 0000000..e39867a
--- /dev/null
+++ b/src/mtc_moveit_planner/include/mtc_moveit_planner/pose_math.hpp
@@ -0,0 +1,140 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 最小刚体变换工具（纯 C++，基于 mtc_core_cpp::Pose6D）。
+//
+// 只做规划层需要的三件事：TCP 补偿（ee_link <-> hook_tcp）、沿局部轴偏移
+// （预对准退让 / 插入 / 退出）、沿规划坐标系平移（试提 / 抬升 / 落座高度）。
+// 所有运算保留 frame_id 与 stamp，不做任何坐标系之间的隐式换算；
+// 跨坐标系必须先经后端 TF 转换（见 PlanningBackend::transform_to_planning_frame）。
+
+#ifndef MTC_MOVEIT_PLANNER__POSE_MATH_HPP_
+#define MTC_MOVEIT_PLANNER__POSE_MATH_HPP_
+
+#include <algorithm>
+#include <cmath>
+
+#include "mtc_core_cpp/pose.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+/// 刚体变换 T = (t, q)：先旋转 q，再平移 t。
+struct Transform
+{
+  mtc::core::Vector3 translation;
+  mtc::core::Quaternion rotation;  ///< 默认单位四元数
+};
+
+inline mtc::core::Quaternion normalized(const mtc::core::Quaternion & q)
+{
+  const double n = q.norm();
+  if (!(n > 0.0) || !std::isfinite(n)) {
+    return mtc::core::Quaternion{};
+  }
+  return mtc::core::Quaternion{q.x / n, q.y / n, q.z / n, q.w / n};
+}
+
+/// Hamilton 积 a * b（先 b 后 a）。
+inline mtc::core::Quaternion multiply(
+  const mtc::core::Quaternion & a, const mtc::core::Quaternion & b)
+{
+  return mtc::core::Quaternion{
+    a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y,
+    a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x,
+    a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w,
+    a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z};
+}
+
+inline mtc::core::Quaternion conjugate(const mtc::core::Quaternion & q)
+{
+  return mtc::core::Quaternion{-q.x, -q.y, -q.z, q.w};
+}
+
+inline mtc::core::Vector3 rotate(const mtc::core::Quaternion & q, const mtc::core::Vector3 & v)
+{
+  const mtc::core::Quaternion p{v.x, v.y, v.z, 0.0};
+  const auto r = multiply(multiply(q, p), conjugate(q));
+  return mtc::core::Vector3{r.x, r.y, r.z};
+}
+
+inline Transform to_transform(const mtc::core::Pose6D & pose)
+{
+  return Transform{pose.position, normalized(pose.orientation)};
+}
+
+/// a * b：先在 b 的局部系表达，再变换到 a 的父系。
+inline Transform compose(const Transform & a, const Transform & b)
+{
+  const auto rotated = rotate(a.rotation, b.translation);
+  return Transform{
+    mtc::core::Vector3{
+      a.translation.x + rotated.x, a.translation.y + rotated.y, a.translation.z + rotated.z},
+    normalized(multiply(a.rotation, b.rotation))};
+}
+
+inline Transform inverse(const Transform & a)
+{
+  const auto q_inv = conjugate(normalized(a.rotation));
+  const auto t = rotate(q_inv, a.translation);
+  return Transform{mtc::core::Vector3{-t.x, -t.y, -t.z}, q_inv};
+}
+
+/// pose ∘ local：结果仍在 pose.frame_id 中，保留 stamp / valid。
+inline mtc::core::Pose6D apply(const mtc::core::Pose6D & pose, const Transform & local)
+{
+  const auto composed = compose(to_transform(pose), local);
+  mtc::core::Pose6D out = pose;
+  out.position = composed.translation;
+  out.orientation = composed.rotation;
+  return out;
+}
+
+/// 沿位姿自身的局部轴（0=x, 1=y, 2=z）移动 distance 米。
+inline mtc::core::Pose6D offset_along_local_axis(
+  const mtc::core::Pose6D & pose, int axis, double distance)
+{
+  Transform local;
+  if (axis == 0) {
+    local.translation.x = distance;
+  } else if (axis == 1) {
+    local.translation.y = distance;
+  } else {
+    local.translation.z = distance;
+  }
+  return apply(pose, local);
+}
+
+/// 沿父坐标系（即 pose.frame_id）平移，不改变姿态。
+inline mtc::core::Pose6D translate_in_frame(
+  const mtc::core::Pose6D & pose, const mtc::core::Vector3 & delta)
+{
+  mtc::core::Pose6D out = pose;
+  out.position.x += delta.x;
+  out.position.y += delta.y;
+  out.position.z += delta.z;
+  return out;
+}
+
+/// 两姿态之间的最小旋转角（弧度，范围 [0, π]）。
+inline double angle_between(const mtc::core::Quaternion & a, const mtc::core::Quaternion & b)
+{
+  const auto qa = normalized(a);
+  const auto qb = normalized(b);
+  const double dot = std::fabs(qa.x * qb.x + qa.y * qb.y + qa.z * qb.z + qa.w * qb.w);
+  return 2.0 * std::acos(std::min(1.0, dot));
+}
+
+inline double distance_between(const mtc::core::Vector3 & a, const mtc::core::Vector3 & b)
+{
+  const double dx = a.x - b.x;
+  const double dy = a.y - b.y;
+  const double dz = a.z - b.z;
+  return std::sqrt(dx * dx + dy * dy + dz * dz);
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
+
+#endif  // MTC_MOVEIT_PLANNER__POSE_MATH_HPP_
