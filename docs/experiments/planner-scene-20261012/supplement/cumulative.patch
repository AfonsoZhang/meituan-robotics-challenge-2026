+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/start_consistency.hpp"
+
+#include <cmath>
+#include <iomanip>
+#include <sstream>
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+StartCheck check_trajectory_start(
+  const mtc::core::TimedTrajectory & trajectory,
+  const std::vector<std::string> & actual_names,
+  const std::vector<double> & actual_positions,
+  double tolerance_rad)
+{
+  StartCheck check;
+  if (trajectory.points.empty() ||
+    trajectory.points.front().positions_rad.size() != trajectory.joint_names.size())
+  {
+    check.message = "trajectory has no valid first point";
+    return check;
+  }
+  if (actual_names.size() != actual_positions.size() || !std::isfinite(tolerance_rad) ||
+    tolerance_rad < 0.0)
+  {
+    check.message = "invalid actual state or tolerance";
+    return check;
+  }
+  const auto & first = trajectory.points.front().positions_rad;
+  for (size_t i = 0; i < trajectory.joint_names.size(); ++i) {
+    size_t index = actual_names.size();
+    for (size_t j = 0; j < actual_names.size(); ++j) {
+      if (actual_names[j] == trajectory.joint_names[i]) {
+        index = j;
+        break;
+      }
+    }
+    if (index == actual_names.size()) {
+      check.message = "actual state is missing joint " + trajectory.joint_names[i];
+      check.worst_joint = trajectory.joint_names[i];
+      return check;
+    }
+    const double deviation = std::fabs(first[i] - actual_positions[index]);
+    if (!std::isfinite(deviation)) {
+      check.message = "non-finite value for joint " + trajectory.joint_names[i];
+      check.worst_joint = trajectory.joint_names[i];
+      return check;
+    }
+    if (deviation > check.max_deviation_rad || check.worst_joint.empty()) {
+      check.max_deviation_rad = deviation;
+      check.worst_joint = trajectory.joint_names[i];
+    }
+  }
+  check.ok = check.max_deviation_rad <= tolerance_rad;
+  std::ostringstream os;
+  os << std::setprecision(6) << "max start deviation " << check.max_deviation_rad << " rad at " <<
+    check.worst_joint << (check.ok ? " <= " : " > ") << tolerance_rad << " rad";
+  check.message = os.str();
+  return check;
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/src/trajectory_conversion.cpp b/src/mtc_moveit_planner/src/trajectory_conversion.cpp
new file mode 100644
index 0000000..4487fdb
--- /dev/null
+++ b/src/mtc_moveit_planner/src/trajectory_conversion.cpp
@@ -0,0 +1,136 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+#include <cmath>
+#include <map>
+#include <set>
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+namespace
+{
+
+bool reorder(
+  const std::vector<double> & source, const std::vector<size_t> & index,
+  std::vector<double> & out)
+{
+  if (source.empty()) {
+    out.clear();
+    return true;
+  }
+  if (source.size() != index.size()) {
+    return false;
+  }
+  out.assign(index.size(), 0.0);
+  for (size_t i = 0; i < index.size(); ++i) {
+    out[i] = source[index[i]];
+  }
+  return true;
+}
+
+}  // namespace
+
+ConversionResult to_timed_trajectory(
+  const RawTrajectory & raw,
+  const std::vector<std::string> & expected_joint_order,
+  const std::string & frame_id,
+  double stamp_s)
+{
+  ConversionResult result;
+  if (frame_id.empty()) {
+    result.error = "frame_id is empty";
+    return result;
+  }
+  if (expected_joint_order.empty()) {
+    result.error = "expected joint order is empty";
+    return result;
+  }
+  if (raw.points.empty()) {
+    result.error = "trajectory has no points";
+    return result;
+  }
+
+  std::map<std::string, size_t> source_index;
+  for (size_t i = 0; i < raw.joint_names.size(); ++i) {
+    if (!source_index.emplace(raw.joint_names[i], i).second) {
+      result.error = "duplicate joint in planner output: " + raw.joint_names[i];
+      return result;
+    }
+  }
+  if (raw.joint_names.size() != expected_joint_order.size()) {
+    result.error = "planner output has " + std::to_string(raw.joint_names.size()) +
+      " joints, expected " + std::to_string(expected_joint_order.size());
+    return result;
+  }
+  std::vector<size_t> index;
+  index.reserve(expected_joint_order.size());
+  for (const auto & name : expected_joint_order) {
+    const auto found = source_index.find(name);
+    if (found == source_index.end()) {
+      result.error = "planner output is missing joint: " + name;
+      return result;
+    }
+    index.push_back(found->second);
+  }
+
+  mtc::core::TimedTrajectory trajectory;
+  trajectory.joint_names = expected_joint_order;
+  trajectory.header_frame_id = frame_id;
+  trajectory.stamp_s = stamp_s;
+  trajectory.points.reserve(raw.points.size());
+  for (size_t p = 0; p < raw.points.size(); ++p) {
+    const auto & source = raw.points[p];
+    mtc::core::TrajectoryPoint point;
+    point.time_from_start_s = source.time_from_start_s;
+    if (!reorder(source.positions, index, point.positions_rad) ||
+      point.positions_rad.size() != index.size() ||
+      !reorder(source.velocities, index, point.velocities_rad_s) ||
+      !reorder(source.accelerations, index, point.accelerations_rad_s2))
+    {
+      result.error = "point " + std::to_string(p) + " has inconsistent dimensions";
+      return result;
+    }
+    trajectory.points.push_back(std::move(point));
+  }
+
+  if (!trajectory.shape_is_valid()) {
+    result.error = "converted trajectory failed shape check "
+      "(non-finite value, negative stamp or non-increasing time_from_start)";
+    return result;
+  }
+  result.ok = true;
+  result.trajectory = std::move(trajectory);
+  return result;
+}
+
+bool stretch_time(mtc::core::TimedTrajectory & trajectory, double factor)
+{
+  if (!std::isfinite(factor) || factor < 1.0) {
+    return false;
+  }
+  for (auto & point : trajectory.points) {
+    point.time_from_start_s *= factor;
+    for (auto & v : point.velocities_rad_s) {
+      v /= factor;
+    }
+    for (auto & a : point.accelerations_rad_s2) {
+      a /= factor * factor;
+    }
+  }
+  return true;
+}
+
+std::vector<double> final_positions(const mtc::core::TimedTrajectory & trajectory)
+{
+  if (trajectory.points.empty()) {
+    return {};
+  }
+  return trajectory.points.back().positions_rad;
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/test/fake_backend.hpp b/src/mtc_moveit_planner/test/fake_backend.hpp
new file mode 100644
index 0000000..eeaf1ca
--- /dev/null
+++ b/src/mtc_moveit_planner/test/fake_backend.hpp
@@ -0,0 +1,175 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 离线假规划后端：用"笛卡尔坐标即关节值"的玩具运动学验证 MoveItPlannerPort 的组装逻辑。
+//   shoulder_joint = x, upperArm_joint = y, foreArm_joint = z, 三个腕关节恒为 0；
+//   末端姿态恒为单位四元数。
+// 关节顺序刻意与 FSM 不同（upperArm/foreArm 交换），用来验证按名称重排。
+// 仅用于测试，不代表 AUBO S3 运动学，输出不能送往任何执行后端。
+
+#ifndef MTC_MOVEIT_PLANNER__TEST__FAKE_BACKEND_HPP_
+#define MTC_MOVEIT_PLANNER__TEST__FAKE_BACKEND_HPP_
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <optional>
+#include <set>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "mtc_moveit_planner/planning_backend.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+namespace testing
+{
+
+class FakeBackend : public PlanningBackend
+{
+public:
+  std::vector<std::string> names = {
+    "shoulder_joint", "foreArm_joint", "upperArm_joint",
+    "wrist1_joint", "wrist2_joint", "wrist3_joint"};
+  mtc::core::Vector3 start_xyz{0.30, 0.0, 0.40};
+  bool has_current_state = true;
+
+  std::set<std::string> fail_labels;   ///< 这些 label 的请求返回 NO_PLAN
+  bool start_elsewhere = false;        ///< 轨迹首点偏离请求起点
+  bool drop_last_joint = false;        ///< 输出缺一个关节
+  int delay_ms = 0;
+
+  std::atomic<int> plan_calls{0};
+  std::vector<BackendRequest> requests;
+
+  std::string planning_frame() const override {return "world";}
+  std::string end_effector_link() const override {return "ee_link";}
+
+  std::optional<JointStateSnapshot> current_state() override
+  {
+    if (!has_current_state) {
+      return std::nullopt;
+    }
+    return state_at(start_xyz);
+  }
+
+  std::optional<mtc::core::Pose6D> end_effector_pose(const JointStateSnapshot & state) override
+  {
+    const auto xyz = xyz_of(state);
+    if (!xyz) {
+      return std::nullopt;
+    }
+    mtc::core::Pose6D pose;
+    pose.position = *xyz;
+    pose.frame_id = "world";
+    pose.valid = true;
+    return pose;
+  }
+
+  std::optional<mtc::core::Pose6D> transform_to_planning_frame(
+    const mtc::core::Pose6D & pose) override
+  {
+    if (pose.frame_id != "world" && pose.frame_id != "base_link") {
+      return std::nullopt;
+    }
+    auto out = pose;
+    out.frame_id = "world";
+    return out;
+  }
+
+  BackendResult plan(const BackendRequest & request) override
+  {
+    ++plan_calls;
+    requests.push_back(request);
+    if (delay_ms > 0) {
+      std::this_thread::sleep_for(std::chrono::milliseconds(delay_ms));
+    }
+    BackendResult result;
+    if (fail_labels.count(request.label) != 0u) {
+      result.reason = "NO_PLAN";
+      result.message = "fake planner failure";
+      return result;
+    }
+    const auto from = xyz_of(request.start);
+    if (!from) {
+      result.reason = "INVALID_START";
+      return result;
+    }
+    auto start = *from;
+    if (start_elsewhere) {
+      start.x += 0.05;
+    }
+    const auto goal = request.ee_goal.position;
+    const double distance = distance_between(start, goal);
+    const double speed = request.max_linear_speed_m_s > 0.0 ? request.max_linear_speed_m_s : 0.1;
+    const double duration = std::max(0.1, distance / speed);
+    constexpr int kSegments = 4;
+
+    result.trajectory.joint_names = names;
+    for (int i = 0; i <= kSegments; ++i) {
+      const double s = static_cast<double>(i) / kSegments;
+      const mtc::core::Vector3 p{
+        start.x + (goal.x - start.x) * s,
+        start.y + (goal.y - start.y) * s,
+        start.z + (goal.z - start.z) * s};
+      RawTrajectoryPoint point;
+      point.time_from_start_s = duration * s;
+      point.positions = state_at(p).positions;
+      point.velocities.assign(names.size(), 0.0);
+      result.trajectory.points.push_back(point);
+    }
+    if (drop_last_joint) {
+      result.trajectory.joint_names.pop_back();
+      for (auto & point : result.trajectory.points) {
+        point.positions.pop_back();
+        point.velocities.pop_back();
+      }
+    }
+    result.ok = true;
+    result.planning_time_s = 0.01;
+    result.cartesian_fraction = request.mode == MotionMode::CARTESIAN ? 1.0 : 0.0;
+    result.end_state = state_at(goal);
+    return result;
+  }
+
+  JointStateSnapshot state_at(const mtc::core::Vector3 & xyz) const
+  {
+    JointStateSnapshot state;
+    state.names = names;
+    state.positions.assign(names.size(), 0.0);
+    for (size_t i = 0; i < names.size(); ++i) {
+      if (names[i] == "shoulder_joint") {state.positions[i] = xyz.x;}
+      if (names[i] == "upperArm_joint") {state.positions[i] = xyz.y;}
+      if (names[i] == "foreArm_joint") {state.positions[i] = xyz.z;}
+    }
+    return state;
+  }
+
+  static std::optional<mtc::core::Vector3> xyz_of(const JointStateSnapshot & state)
+  {
+    if (!state.shape_is_valid()) {
+      return std::nullopt;
+    }
+    mtc::core::Vector3 xyz;
+    int found = 0;
+    for (size_t i = 0; i < state.names.size(); ++i) {
+      if (state.names[i] == "shoulder_joint") {xyz.x = state.positions[i]; ++found;}
+      if (state.names[i] == "upperArm_joint") {xyz.y = state.positions[i]; ++found;}
+      if (state.names[i] == "foreArm_joint") {xyz.z = state.positions[i]; ++found;}
+    }
+    if (found != 3) {
+      return std::nullopt;
+    }
+    return xyz;
+  }
+};
+
+}  // namespace testing
+}  // namespace moveit_planner
+}  // namespace mtc
+
+#endif  // MTC_MOVEIT_PLANNER__TEST__FAKE_BACKEND_HPP_
diff --git a/src/mtc_moveit_planner/test/test_fsm_accepts_planner_output.cpp b/src/mtc_moveit_planner/test/test_fsm_accepts_planner_output.cpp
new file mode 100644
index 0000000..cdd0dfd
--- /dev/null
+++ b/src/mtc_moveit_planner/test/test_fsm_accepts_planner_output.cpp
@@ -0,0 +1,171 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 用已合入 main 的真实 PickPlaceFsm 驱动 MoveItPlannerPort（假规划后端）：
+//   * 规划输出必须通过 PickPlaceFsm::accept_plan()；
+//   * 每个运动原语以**一条完整轨迹**经 MotionPort::execute_trajectory() 派发，
+//     execute_joint_move() 调用次数为 0（禁止拆点）；
+//   * V1 / V2 的单块电池流程到达 SUCCESS。
+// 感知、工具、运动均为 mtc_manipulation_cpp/test/fakes.hpp 中的纯逻辑 Fake。
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <chrono>
+#include <memory>
+#include <optional>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include "fake_backend.hpp"
+#include "fakes.hpp"
+#include "mtc_core_cpp/clock.hpp"
+#include "mtc_manipulation_cpp/pick_place_fsm.hpp"
