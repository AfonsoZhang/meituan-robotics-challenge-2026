+class PickPlaceServer : public rclcpp::Node
+{
+public:
+  explicit PickPlaceServer(MockOptions options = {},
+    const rclcpp::NodeOptions & node = rclcpp::NodeOptions());
+  ~PickPlaceServer() override;
