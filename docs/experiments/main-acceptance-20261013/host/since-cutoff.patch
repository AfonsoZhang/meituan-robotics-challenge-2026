index 0000000..f789eac
--- /dev/null
+++ b/scripts/calibration/contract.py
@@ -0,0 +1,151 @@
+"""Offline TF snapshot checks. Never authorizes movement or fabricates missing TF."""
+from collections import deque
+from dataclasses import dataclass
+
+from geometry import CalibrationError, Transform
+
+# rclcpp::Time and the C++ core hold nanoseconds in int64; larger stamps cannot be exchanged.
+INT64_MAX_NS = 2**63 - 1
+
+
+def frame_name(value):
+    if not isinstance(value, str) or not value or value.strip() != value or value.startswith('/') or any(c.isspace() for c in value):
+        raise CalibrationError('INVALID_FRAME', 'frame must be nonempty, relative and contain no whitespace')
+    return value
+
+
+def positive_ns(value, label):
+    if isinstance(value, bool) or not isinstance(value, int) or value <= 0:
+        raise CalibrationError('INVALID_TIME', f'{label} must be positive integer ns; zero is not an observation timestamp')
+    if value > INT64_MAX_NS:
+        raise CalibrationError('INVALID_TIME', f'{label} exceeds int64 nanoseconds used by ROS 2 time')
+    return value
+
+
+@dataclass(frozen=True)
+class Pose:
+    frame_id: str
+    stamp_ns: int
+    time_domain: str
+    transform: Transform
+
+    @classmethod
+    def from_dict(cls, d):
+        if not isinstance(d, dict):
+            raise CalibrationError('INVALID_POSE', 'pose must be an object')
+        required = {'frame_id', 'stamp_ns', 'time_domain', 'length_unit', 'position',
+                    'orientation_xyzw', 'valid', 'ring_pose_valid'}
+        if not required.issubset(d):
+            raise CalibrationError('INVALID_POSE', 'missing fields: ' + ','.join(sorted(required - d.keys())))
+        if d['valid'] is not True or d['ring_pose_valid'] is not True:
+            raise CalibrationError('INVALID_POSE', 'valid and ring_pose_valid must be boolean true')
+        if d['length_unit'] != 'm':
+            raise CalibrationError('UNIT_MISMATCH', 'position must be explicitly supplied in m')
+        if d['time_domain'] not in ('ros', 'sim', 'synthetic'):
+            raise CalibrationError('CLOCK_MISMATCH', 'unsupported observation time domain')
+        return cls(frame_name(d['frame_id']), positive_ns(d['stamp_ns'], 'pose stamp'),
+                   d['time_domain'], Transform(d['position'], d['orientation_xyzw']))
+
+
+class FrameGraph:
+    """A TF forest with exactly one parent per child. Dynamic inputs are snapshots."""
+    def __init__(self, d):
+        # type() rather than ==: True == 1 and 1.0 == 1 in Python, neither is schema 1.
+        if not isinstance(d, dict) or type(d.get('schema_version')) is not int or d['schema_version'] != 1:
+            raise CalibrationError('INVALID_CONFIG', 'expected schema_version 1')
+        if d.get('length_unit') != 'm' or d.get('quaternion_order') != 'xyzw':
+            raise CalibrationError('UNIT_MISMATCH', 'require m and quaternion order xyzw')
+        self.data_kind = d.get('data_kind')
+        self.time_domain = d.get('time_domain')
+        if (self.data_kind not in ('REAL', 'SYNTHETIC') or
+                self.time_domain not in ('ros', 'sim', 'synthetic') or
+                (self.data_kind == 'REAL' and self.time_domain == 'synthetic')):
+            raise CalibrationError('INVALID_CONFIG', 'invalid data_kind/time_domain combination')
+        edges = d.get('transforms')
+        if not isinstance(edges, list):
+            raise CalibrationError('INVALID_CONFIG', 'transforms must be a list')
+        self.edges = []
+        self.parents = {}
+        self.neighbors = {}
+        for original in edges:
+            if not isinstance(original, dict):
+                raise CalibrationError('INVALID_CONFIG', 'transform entry must be an object')
+            edge = dict(original)
+            parent, child = frame_name(edge.get('parent')), frame_name(edge.get('child'))
+            if parent == child or child in self.parents:
+                raise CalibrationError('INVALID_TF_TREE', 'duplicate, self edge or multiple parents')
+            if edge.get('status') not in ('MEASURED', 'ESTIMATED', 'UNKNOWN') or type(edge.get('static')) is not bool:
+                raise CalibrationError('INVALID_CONFIG', 'each edge needs a valid status and boolean static')
+            if edge['status'] == 'UNKNOWN':
+                if edge.get('translation') is not None or edge.get('rotation_xyzw') is not None:
+                    raise CalibrationError('UNKNOWN_HAS_NUMBERS', 'UNKNOWN transform must contain null geometry')
+                edge['transform'] = None
+            else:
+                if edge['status'] == 'MEASURED' and (not isinstance(edge.get('evidence'), str) or not edge['evidence'].strip()):
+                    raise CalibrationError('MISSING_EVIDENCE', 'MEASURED edge needs an evidence reference')
+                edge['transform'] = Transform(edge.get('translation'), edge.get('rotation_xyzw'))
+                if not edge['static']:
+                    positive_ns(edge.get('stamp_ns'), 'dynamic snapshot stamp')
+            self.parents[child] = parent
+            index = len(self.edges)
+            self.edges.append(edge)
+            self.neighbors.setdefault(child, []).append((parent, index, False))
+            self.neighbors.setdefault(parent, []).append((child, index, True))
+        for child in self.parents:
+            visited = set()
+            current = child
+            while current in self.parents:
+                if current in visited:
+                    raise CalibrationError('INVALID_TF_TREE', 'cycle in TF tree')
+                visited.add(current)
+                current = self.parents[current]
+
+    def lookup(self, target, source, stamp_ns):
+        target, source = frame_name(target), frame_name(source)
+        if target not in self.neighbors or source not in self.neighbors:
+            raise CalibrationError('MISSING_TF', f'{source} -> {target}: unknown frame')
+        queue = deque([(source, [])])
+        visited = {source}
+        route = None
+        while queue:
+            current, path = queue.popleft()
+            if current == target:
+                route = path
+                break
+            for neighbor, index, invert in self.neighbors[current]:
+                if neighbor not in visited:
+                    visited.add(neighbor)
+                    queue.append((neighbor, path + [(index, invert)]))
+        if route is None:
+            raise CalibrationError('MISSING_TF', f'{source} -> {target}: disconnected tree')
+        result = Transform.identity()
+        for index, invert in route:
+            edge = self.edges[index]
+            if edge['status'] == 'UNKNOWN':
+                raise CalibrationError('UNKNOWN_CALIBRATION', f"{edge['parent']} <- {edge['child']} is UNKNOWN")
+            if self.data_kind == 'REAL' and edge['status'] != 'MEASURED':
+                raise CalibrationError('UNMEASURED_CALIBRATION', 'REAL diagnostic requires measured edges with evidence')
+            if not edge['static'] and edge['stamp_ns'] != stamp_ns:
+                raise CalibrationError('TF_TIME_MISMATCH', 'dynamic snapshot not at observation time; no offline interpolation')
+            t = edge['transform'].inverse() if invert else edge['transform']
+            result = t.compose(result)
+        return result
+
+
+def transform_pose(graph, pose, target_frame, *, now_ns, max_age_ns, time_domain):
+    positive_ns(now_ns, 'now')
+    positive_ns(max_age_ns, 'max age')
+    if time_domain != pose.time_domain or time_domain != graph.time_domain:
+        raise CalibrationError('CLOCK_MISMATCH', 'pose, TF and now must use the same time domain')
+    age = now_ns - pose.stamp_ns
+    if age < 0:
+        raise CalibrationError('FUTURE_POSE', 'observation is newer than now')
+    if age > max_age_ns:
+        raise CalibrationError('STALE_POSE', 'observation exceeds explicitly selected age threshold')
+    t = graph.lookup(target_frame, pose.frame_id, pose.stamp_ns).compose(pose.transform)
+    return {'status': 'DIAGNOSTIC_OK', 'frame_id': target_frame, 'stamp_ns': pose.stamp_ns,
+            'time_domain': time_domain, 'length_unit': 'm', 'position': list(t.translation),
+            'orientation_xyzw': list(t.rotation), 'age_ns': age,
+            'valid': True, 'ring_pose_valid': True,
+            'simulation_only': graph.data_kind == 'SYNTHETIC', 'motion_authorized': False,
+            'calibration_status': 'SYNTHETIC_ONLY' if graph.data_kind == 'SYNTHETIC' else 'MEASURED_DECLARED'}
diff --git a/scripts/calibration/derive_nominal_mount.py b/scripts/calibration/derive_nominal_mount.py
new file mode 100644
index 0000000..cf7fca5
--- /dev/null
+++ b/scripts/calibration/derive_nominal_mount.py
@@ -0,0 +1,117 @@
+#!/usr/bin/env python3
+"""D435-family layout estimate in physical design frame F; does not publish TF.
+
+Datums, RealSense D400 datasheet 337029-017 (2024-10), printed page numbers:
+- p94 Table 4-16: depth start point (depth = 0 plane) behind the front cover glass.
+- p146 Figure 10-9: "(17.5) FROM CENTERLINE OF 1/4-20 TO LEFT IMAGER", a reference dimension.
+  The drawing does not dimension the 1/4-20 axis, the rear M3 holes or the lens centreline
+  against the 90 x 25 mm housing, so placing them relative to the housing centre H is an
+  assumption that the output reports explicitly.
+"""
+import argparse
+import json
+import math
+from pathlib import Path
+
+from geometry import CalibrationError, Transform, finite_vector
+
+ZERO_DEPTH_BEHIND_GLASS_M = {'D435': 0.0042, 'D435i': 0.0042, 'D435f': 0.0047, 'D435if': 0.0047}
+LEFT_IMAGER_FROM_SCREW_AXIS_M = 0.0175   # towards optical -X, viewed from behind the camera
+# camera_link <- depth optical: realsense2_description depth_optical_joint rpy(-pi/2, 0, -pi/2).
+CAMERA_LINK_TO_DEPTH_OPTICAL_XYZW = (-0.5, 0.5, -0.5, 0.5)
+MAX_GLASS_OFFSET_M = 1.0         # a flange bracket longer than this is most likely mm typed as m
+MAX_HOUSING_CORRECTION_M = 0.02  # datum corrections must stay inside the 90 x 25 mm housing
+
+
+def as_dict(t):
+    return {'translation': list(t.translation), 'rotation_xyzw': list(t.rotation)}
+
+
+def rejection(code, message):
+    return {'status': 'REJECTED', 'code': code, 'message': message, 'motion_authorized': False}
+
+
+def housing_correction(document, key, assumed_basis):
+    """Optional measured offset of a datum from H along H axes; absent means assumed zero."""
+    if key not in document:
+        return 0.0, {'item': key, 'value': 0.0, 'status': 'ASSUMED', 'basis': assumed_basis}
+    value = finite_vector([document[key]], 1, key)[0]
+    if abs(value) > MAX_HOUSING_CORRECTION_M:
+        raise CalibrationError('IMPLAUSIBLE_DESIGN', f'{key} must be within +-{MAX_HOUSING_CORRECTION_M} m')
+    return value, {'item': key, 'value': value, 'status': 'PROVIDED',
+                   'basis': 'caller-supplied correction; keep its measurement record'}
+
+
+def derive(document):
+    if not isinstance(document, dict) or document.get('data_kind') != 'MOUNT_DESIGN':
+        raise CalibrationError('INVALID_DESIGN', 'require MOUNT_DESIGN; no measured calibration is inferred')
+    if document.get('length_unit') != 'm':
+        raise CalibrationError('UNIT_MISMATCH', 'design positions must be m')
+    model = document.get('camera_model')
+    if not isinstance(model, str) or model not in ZERO_DEPTH_BEHIND_GLASS_M:
+        raise CalibrationError('INVALID_DESIGN', 'camera_model must be one of ' + ', '.join(ZERO_DEPTH_BEHIND_GLASS_M))
+    # H: housing centre on the front cover glass, axes parallel to the optical axes
+    # (X right, Y down, Z forward, viewed from behind the camera).
+    t_f_h = Transform(document.get('front_glass_center_in_F'), document.get('optical_axes_in_F_xyzw'))
+    if math.sqrt(sum(v * v for v in t_f_h.translation)) > MAX_GLASS_OFFSET_M:
+        raise CalibrationError('IMPLAUSIBLE_DESIGN',
+                               f'front glass more than {MAX_GLASS_OFFSET_M} m from the flange; mm entered as m?')
+    screw_x, screw_note = housing_correction(
+        document, 'screw_axis_x_in_H_m',
+        '1/4-20 centreline assumed on the housing width centre; not dimensioned in Fig.10-9 '
+        '(the official ROS description makes the same approximation)')
+    imager_y, imager_note = housing_correction(
+        document, 'imager_axis_y_in_H_m',
+        'lens centreline (-C-) assumed at the housing height centre; not dimensioned in Fig.10-9')
+    zero_depth = ZERO_DEPTH_BEHIND_GLASS_M[model]
+    t_h_d = Transform([screw_x - LEFT_IMAGER_FROM_SCREW_AXIS_M, imager_y, -zero_depth], [0, 0, 0, 1])
+    t_f_d = t_f_h.compose(t_h_d)
+    t_l_d = Transform([0, 0, 0], CAMERA_LINK_TO_DEPTH_OPTICAL_XYZW)
+    return {'status': 'ESTIMATED', 'data_kind': 'MOUNT_DESIGN', 'camera_model': model,
+            'reference_frame': 'flange_design_F', 'length_unit': 'm',
+            'quaternion_order': 'xyzw', 'T_F_front_glass_center': as_dict(t_f_h),
+            'T_H_depth_optical_nominal': as_dict(t_h_d),
+            'T_F_depth_optical': as_dict(t_f_d),
+            'T_F_camera_link_nominal': as_dict(t_f_d.compose(t_l_d.inverse())),
+            'assumptions': [
+                screw_note, imager_note,
+                {'item': 'R_H_depth_optical', 'value': 'identity', 'status': 'ASSUMED',
+                 'basis': 'housing axes parallel to the calibrated optical axes; no datasheet angular tolerance'},
+                {'item': 'left_imager_from_screw_axis_m', 'value': LEFT_IMAGER_FROM_SCREW_AXIS_M,
+                 'status': 'DATASHEET_REFERENCE',
+                 'basis': 'p146 Fig.10-9 reference dimension, from the 1/4-20 centreline towards optical -X'},
+                {'item': 'zero_depth_behind_glass_m', 'value': zero_depth, 'status': 'DATASHEET',
+                 'basis': f'p94 Table 4-16 for {model}; H lies on the front cover glass, '
+                          'about 0.1 mm behind the front aluminium plate'},
+                {'item': 'camera_link_origin', 'value': 'depth optical origin', 'status': 'WRAPPER_CONVENTION',
+                 'basis': 'realsense-ros README: camera_link = left IR = depth origin; verify installed wrapper TF'}],
+            'deployment_ready': False, 'motion_authorized': False,
+            'pending': ['verify flange_design_F relative to deployed robot frame',
+                        'check V1 tool and bracket geometry, holes, occlusion and cable space',
+                        'measure rear M3 holes against the 1/4-20 axis or left imager if the bracket uses them',
+                        'confirm the camera model label (f variants have a different zero-depth offset)',
+                        'read actual depth/color/internal TF from this D435i',
+                        'verify installation and calibration errors against task tolerance']}
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
+    parser.add_argument('design', type=Path)
+    args = parser.parse_args()
+    try:
+        result = derive(json.loads(args.design.read_text(encoding='utf-8-sig')))
+    except (CalibrationError, OSError, ValueError, TypeError) as error:
+        print(json.dumps(rejection(getattr(error, 'code', 'INVALID_INPUT'), str(error)), ensure_ascii=True))
+        return 2
+    except RecursionError:
+        print(json.dumps(rejection('INVALID_INPUT', 'JSON nesting exceeds the parser recursion limit'), ensure_ascii=True))
+        return 2
+    except Exception as error:  # an unexpected failure must still be a rejection, never exit 0/1
+        print(json.dumps(rejection('INTERNAL_ERROR', f'{type(error).__name__}: {error}'), ensure_ascii=True))
+        return 2
+    print(json.dumps(result, indent=2, ensure_ascii=True, allow_nan=False))
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
