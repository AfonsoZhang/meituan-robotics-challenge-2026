+    native_status=create_subscription<action_msgs::msg::GoalStatusArray>(cfg.action_name()+"/_action/status",
+      rclcpp::QoS(1).reliable().transient_local(),[this](action_msgs::msg::GoalStatusArray::ConstSharedPtr msg) {
