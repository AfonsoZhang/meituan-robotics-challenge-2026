index 0000000..1c20b38
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp
@@ -0,0 +1,199 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// 单块电池基础任务的运动阶段规划（Mock，仅规划不执行）。
+//
+// 用已合入的 ToolStrategy 生成与 PickPlaceFsm **完全相同**的两次规划请求：
+//   ACQUIRE   = make_acquire_plan + make_test_lift_plan            （PLAN_ACQUIRE 状态）
+//   TRANSPORT = lift + transport + pre_seat + seat_contact + retreat（LIFT 状态）
+// 第二次以第一次 test_lift 轨迹终点为起点（模拟 FSM 中试提已执行完）。
+// 提环位姿与工位均为占位值（见 config/planner.yaml），输出 simulation_only=true。
+
+#include <iomanip>
+#include <memory>
+#include <optional>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rclcpp/rclcpp.hpp>
+
+#include "mtc_core_cpp/clock.hpp"
+#include "mtc_manipulation_cpp/tool_strategy.hpp"
+#include "mtc_moveit_planner/move_group_backend.hpp"
+#include "mtc_moveit_planner/moveit_planner_port.hpp"
+#include "mtc_moveit_planner/plan_report_io.hpp"
+#include "mtc_moveit_planner/ros_params.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace
+{
+
+using mtc::manipulation::PlanTarget;
+using mtc::moveit_planner::JointStateSnapshot;
+using mtc::moveit_planner::MoveGroupBackend;
+using mtc::moveit_planner::MoveItPlannerPort;
+
+PlanTarget make_target(
+  const std::string & phase, const mtc::core::PoseEstimate & ring, const std::string & slot,
+  const mtc::core::MotionPrimitiveList & primitives)
+{
+  PlanTarget target;
+  target.phase = phase;
+  target.object_id = ring.object_id;
+  target.slot = slot;
+  target.has_ring_pose = ring.has_ring_pose();
+  target.ring_pose = ring.ring_pose;
+  target.primitives = primitives;
+  for (const auto & p : primitives) {
+    target.primitive_names.push_back(p.name);
+  }
+  return target;
+}
+
+void log_report(const rclcpp::Logger & logger, const mtc::core::PlanResult & result,
+  const mtc::moveit_planner::PlanReport & report)
+{
+  RCLCPP_INFO(logger, "[%s] ok=%s code=%u %s", report.phase.c_str(), result.ok ? "true" : "false",
+    result.error_code, result.message.c_str());
+  for (const auto & p : report.primitives) {
+    RCLCPP_INFO(logger,
+      "  %-13s %-10s %-19s ok=%-5s plan=%.3fs dur=%.2fs pts=%zu scale=%.2f v=%.3fm/s w=%.3frad/s "
+      "watchdog=%.0fs %s%s",
+      p.primitive_name.c_str(), p.mode.c_str(), p.method.c_str(), p.ok ? "true" : "false",
+      p.planning_time_s,
+      p.duration_s, p.point_count, p.time_scale_applied, p.max_linear_speed_m_s,
+      p.max_angular_speed_rad_s, p.state_watchdog_s,
+      p.contact_intent_only ? "[contact intent only] " : "",
+      p.ok ? p.start_assumption.c_str() : (p.reason + ": " + p.message).c_str());
+    if (!p.message.empty() && p.message != "ok") {
+      RCLCPP_INFO(logger, "      backend: %s", p.message.c_str());
+    }
+  }
+}
+
+int run(const std::shared_ptr<rclcpp::Node> & node)
+{
+  const auto logger = node->get_logger();
+  const auto config = mtc::moveit_planner::load_planner_config(*node);
+  const auto options = mtc::moveit_planner::load_backend_options(*node);
+  const std::string output_dir = node->get_parameter_or<std::string>("output_dir", "planning_evidence");
+  const std::string tool = node->get_parameter_or<std::string>(
+    "sequence.tool_type", mtc::manipulation::TOOL_PASSIVE_HOOK_V1);
+  const std::string slot = node->get_parameter_or<std::string>("sequence.slot", "T0");
+  // 规划起点：SRDF 命名状态（默认 "home"）；为空则用 /joint_states 当前状态。只规划，不移动机器人。
+  const std::string start_named_state =
+    node->get_parameter_or<std::string>("sequence.start_named_state", "home");
+
+  mtc::core::PoseEstimate ring;
+  ring.object_id = node->get_parameter_or<std::string>("sequence.object_id", "battery_1");
+  ring.color = static_cast<int>(node->get_parameter_or<int64_t>("sequence.color", 1));
+  const auto xyz = node->get_parameter_or<std::vector<double>>(
+    "sequence.ring.xyz", {0.40, -0.05, 0.20});
+  const auto q = node->get_parameter_or<std::vector<double>>(
+    "sequence.ring.quat_xyzw", {0.0, 0.70710678, 0.0, 0.70710678});
+  if (xyz.size() != 3 || q.size() != 4) {
+    RCLCPP_ERROR(logger, "sequence.ring.xyz needs 3 values, sequence.ring.quat_xyzw needs 4");
+    return 2;
+  }
+  ring.has_ring_pose_value = true;
+  ring.ring_pose_valid = true;
+  ring.ring_pose.frame_id = node->get_parameter_or<std::string>("sequence.ring.frame_id", "base_link");
+  ring.ring_pose.position = mtc::core::Vector3{xyz[0], xyz[1], xyz[2]};
+  ring.ring_pose.orientation = mtc::core::Quaternion{q[0], q[1], q[2], q[3]};
+  ring.ring_pose.stamp_s = 0.0;
+  ring.ring_pose.valid = true;
+
+  const auto strategy = mtc::manipulation::make_strategy(tool);
+  auto backend = std::make_shared<MoveGroupBackend>(node, options);
+  MoveItPlannerPort port(backend, config, std::make_shared<mtc::core::SteadyClock>(), false);
+
+  auto acquire_primitives = strategy->make_acquire_plan(ring);
+  const auto test_lift = strategy->make_test_lift_plan(ring);
+  acquire_primitives.insert(acquire_primitives.end(), test_lift.begin(), test_lift.end());
+  const auto acquire = make_target("ACQUIRE", ring, slot, acquire_primitives);
+  std::optional<JointStateSnapshot> acquire_start;
+  if (!start_named_state.empty()) {
+    acquire_start = backend->named_state(start_named_state);
+    if (!acquire_start) {
+      RCLCPP_ERROR(logger, "SRDF named state '%s' not found", start_named_state.c_str());
+      return 2;
+    }
+  }
+  const auto acquire_result = port.plan_blocking(acquire, acquire_start);
+  const auto acquire_report = port.last_report();
+  log_report(logger, acquire_result, acquire_report);
+
+  std::ostringstream yaml;
+  yaml << "# mtc_moveit_planner plan_battery_sequence 证据（Mock，仅规划，未执行）\n";
+  yaml << "# 提环位姿与工位均为占位值；接触段只代表规划意图，不代表可安全执行。\n";
+  yaml << "tool: plan_battery_sequence\n";
+  yaml << "wall_time: \"" << mtc::moveit_planner::timestamp_for_filename() << "\"\n";
+  yaml << "tool_type: \"" << tool << "\"\n";
+  yaml << "slot: \"" << slot << "\"\n";
+  yaml << "start: \"" << (start_named_state.empty() ? std::string("current /joint_states") :
+    "SRDF named state " + start_named_state) << "\"\n";
+  yaml << "ring_pose:\n" << mtc::moveit_planner::pose_to_yaml(ring.ring_pose, "  ");
+  yaml << "tcp:\n";
+  yaml << "  status: \"" << mtc::moveit_planner::to_string(config.tcp_status) << "\"\n";
+  yaml << "  xyz: [" << config.ee_to_tcp.translation.x << ", " << config.ee_to_tcp.translation.y <<
+    ", " << config.ee_to_tcp.translation.z << "]\n";
+  yaml << "phases:\n";
+  yaml << "  - " << mtc::moveit_planner::plan_to_yaml(acquire_result, acquire_report, "    ").substr(4);
+
+  bool ok = acquire_result.ok;
+  if (acquire_result.ok && !acquire_result.commands.empty() &&
+    acquire_result.commands.back().trajectory)
+  {
+    const auto & last = *acquire_result.commands.back().trajectory;
+    const JointStateSnapshot after_test_lift{
+      last.joint_names, mtc::moveit_planner::final_positions(last)};
+    auto transport_primitives = strategy->make_lift_plan(ring);
+    for (const auto & extra : {
+        strategy->make_transport_plan(ring, slot), strategy->make_seat_plan(slot),
+        strategy->make_seat_contact_plan(slot), strategy->make_retreat_plan(slot)})
+    {
+      transport_primitives.insert(transport_primitives.end(), extra.begin(), extra.end());
+    }
+    const auto transport = make_target("TRANSPORT", ring, slot, transport_primitives);
+    const auto transport_result = port.plan_blocking(transport, after_test_lift);
+    const auto transport_report = port.last_report();
+    log_report(logger, transport_result, transport_report);
+    yaml << "  - " <<
+      mtc::moveit_planner::plan_to_yaml(transport_result, transport_report, "    ").substr(4);
+    ok = ok && transport_result.ok;
+  }
+
+  const std::string path = output_dir + "/battery_sequence_" + tool + "_" + slot + "_" +
+    mtc::moveit_planner::timestamp_for_filename() + ".yaml";
+  if (!mtc::moveit_planner::write_text_file(path, yaml.str())) {
+    RCLCPP_ERROR(logger, "failed to write %s", path.c_str());
+    return 3;
+  }
+  RCLCPP_INFO(logger, "%s -> %s", ok ? "SEQUENCE PLAN OK" : "SEQUENCE PLAN FAILED", path.c_str());
+  return ok ? 0 : 1;
+}
+
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  rclcpp::init(argc, argv);
+  rclcpp::NodeOptions node_options;
+  node_options.automatically_declare_parameters_from_overrides(true);
+  auto node = std::make_shared<rclcpp::Node>("mtc_plan_battery_sequence", node_options);
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(node);
+  std::thread spinner([&executor]() {executor.spin();});
+  int rc = 1;
+  try {
+    rc = run(node);
+  } catch (const std::exception & error) {
+    RCLCPP_ERROR(node->get_logger(), "fatal: %s", error.what());
+    rc = 4;
+  }
+  executor.cancel();
+  spinner.join();
+  rclcpp::shutdown();
+  return rc;
+}
diff --git a/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp b/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp
new file mode 100644
index 0000000..7e4e316
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_fixed_pose_main.cpp
@@ -0,0 +1,203 @@
+// Copyright 2026 meituan_challenge_ws contributors
+//
+// P0 证据工具：从当前机器人状态规划到一个**固定、可复现**的 6D 目标位姿，
+// 输出返回状态、规划耗时与完整时间参数化轨迹（YAML）。只规划，不执行。
+//
+// 默认目标：SRDF 命名状态 "home" 的 ee_link 正运动学位姿（保证可达、可复现）。
+// 也可用参数 target.mode:=pose 指定 target.frame_id / target.xyz / target.quat_xyzw。
+
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <memory>
+#include <sstream>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rclcpp/rclcpp.hpp>
+
+#include "mtc_moveit_planner/move_group_backend.hpp"
+#include "mtc_moveit_planner/plan_report_io.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+#include "mtc_moveit_planner/ros_params.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace
+{
+
+using mtc::moveit_planner::BackendRequest;
+using mtc::moveit_planner::JointStateSnapshot;
+using mtc::moveit_planner::MotionMode;
+using mtc::moveit_planner::MoveGroupBackend;
+
+std::string num(double v)
+{
+  std::ostringstream os;
+  os << std::setprecision(10) << v;
+  return os.str();
+}
+
+int run(const std::shared_ptr<rclcpp::Node> & node)
+{
+  const auto logger = node->get_logger();
+  const auto planner_config = mtc::moveit_planner::load_planner_config(*node);
+  const auto options = mtc::moveit_planner::load_backend_options(*node);
+  const std::string output_dir = node->get_parameter_or<std::string>("output_dir", "planning_evidence");
+  const std::string target_mode = node->get_parameter_or<std::string>("target.mode", "named_state_fk");
+  const std::string named = node->get_parameter_or<std::string>("target.named_state", "home");
+
+  auto backend = std::make_shared<MoveGroupBackend>(node, options);
+  RCLCPP_INFO(logger, "planning frame='%s' ee_link='%s' group='%s' pipeline='%s' planner='%s'",
+    backend->planning_frame().c_str(), backend->end_effector_link().c_str(),
+    options.planning_group.c_str(), options.planning_pipeline.c_str(), options.planner_id.c_str());
+
+  std::optional<JointStateSnapshot> start;
+  for (int i = 0; i < 10 && !start; ++i) {
+    start = backend->current_state();
+  }
+  if (!start) {
+    RCLCPP_ERROR(logger, "no current robot state from /joint_states");
+    return 2;
+  }
+
+  mtc::core::Pose6D target;
+  if (target_mode == "named_state_fk") {
+    const auto js = backend->named_state(named);
+    if (!js) {
+      RCLCPP_ERROR(logger, "SRDF named state '%s' not found", named.c_str());
+      return 2;
+    }
+    const auto fk = backend->end_effector_pose(*js);
+    if (!fk) {
+      RCLCPP_ERROR(logger, "FK failed for named state '%s'", named.c_str());
+      return 2;
+    }
+    target = *fk;
+  } else {
+    const auto xyz = node->get_parameter_or<std::vector<double>>("target.xyz", {});
+    const auto q = node->get_parameter_or<std::vector<double>>("target.quat_xyzw", {});
+    if (xyz.size() != 3 || q.size() != 4) {
+      RCLCPP_ERROR(logger, "target.xyz needs 3 values and target.quat_xyzw needs 4");
+      return 2;
+    }
+    target.frame_id = node->get_parameter_or<std::string>("target.frame_id", backend->planning_frame());
+    target.position = mtc::core::Vector3{xyz[0], xyz[1], xyz[2]};
+    target.orientation = mtc::core::Quaternion{q[0], q[1], q[2], q[3]};
+    target.valid = true;
+    if (!target.orientation.is_normalized()) {
+      RCLCPP_ERROR(logger, "target quaternion is not normalized (norm=%f)", target.orientation.norm());
+      return 2;
+    }
+  }
+
+  BackendRequest request;
+  request.label = "fixed_pose_test";
+  request.mode = MotionMode::FREE_SPACE;
+  request.ee_goal = target;
+  request.start = *start;
+  request.velocity_scaling = planner_config.velocity_scaling;
+  request.acceleration_scaling = planner_config.acceleration_scaling;
+  request.max_linear_speed_m_s = node->get_parameter_or("target.max_linear_speed_m_s", 0.0);
+  request.max_angular_speed_rad_s = node->get_parameter_or("target.max_angular_speed_rad_s", 0.0);
+  request.planning_time_s = planner_config.planning_time_s;
+  request.joint_bounds = planner_config.joint_position_limits;
+
+  const auto result = backend->plan(request);
+  const double stamp = node->now().seconds();
+  mtc::moveit_planner::ConversionResult converted;
+  double position_error = -1.0;
+  double angle_error = -1.0;
+  if (result.ok) {
+    converted = mtc::moveit_planner::to_timed_trajectory(
+      result.trajectory, planner_config.joint_names, backend->planning_frame(), stamp);
+    const auto target_in_frame = backend->transform_to_planning_frame(target);
+    const auto reached = backend->end_effector_pose(result.end_state);
+    if (target_in_frame && reached) {
+      position_error = mtc::moveit_planner::distance_between(
+        reached->position, target_in_frame->position);
+      angle_error = mtc::moveit_planner::angle_between(
+        reached->orientation, target_in_frame->orientation);
+    }
+  }
+  const bool ok = result.ok && converted.ok;
+
+  std::ostringstream yaml;
+  yaml << "# mtc_moveit_planner plan_fixed_pose 证据（Mock / Fake Hardware，仅规划，未执行）\n";
+  yaml << "tool: plan_fixed_pose\n";
+  yaml << "wall_time: \"" << mtc::moveit_planner::timestamp_for_filename() << "\"\n";
+  yaml << "ros_time_s: " << num(stamp) << '\n';
+  yaml << "configuration:\n";
+  yaml << "  planning_group: \"" << options.planning_group << "\"\n";
+  yaml << "  planning_frame: \"" << backend->planning_frame() << "\"\n";
+  yaml << "  end_effector_link: \"" << backend->end_effector_link() << "\"\n";
+  yaml << "  planning_pipeline: \"" << options.planning_pipeline << "\"\n";
+  yaml << "  planner_id: \"" << options.planner_id << "\"\n";
+  yaml << "  velocity_scaling: " << num(request.velocity_scaling) << '\n';
+  yaml << "  acceleration_scaling: " << num(request.acceleration_scaling) << '\n';
+  yaml << "  planning_time_limit_s: " << num(request.planning_time_s) << '\n';
+  yaml << "start_state:\n" << mtc::moveit_planner::joint_state_to_yaml(*start, "  ");
+  yaml << "target:\n";
+  yaml << "  mode: \"" << target_mode << "\"\n";
+  if (target_mode == "named_state_fk") {
+    yaml << "  named_state: \"" << named << "\"\n";
+  }
+  yaml << "  ee_link_pose:\n" << mtc::moveit_planner::pose_to_yaml(target, "    ");
+  yaml << "result:\n";
+  yaml << "  ok: " << (ok ? "true" : "false") << '\n';
+  yaml << "  reason: \"" << (result.ok ? (converted.ok ? "" : "INVALID_TRAJECTORY") : result.reason) << "\"\n";
+  yaml << "  message: \"" << (result.ok && !converted.ok ? converted.error : result.message) << "\"\n";
+  yaml << "  planning_time_s: " << num(result.planning_time_s) << '\n';
+  yaml << "  time_scale_applied: " << num(result.time_scale_applied) << '\n';
+  yaml << "  max_ee_linear_speed_m_s: " << num(result.max_linear_speed_m_s) << '\n';
+  yaml << "  max_ee_angular_speed_rad_s: " << num(result.max_angular_speed_rad_s) << '\n';
+  yaml << "  final_position_error_m: " << num(position_error) << '\n';
+  yaml << "  final_orientation_error_rad: " << num(angle_error) << '\n';
+  if (ok) {
+    yaml << "  end_state:\n" << mtc::moveit_planner::joint_state_to_yaml(result.end_state, "    ");
+    yaml << "trajectory:  # mtc::core::TimedTrajectory，关节顺序 = PickPlaceConfig::joint_names\n";
+    yaml << mtc::moveit_planner::trajectory_to_yaml(converted.trajectory, "  ");
+  }
+
+  const std::string path = output_dir + "/fixed_pose_plan_" +
+    mtc::moveit_planner::timestamp_for_filename() + ".yaml";
+  if (!mtc::moveit_planner::write_text_file(path, yaml.str())) {
+    RCLCPP_ERROR(logger, "failed to write %s", path.c_str());
+    return 3;
+  }
+  if (ok) {
+    RCLCPP_INFO(logger,
+      "PLAN OK: planning_time=%.3f s, duration=%.3f s, points=%zu, final_pos_err=%.2e m, "
+      "final_rot_err=%.2e rad -> %s",
+      result.planning_time_s, converted.trajectory.duration_s(), converted.trajectory.points.size(),
+      position_error, angle_error, path.c_str());
+  } else {
+    RCLCPP_ERROR(logger, "PLAN FAILED [%s] %s -> %s", result.reason.c_str(),
+      result.message.c_str(), path.c_str());
+  }
+  return ok ? 0 : 1;
+}
+
+}  // namespace
+
+int main(int argc, char ** argv)
+{
+  rclcpp::init(argc, argv);
+  rclcpp::NodeOptions node_options;
+  node_options.automatically_declare_parameters_from_overrides(true);
+  auto node = std::make_shared<rclcpp::Node>("mtc_plan_fixed_pose", node_options);
+  rclcpp::executors::SingleThreadedExecutor executor;
+  executor.add_node(node);
+  std::thread spinner([&executor]() {executor.spin();});
+  int rc = 1;
+  try {
+    rc = run(node);
+  } catch (const std::exception & error) {
+    RCLCPP_ERROR(node->get_logger(), "fatal: %s", error.what());
+    rc = 4;
+  }
+  executor.cancel();
+  spinner.join();
+  rclcpp::shutdown();
+  return rc;
+}
diff --git a/src/mtc_moveit_planner/src/plan_report_io.cpp b/src/mtc_moveit_planner/src/plan_report_io.cpp
new file mode 100644
index 0000000..72a3d02
--- /dev/null
+++ b/src/mtc_moveit_planner/src/plan_report_io.cpp
@@ -0,0 +1,191 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/plan_report_io.hpp"
+
+#include <chrono>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+namespace
+{
+
+std::string num(double value)
+{
+  std::ostringstream os;
+  os << std::setprecision(10) << value;
+  return os.str();
+}
+
+std::string list(const std::vector<double> & values)
+{
+  std::ostringstream os;
+  os << '[';
+  for (size_t i = 0; i < values.size(); ++i) {
+    os << (i ? ", " : "") << num(values[i]);
+  }
+  os << ']';
+  return os.str();
+}
+
+std::string list(const std::vector<std::string> & values)
+{
+  std::ostringstream os;
+  os << '[';
+  for (size_t i = 0; i < values.size(); ++i) {
+    os << (i ? ", " : "") << '"' << values[i] << '"';
+  }
+  os << ']';
+  return os.str();
+}
+
+std::string quoted(const std::string & text)
+{
+  std::string out = "\"";
+  for (char c : text) {
+    if (c == '"' || c == '\\') {
+      out += '\\';
+    }
+    out += c;
+  }
+  return out + "\"";
+}
+
+}  // namespace
+
+std::string pose_to_yaml(const mtc::core::Pose6D & pose, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "frame_id: " << quoted(pose.frame_id) << '\n';
+  os << indent << "position_m: " << list({pose.position.x, pose.position.y, pose.position.z}) <<
+    '\n';
+  os << indent << "orientation_xyzw: " <<
+    list({pose.orientation.x, pose.orientation.y, pose.orientation.z, pose.orientation.w}) << '\n';
+  return os.str();
+}
+
+std::string joint_state_to_yaml(const JointStateSnapshot & state, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "joint_names: " << list(state.names) << '\n';
+  os << indent << "positions_rad: " << list(state.positions) << '\n';
+  return os.str();
+}
+
+std::string trajectory_to_yaml(
+  const mtc::core::TimedTrajectory & trajectory, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "trajectory_id: " << quoted(trajectory.trajectory_id) << '\n';
+  os << indent << "header_frame_id: " << quoted(trajectory.header_frame_id) << '\n';
+  os << indent << "stamp_s: " << num(trajectory.stamp_s) << '\n';
+  os << indent << "shape_is_valid: " << (trajectory.shape_is_valid() ? "true" : "false") << '\n';
+  os << indent << "duration_s: " << num(trajectory.duration_s()) << '\n';
+  os << indent << "point_count: " << trajectory.points.size() << '\n';
+  os << indent << "joint_names: " << list(trajectory.joint_names) << '\n';
+  os << indent << "points:\n";
+  for (const auto & point : trajectory.points) {
+    os << indent << "  - time_from_start_s: " << num(point.time_from_start_s) << '\n';
+    os << indent << "    positions_rad: " << list(point.positions_rad) << '\n';
+    if (!point.velocities_rad_s.empty()) {
+      os << indent << "    velocities_rad_s: " << list(point.velocities_rad_s) << '\n';
+    }
+    if (!point.accelerations_rad_s2.empty()) {
+      os << indent << "    accelerations_rad_s2: " << list(point.accelerations_rad_s2) << '\n';
+    }
+  }
+  return os.str();
+}
+
+std::string plan_to_yaml(
+  const mtc::core::PlanResult & result, const PlanReport & report, const std::string & indent)
+{
+  std::ostringstream os;
+  os << indent << "phase: " << quoted(report.phase) << '\n';
+  os << indent << "ok: " << (result.ok ? "true" : "false") << '\n';
+  os << indent << "error_code: " << result.error_code << '\n';
+  os << indent << "message: " << quoted(result.message) << '\n';
+  os << indent << "planning_frame: " << quoted(report.planning_frame) << '\n';
+  os << indent << "end_effector_link: " << quoted(report.end_effector_link) << '\n';
+  os << indent << "simulation_only: " << (report.simulation_only ? "true" : "false") << '\n';
+  os << indent << "uncalibrated_inputs: " << list(report.uncalibrated_inputs) << '\n';
+  os << indent << "start_state:\n" << joint_state_to_yaml(report.start_state, indent + "  ");
+  os << indent << "primitives:\n";
+  for (const auto & p : report.primitives) {
+    os << indent << "  - primitive_name: " << quoted(p.primitive_name) << '\n';
+    os << indent << "    ok: " << (p.ok ? "true" : "false") << '\n';
+    if (!p.ok) {
+      os << indent << "    reason: " << quoted(p.reason) << '\n';
+    }
+    os << indent << "    message: " << quoted(p.message) << '\n';
+    os << indent << "    mode: " << quoted(p.mode) << '\n';
+    os << indent << "    method: " << quoted(p.method) << '\n';
+    os << indent << "    goal_kind: " << quoted(p.goal_kind) << '\n';
+    os << indent << "    start_assumption: " << quoted(p.start_assumption) << '\n';
+    os << indent << "    contact_intent_only: " << (p.contact_intent_only ? "true" : "false") <<
+      '\n';
+    os << indent << "    ee_goal:\n" << pose_to_yaml(p.ee_goal, indent + "      ");
+    os << indent << "    planning_time_s: " << num(p.planning_time_s) << '\n';
+    os << indent << "    cartesian_fraction: " << num(p.cartesian_fraction) << '\n';
+    os << indent << "    time_scale_applied: " << num(p.time_scale_applied) << '\n';
+    os << indent << "    max_ee_linear_speed_m_s: " << num(p.max_linear_speed_m_s) << '\n';
+    os << indent << "    max_ee_angular_speed_rad_s: " << num(p.max_angular_speed_rad_s) << '\n';
+    os << indent << "    duration_s: " << num(p.duration_s) << '\n';
+    os << indent << "    point_count: " << p.point_count << '\n';
+    os << indent << "    timeout_ms: " << p.timeout_ms << '\n';
+    os << indent << "    state_watchdog_s: " << num(p.state_watchdog_s) << '\n';
+  }
+  os << indent << "commands:\n";
+  for (const auto & c : result.commands) {
+    os << indent << "  - primitive_name: " << quoted(c.primitive_name) << '\n';
+    os << indent << "    command_id: " << quoted(c.command_id) << "  # FSM 在派发时赋值\n";
+    os << indent << "    velocity_scaling: " << num(c.velocity_scaling) << '\n';
+    os << indent << "    acceleration_scaling: " << num(c.acceleration_scaling) << '\n';
+    os << indent << "    timeout_ms: " << c.timeout_ms << '\n';
+    os << indent << "    requires_contact: " << (c.requires_contact ? "true" : "false") << '\n';
+    os << indent << "    simulation_only: " << (c.simulation_only ? "true" : "false") << '\n';
+    os << indent << "    target_rad: " << list(c.target_rad) << '\n';
+    if (c.trajectory) {
+      os << indent << "    trajectory:\n" << trajectory_to_yaml(*c.trajectory, indent + "      ");
+    }
+  }
+  return os.str();
+}
+
+bool write_text_file(const std::string & path, const std::string & content)
+{
+  try {
+    const std::filesystem::path p(path);
+    if (p.has_parent_path()) {
+      std::filesystem::create_directories(p.parent_path());
+    }
+    std::ofstream out(path);
+    if (!out) {
+      return false;
+    }
+    out << content;
+    return static_cast<bool>(out);
+  } catch (const std::exception &) {
+    return false;
+  }
+}
+
+std::string timestamp_for_filename()
+{
+  const auto now = std::chrono::system_clock::to_time_t(std::chrono::system_clock::now());
+  std::tm local{};
+  localtime_r(&now, &local);
+  std::ostringstream os;
+  os << std::put_time(&local, "%Y%m%d_%H%M%S");
+  return os.str();
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
