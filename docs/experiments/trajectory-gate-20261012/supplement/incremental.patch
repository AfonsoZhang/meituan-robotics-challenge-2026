new file mode 100755
index 0000000..b18b6b8
--- /dev/null
+++ b/src/mtc_moveit_planner/scripts/ros_graph_snapshot.py
@@ -0,0 +1,87 @@
+#!/usr/bin/env python3
+"""只读 ROS 图快照（不依赖 ros2 CLI daemon）：节点、话题、Action、控制器、硬件组件、一帧 JointState。
+
+WSL2 mirrored 网络下 ros2 CLI 连接本机 daemon 端口会超时，故直接用 rclpy 查询。
+只调用 list_* 查询服务，不加载/切换控制器，不发送任何运动目标。
+"""
+
+import sys
+import time
+
+import rclpy
+from controller_manager_msgs.srv import ListControllers, ListHardwareComponents
+from sensor_msgs.msg import JointState
+
+
+def call(node, srv_type, name, timeout=10.0):
+    client = node.create_client(srv_type, name)
+    if not client.wait_for_service(timeout_sec=timeout):
+        return None
+    future = client.call_async(srv_type.Request())
+    rclpy.spin_until_future_complete(node, future, timeout_sec=timeout)
+    return future.result()
+
+
+def main():
+    rclpy.init()
+    node = rclpy.create_node('mtc_ros_graph_snapshot')
+    end = time.time() + 3.0
+    while time.time() < end:
+        rclpy.spin_once(node, timeout_sec=0.1)
+
+    print('## nodes')
+    for name, ns in sorted(node.get_node_names_and_namespaces()):
+        print(f"{ns.rstrip('/')}/{name}")
+
+    topics = sorted(node.get_topic_names_and_types())
+    print('## topics')
+    for name, types in topics:
+        if '/_action/' not in name:
+            print(f'{name} [{", ".join(types)}]')
+
+    print('## actions')
+    for name, types in topics:
+        if name.endswith('/_action/status'):
+            action = name[: -len('/_action/status')]
+            feedback = dict(topics).get(action + '/_action/feedback', [''])[0]
+            print(f"{action} [{feedback.replace('_FeedbackMessage', '')}]")
+
+    print('## controllers (/controller_manager/list_controllers)')
+    result = call(node, ListControllers, '/controller_manager/list_controllers')
+    if result is None:
+        print('UNAVAILABLE')
+    else:
+        for c in result.controller:
+            print(f'{c.name} type={c.type} state={c.state} '
+                  f'claimed={list(c.claimed_interfaces)}')
+
+    print('## hardware components (/controller_manager/list_hardware_components)')
+    result = call(node, ListHardwareComponents, '/controller_manager/list_hardware_components')
+    if result is None:
+        print('UNAVAILABLE')
+    else:
+        for hw in result.component:
+            print(f'{hw.name} type={hw.type} plugin={hw.plugin_name} '
+                  f'state={hw.state.label}')
+
+    print('## joint_states (one message)')
+    msgs = []
+    sub = node.create_subscription(JointState, '/joint_states', msgs.append, 10)
+    end = time.time() + 5.0
+    while time.time() < end and not msgs:
+        rclpy.spin_once(node, timeout_sec=0.1)
+    if msgs:
+        m = msgs[0]
+        print(f'stamp={m.header.stamp.sec}.{m.header.stamp.nanosec:09d}')
+        for n, p in zip(m.name, m.position):
+            print(f'{n}: {p:.6f}')
+    else:
+        print('NO MESSAGE')
+    node.destroy_subscription(sub)
+    node.destroy_node()
+    rclpy.shutdown()
+    return 0
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/src/mtc_moveit_planner/scripts/run_planning_evidence.sh b/src/mtc_moveit_planner/scripts/run_planning_evidence.sh
new file mode 100755
index 0000000..12a9f89
--- /dev/null
+++ b/src/mtc_moveit_planner/scripts/run_planning_evidence.sh
@@ -0,0 +1,144 @@
+#!/usr/bin/env bash
+# 一键采集规划证据（Mock / Fake Hardware，只规划不执行）：
+#   1) 空 ROS 域检查 + 静态 Xacro 核验（只允许 mock_components/GenericSystem）
+#   2) 启动 Fake 控制 launch 与 move_group（无 RViz），各自独立进程组
+#   3) 只读采集：hardware/controllers/nodes/topics/actions/joint_states/TF 图/URDF/SRDF
+#   4) 运行 plan_fixed_pose 与 plan_battery_sequence（V1、V2）
+#   5) 只结束本脚本启动的进程组；不使用全局 pkill/killall
+# 不发送任何 FollowJointTrajectory goal，不连接真实设备。
+#
+# 用法：bash run_planning_evidence.sh [输出目录]
+set -uo pipefail
+set -m   # 每个后台 launch 自成进程组：PGID == $!，退出时只结束自己的进程组
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+# shellcheck source=env.sh
+source "$SCRIPT_DIR/env.sh"
+OUT="${1:-$MTC_WS/docs/planning/evidence/$(date +%Y%m%d_%H%M%S)}"
+mkdir -p "$OUT"
+OUT="$(cd "$OUT" && pwd)"
+SUMMARY="$OUT/SUMMARY.txt"
+: > "$SUMMARY"
+note() { echo "$*" | tee -a "$SUMMARY"; }
+
+CTRL_PGID=""
+MG_PGID=""
+stop_group() {
+  local pgid="$1" name="$2"
+  [ -z "$pgid" ] && return 0
+  if kill -0 -- "-$pgid" 2>/dev/null; then
+    kill -INT -- "-$pgid" 2>/dev/null
+    for _ in $(seq 1 30); do kill -0 -- "-$pgid" 2>/dev/null || break; sleep 0.5; done
+    if kill -0 -- "-$pgid" 2>/dev/null; then
+      note "WARN: $name did not exit 15 s after SIGINT; sending SIGTERM to its own process group"
+      kill -TERM -- "-$pgid" 2>/dev/null
+      sleep 3
+    fi
+  fi
+}
+cleanup() {
+  stop_group "$MG_PGID" "move_group launch"
+  stop_group "$CTRL_PGID" "control launch"
+}
+trap cleanup EXIT
+
+note "== mtc_moveit_planner evidence $(date '+%F %T %Z') =="
+note "ROS_DISTRO=$ROS_DISTRO ROS_DOMAIN_ID=$ROS_DOMAIN_ID RMW=$RMW_IMPLEMENTATION"
+note "aubo_ros2_driver prefix: $(ros2 pkg prefix aubo_ros2_driver)"
+note "mtc_moveit_planner prefix: $(ros2 pkg prefix mtc_moveit_planner)"
+note "driver commit: $(git -C "$AUBO_WS/src/aubo_ros2_driver" rev-parse HEAD)"
+note "aubo_description commit: $(git -C "$AUBO_WS/src/aubo_ros2_driver/aubo_description" rev-parse HEAD)"
+note "fake patch sha256: $(sha256sum "$AUBO_WS/src/aubo_ros2_driver/aubo_description/urdf/xacro/inc/aubo.ros2_control.xacro" | cut -d' ' -f1)"
+note "team repo: $(git -C "$MTC_WS" rev-parse --abbrev-ref HEAD) @ $(git -C "$MTC_WS" rev-parse HEAD)"
+
+# ---- 1. 前置检查 ----------------------------------------------------------
+EXISTING="$(ros2 node list --no-daemon --spin-time 2 2>/dev/null)"
+if [ -n "$EXISTING" ]; then
+  note "ABORT: ROS domain $ROS_DOMAIN_ID is not empty:"; note "$EXISTING"; exit 1
+fi
+python3 - "$OUT" <<'PY' | tee -a "$SUMMARY"
+import subprocess, sys, xml.etree.ElementTree as ET
+from pathlib import Path
+from ament_index_python.packages import get_package_share_directory
+out = Path(sys.argv[1])
+share = Path(get_package_share_directory('aubo_description'))
+xml = subprocess.check_output(['xacro', str(share / 'urdf/xacro/inc/aubo_ros2.xacro'),
+                               'aubo_type:=aubo_S3', 'use_fake_hardware:=true'], text=True)
+(out / 'aubo_S3_fake_expanded.urdf').write_text(xml)
+root = ET.fromstring(xml)
+plugins = [p.text.strip() for p in root.findall('ros2_control/hardware/plugin')]
+assert plugins == ['mock_components/GenericSystem'], plugins
+links = [l.get('name') for l in root.findall('link')]
+joints = [(j.get('name'), j.get('type'), j.find('parent').get('link'), j.find('child').get('link'))
+          for j in root.findall('joint')]
+print('PASS static xacro: plugin=mock_components/GenericSystem')
+print('links:', links)
+for j in joints:
+    print('joint: %s (%s) %s -> %s' % j)
+PY
+[ "${PIPESTATUS[0]}" -eq 0 ] || { note "ABORT: static xacro check failed"; exit 1; }
+cp "$(ros2 pkg prefix aubo_moveit_config)/share/aubo_moveit_config/config/aubo_robot.srdf" "$OUT/"
+note "srdf sha256: $(sha256sum "$OUT/aubo_robot.srdf" | cut -d' ' -f1)"
+
+# ---- 2. 启动 Fake 控制与 move_group ----------------------------------------
+ros2 launch aubo_ros2_driver aubo_control.launch.py \
+  aubo_type:=aubo_S3 use_fake_hardware:=true \
+  initial_joint_controller:=joint_trajectory_controller launch_rviz:=false \
+  > "$OUT/control_launch.log" 2>&1 &
+CTRL_PGID=$!
+ok=0
+for _ in $(seq 1 60); do
+  if [ "$(grep -c "Configured and activated" "$OUT/control_launch.log")" -ge 2 ]; then ok=1; break; fi
+  sleep 1
+done
+[ "$ok" -eq 1 ] || { note "ABORT: controllers not active within 60 s (see control_launch.log)"; exit 1; }
+note "PASS controllers active"
+
+ros2 launch aubo_moveit_config aubo_moveit.launch.py aubo_type:=aubo_S3 launch_rviz:=false \
+  > "$OUT/move_group_launch.log" 2>&1 &
+MG_PGID=$!
+ok=0
+for _ in $(seq 1 90); do
+  if grep -q "You can start planning now" "$OUT/move_group_launch.log"; then ok=1; break; fi
+  sleep 1
+done
+[ "$ok" -eq 1 ] || { note "ABORT: move_group not ready within 90 s (see move_group_launch.log)"; exit 1; }
+note "PASS move_group ready"
+
+# ---- 3. 只读采集 ------------------------------------------------------------
+# ros2 CLI 在 WSL2 mirrored 网络下连接本机 daemon 端口会超时，改用 rclpy 只读快照。
+timeout 60 python3 "$SCRIPT_DIR/ros_graph_snapshot.py" > "$OUT/ros_graph.txt" 2>&1
+grep -q "plugin=mock_components/GenericSystem state=active" "$OUT/ros_graph.txt" \
+  && note "PASS runtime hardware component: mock_components/GenericSystem (active)" \
+  || { note "ABORT: runtime plugin is not mock_components/GenericSystem (see ros_graph.txt)"; exit 1; }
+grep -q "joint_trajectory_controller type=joint_trajectory_controller/JointTrajectoryController state=active" "$OUT/ros_graph.txt" \
+  && note "PASS joint_trajectory_controller active" || note "WARN: joint_trajectory_controller not active"
+for pair in "world base_link" "base_link ee_link" "world ee_link"; do
+  # shellcheck disable=SC2086
+  timeout 6 ros2 run tf2_ros tf2_echo $pair > "$OUT/tf2_echo_${pair// /_to_}.txt" 2>&1
+done
+( cd "$OUT" && timeout 30 ros2 run tf2_tools view_frames > view_frames.log 2>&1 )
+ls "$OUT"/frames_*.pdf >/dev/null 2>&1 && note "PASS TF graph exported: $(basename "$(ls "$OUT"/frames_*.pdf | head -1)")" \
+  || note "WARN: view_frames produced no PDF (see view_frames.log)"
+
+# ---- 4. 规划工具 ------------------------------------------------------------
+run_tool() {
+  local name="$1"; shift
+  ros2 launch mtc_moveit_planner plan_tool.launch.py output_dir:="$OUT" "$@" > "$OUT/$name.log" 2>&1
+  # ros2 launch 的返回码不反映节点结果，以工具自身的结论行为准。
+  if grep -qE "PLAN OK|SEQUENCE PLAN OK" "$OUT/$name.log"; then
+    note "PASS $name"
+  else
+    note "FAIL $name: $(grep -oE "PLAN FAILED.*|SEQUENCE PLAN FAILED.*|\[(ACQUIRE|TRANSPORT)\] ok=false.*" "$OUT/$name.log" | head -2 | tr '\n' ' ')"
+  fi
+}
+run_tool plan_fixed_pose program:=plan_fixed_pose
+run_tool plan_battery_sequence_v1 program:=plan_battery_sequence
+run_tool plan_battery_sequence_v2 program:=plan_battery_sequence \
+  extra_params_file:="$(ros2 pkg prefix mtc_moveit_planner)/share/mtc_moveit_planner/config/sequence_v2_override.yaml"
+
+# ---- 5. 退出 ----------------------------------------------------------------
+cleanup
+CTRL_PGID=""; MG_PGID=""
+LEFT="$(ros2 node list --no-daemon --spin-time 2 2>/dev/null)"
+if [ -z "$LEFT" ]; then note "PASS all nodes started by this script exited"; else note "WARN nodes still present:"; note "$LEFT"; fi
+note "evidence directory: $OUT"
diff --git a/src/mtc_moveit_planner/scripts/setup_ros_jazzy.sh b/src/mtc_moveit_planner/scripts/setup_ros_jazzy.sh
new file mode 100644
index 0000000..82e5aa5
--- /dev/null
+++ b/src/mtc_moveit_planner/scripts/setup_ros_jazzy.sh
@@ -0,0 +1,48 @@
+#!/usr/bin/env bash
+# 一次性安装 ROS 2 Jazzy + MoveIt 2 + ros2_control（Ubuntu 24.04 / WSL）。
+# 只装系统包，不 clone、不编译、不连接任何机器人。可重复执行。
+# 用法：bash src/mtc_moveit_planner/scripts/setup_ros_jazzy.sh   （中途会要求输入一次 sudo 密码）
+set -euo pipefail
+
+SUDO="sudo -E"   # -E 保留当前终端的代理设置
+
+echo "[1/4] 基础工具与 universe 源"
+$SUDO apt-get -o Acquire::Retries=5 update
+$SUDO apt-get -o Acquire::Retries=5 install -y software-properties-common curl ca-certificates gnupg lsb-release
+$SUDO add-apt-repository -y universe
+
+echo "[2/4] ROS 2 apt 源"
+if ! dpkg -s ros2-apt-source >/dev/null 2>&1; then
+  V=$(curl -fsSL https://api.github.com/repos/ros-infrastructure/ros-apt-source/releases/latest \
+      | grep -F '"tag_name"' | awk -F'"' '{print $4}')
+  test -n "$V"
+  curl -fL -o /tmp/ros2-apt-source.deb \
+    "https://github.com/ros-infrastructure/ros-apt-source/releases/download/${V}/ros2-apt-source_${V}.$(. /etc/os-release && echo "$VERSION_CODENAME")_all.deb"
+  $SUDO dpkg -i /tmp/ros2-apt-source.deb
+fi
+$SUDO apt-get -o Acquire::Retries=5 update
+
+echo "[3/4] ROS 2 Jazzy / MoveIt 2 / ros2_control 及编译测试依赖"
+$SUDO apt-get -o Acquire::Retries=5 install -y \
+  build-essential cmake git libboost-dev python3-pytest python3-yaml socat \
+  python3-colcon-common-extensions python3-rosdep python3-vcstool \
+  ros-jazzy-ros-base ros-jazzy-rmw-fastrtps-cpp \
+  ros-jazzy-ros2-control ros-jazzy-ros2-controllers ros-jazzy-ros2-controllers-test-nodes \
+  ros-jazzy-moveit ros-jazzy-moveit-setup-assistant ros-jazzy-warehouse-ros \
+  ros-jazzy-rviz2 ros-jazzy-xacro ros-jazzy-urdf \
+  ros-jazzy-robot-state-publisher ros-jazzy-joint-state-publisher ros-jazzy-joint-state-publisher-gui \
+  ros-jazzy-tf2-tools ros-jazzy-tf2-ros ros-jazzy-tf2-geometry-msgs \
+  ros-jazzy-ament-cmake-gtest ros-jazzy-ament-lint-auto ros-jazzy-ament-lint-common \
+  ros-jazzy-launch-testing-ament-cmake
+
+echo "[4/4] rosdep 初始化"
+if [ ! -f /etc/ros/rosdep/sources.list.d/20-default.list ]; then
+  $SUDO rosdep init
+fi
+if [ "$(id -u)" -ne 0 ]; then rosdep update --rosdistro jazzy; fi
+
+set +u
+source /opt/ros/jazzy/setup.bash
+echo "完成：ROS_DISTRO=$ROS_DISTRO"
+dpkg -s ros-jazzy-moveit | grep -E '^(Package|Version)'
+dpkg -s ros-jazzy-controller-manager | grep -E '^(Package|Version)'
diff --git a/src/mtc_moveit_planner/src/move_group_backend.cpp b/src/mtc_moveit_planner/src/move_group_backend.cpp
new file mode 100644
index 0000000..b242b03
--- /dev/null
+++ b/src/mtc_moveit_planner/src/move_group_backend.cpp
@@ -0,0 +1,418 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/move_group_backend.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <stdexcept>
+#include <vector>
+
+#include <Eigen/Geometry>
+#include <geometry_msgs/msg/pose_stamped.hpp>
+#include <moveit_msgs/msg/constraints.hpp>
+#include <moveit_msgs/msg/joint_constraint.hpp>
+#include <moveit_msgs/msg/robot_trajectory.hpp>
+#include <rclcpp/rclcpp.hpp>
+
+#if __has_include(<moveit/move_group_interface/move_group_interface.hpp>)
+#include <moveit/move_group_interface/move_group_interface.hpp>
+#else
+#include <moveit/move_group_interface/move_group_interface.h>
+#endif
+#if __has_include(<moveit/robot_state/robot_state.hpp>)
+#include <moveit/robot_state/robot_state.hpp>
+#else
+#include <moveit/robot_state/robot_state.h>
+#endif
+#if __has_include(<moveit/robot_trajectory/robot_trajectory.hpp>)
+#include <moveit/robot_trajectory/robot_trajectory.hpp>
+#else
+#include <moveit/robot_trajectory/robot_trajectory.h>
+#endif
+#if __has_include(<moveit/trajectory_processing/time_optimal_trajectory_generation.hpp>)
+#include <moveit/trajectory_processing/time_optimal_trajectory_generation.hpp>
+#else
+#include <moveit/trajectory_processing/time_optimal_trajectory_generation.h>
+#endif
+#if __has_include(<moveit/utils/moveit_error_code.hpp>)
+#include <moveit/utils/moveit_error_code.hpp>
+#else
+#include <moveit/utils/moveit_error_code.h>
+#endif
+#if __has_include(<tf2_ros/buffer.hpp>)
+#include <tf2_ros/buffer.hpp>
+#include <tf2_ros/transform_listener.hpp>
+#else
+#include <tf2_ros/buffer.h>
+#include <tf2_ros/transform_listener.h>
+#endif
+#include <tf2_geometry_msgs/tf2_geometry_msgs.hpp>
+
+#include "mtc_moveit_planner/pose_math.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+namespace
+{
+
+mtc::core::Pose6D to_pose6d(const Eigen::Isometry3d & transform, const std::string & frame)
+{
+  Eigen::Quaterniond q(transform.linear());
+  q.normalize();
+  mtc::core::Pose6D pose;
+  pose.position = mtc::core::Vector3{
+    transform.translation().x(), transform.translation().y(), transform.translation().z()};
+  pose.orientation = mtc::core::Quaternion{q.x(), q.y(), q.z(), q.w()};
+  pose.frame_id = frame;
+  pose.stamp_s = 0.0;
+  pose.valid = true;
+  return pose;
+}
+
+geometry_msgs::msg::Pose to_msg(const mtc::core::Pose6D & pose)
+{
+  geometry_msgs::msg::Pose msg;
+  msg.position.x = pose.position.x;
+  msg.position.y = pose.position.y;
+  msg.position.z = pose.position.z;
+  const auto q = normalized(pose.orientation);
+  msg.orientation.x = q.x;
+  msg.orientation.y = q.y;
+  msg.orientation.z = q.z;
+  msg.orientation.w = q.w;
+  return msg;
+}
+
+}  // namespace
+
+struct MoveGroupBackend::Impl
+{
+  std::shared_ptr<rclcpp::Node> node;
+  MoveGroupBackendOptions options;
+  std::shared_ptr<tf2_ros::Buffer> tf_buffer;
+  std::shared_ptr<tf2_ros::TransformListener> tf_listener;
+  std::shared_ptr<moveit::planning_interface::MoveGroupInterface> move_group;
+  moveit::core::RobotModelConstPtr model;
+  const moveit::core::JointModelGroup * group = nullptr;
+  std::string planning_frame;
+  std::vector<std::string> joint_names;
+
+  moveit::core::RobotStatePtr state_from(const JointStateSnapshot & snapshot) const
+  {
+    if (!snapshot.shape_is_valid()) {
+      return nullptr;
+    }
+    auto state = std::make_shared<moveit::core::RobotState>(model);
+    state->setToDefaultValues();
+    for (size_t i = 0; i < snapshot.names.size(); ++i) {
+      if (!model->hasJointModel(snapshot.names[i]) || !std::isfinite(snapshot.positions[i])) {
+        return nullptr;
+      }
+      state->setVariablePosition(snapshot.names[i], snapshot.positions[i]);
+    }
+    state->update();
+    return state;
+  }
+
+  JointStateSnapshot snapshot_from(const moveit::core::RobotState & state) const
+  {
+    JointStateSnapshot snapshot;
+    snapshot.names = joint_names;
+    state.copyJointGroupPositions(group, snapshot.positions);
+    return snapshot;
+  }
+};
+
+MoveGroupBackend::MoveGroupBackend(
+  std::shared_ptr<rclcpp::Node> node, MoveGroupBackendOptions options)
+: impl_(std::make_unique<Impl>())
+{
+  impl_->node = std::move(node);
+  impl_->options = std::move(options);
+  impl_->tf_buffer = std::make_shared<tf2_ros::Buffer>(impl_->node->get_clock());
+  impl_->tf_listener = std::make_shared<tf2_ros::TransformListener>(*impl_->tf_buffer);
+  impl_->move_group = std::make_shared<moveit::planning_interface::MoveGroupInterface>(
+    impl_->node, impl_->options.planning_group);
+  impl_->model = impl_->move_group->getRobotModel();
+  impl_->group = impl_->model->getJointModelGroup(impl_->options.planning_group);
+  if (impl_->group == nullptr) {
+    throw std::runtime_error("planning group not found: " + impl_->options.planning_group);
+  }
+  if (!impl_->model->hasLinkModel(impl_->options.end_effector_link)) {
+    throw std::runtime_error("end-effector link not found: " + impl_->options.end_effector_link);
+  }
+  impl_->planning_frame = impl_->move_group->getPlanningFrame();
+  impl_->joint_names = impl_->group->getActiveJointModelNames();
+  impl_->move_group->setPlanningPipelineId(impl_->options.planning_pipeline);
+  impl_->move_group->setPlannerId(impl_->options.planner_id);
+  impl_->move_group->setEndEffectorLink(impl_->options.end_effector_link);
+  impl_->move_group->setNumPlanningAttempts(1);
+}
+
+MoveGroupBackend::~MoveGroupBackend() = default;
+
+std::string MoveGroupBackend::planning_frame() const {return impl_->planning_frame;}
+
+std::string MoveGroupBackend::end_effector_link() const {return impl_->options.end_effector_link;}
+
+std::optional<JointStateSnapshot> MoveGroupBackend::current_state()
+{
+  const auto state = impl_->move_group->getCurrentState(impl_->options.state_timeout_s);
+  if (!state) {
+    return std::nullopt;
+  }
+  return impl_->snapshot_from(*state);
+}
+
+std::optional<JointStateSnapshot> MoveGroupBackend::named_state(const std::string & name)
+{
+  auto state = std::make_shared<moveit::core::RobotState>(impl_->model);
+  state->setToDefaultValues();
+  if (!state->setToDefaultValues(impl_->group, name)) {
+    return std::nullopt;
+  }
+  state->update();
+  return impl_->snapshot_from(*state);
+}
+
+std::optional<mtc::core::Pose6D> MoveGroupBackend::end_effector_pose(
+  const JointStateSnapshot & snapshot)
+{
+  const auto state = impl_->state_from(snapshot);
+  if (!state) {
+    return std::nullopt;
+  }
+  return to_pose6d(
+    state->getGlobalLinkTransform(impl_->options.end_effector_link), impl_->planning_frame);
+}
+
+std::optional<mtc::core::Pose6D> MoveGroupBackend::transform_to_planning_frame(
+  const mtc::core::Pose6D & pose)
+{
+  if (pose.frame_id.empty()) {
+    return std::nullopt;
+  }
+  if (pose.frame_id == impl_->planning_frame) {
+    return pose;
+  }
+  geometry_msgs::msg::PoseStamped in;
+  in.header.frame_id = pose.frame_id;
+  // Pose6D::stamp_s 属于 FSM 时基而非 ROS 时间，这里取最新可用变换（静态 TF 不受影响）。
+  in.header.stamp = rclcpp::Time(0, 0, impl_->node->get_clock()->get_clock_type());
+  in.pose = to_msg(pose);
+  try {
+    const auto out = impl_->tf_buffer->transform(
+      in, impl_->planning_frame, tf2::durationFromSec(impl_->options.tf_timeout_s));
+    mtc::core::Pose6D result = pose;
+    result.frame_id = impl_->planning_frame;
+    result.position = mtc::core::Vector3{
+      out.pose.position.x, out.pose.position.y, out.pose.position.z};
+    result.orientation = mtc::core::Quaternion{
+      out.pose.orientation.x, out.pose.orientation.y, out.pose.orientation.z,
+      out.pose.orientation.w};
+    return result;
+  } catch (const tf2::TransformException &) {
+    return std::nullopt;
+  }
+}
+
+BackendResult MoveGroupBackend::plan(const BackendRequest & request)
+{
+  BackendResult result;
+  const auto start = impl_->state_from(request.start);
+  if (!start) {
+    result.reason = "INVALID_START";
+    result.message = "start state has unknown joints or non-finite values";
+    return result;
+  }
+  auto goal = transform_to_planning_frame(request.ee_goal);
+  if (!goal) {
+    result.reason = "TF_UNAVAILABLE";
+    result.message = "cannot transform goal from '" + request.ee_goal.frame_id + "'";
+    return result;
+  }
+
+  auto & mg = *impl_->move_group;
+  mg.setStartState(*start);
+  mg.setMaxVelocityScalingFactor(request.velocity_scaling);
+  mg.setMaxAccelerationScalingFactor(request.acceleration_scaling);
+  mg.setPlanningTime(request.planning_time_s);
+
+  // 控制器限位比 URDF 窄的关节：以路径约束下发（起点与目标也必须满足）。
+  moveit_msgs::msg::Constraints path_constraints;
+  path_constraints.name = "mtc_controller_joint_limits";
+  for (const auto & bound : request.joint_bounds) {
+    const auto * joint = impl_->model->getJointModel(bound.first);
+    if (joint == nullptr || joint->getVariableCount() != 1) {
+      continue;
+    }
+    const auto & urdf = joint->getVariableBounds()[0];
+    if (urdf.position_bounded_ && bound.second.first <= urdf.min_position_ &&
+      bound.second.second >= urdf.max_position_)
+    {
+      continue;  // 不比 URDF 更窄，无需约束
+    }
+    moveit_msgs::msg::JointConstraint jc;
+    jc.joint_name = bound.first;
+    jc.position = 0.5 * (bound.second.first + bound.second.second);
+    jc.tolerance_above = bound.second.second - jc.position;
+    jc.tolerance_below = jc.position - bound.second.first;
+    jc.weight = 1.0;
+    path_constraints.joint_constraints.push_back(jc);
+  }
+  if (!path_constraints.joint_constraints.empty()) {
+    mg.setPathConstraints(path_constraints);
+  } else {
+    mg.clearPathConstraints();
+  }
+
+  geometry_msgs::msg::PoseStamped goal_msg;
+  goal_msg.header.frame_id = impl_->planning_frame;
+  goal_msg.pose = to_msg(*goal);
+
+  moveit_msgs::msg::RobotTrajectory trajectory_msg;
+  const auto t0 = std::chrono::steady_clock::now();
+  bool planned = false;
+  if (request.mode == MotionMode::FREE_SPACE && request.prefer_straight_line) {
+    // 先试末端直线：只有完整（fraction=1）、无碰撞、满足关节约束时才采用。
+    const std::vector<geometry_msgs::msg::Pose> waypoints{goal_msg.pose};
+    moveit_msgs::msg::RobotTrajectory straight;
+    const double fraction = mg.computeCartesianPath(
+      waypoints, request.cartesian_step_m, straight, path_constraints, request.avoid_collisions);
+    // 逐点 IK 可能在相邻路点间翻转构型：任一关节单步 > 0.2 rad（步长 5 mm 时不应出现）即放弃直线。
+    double max_step = 0.0;
+    const auto & pts = straight.joint_trajectory.points;
+    for (size_t i = 1; i < pts.size(); ++i) {
+      for (size_t j = 0; j < pts[i].positions.size() && j < pts[i - 1].positions.size(); ++j) {
+        max_step = std::max(max_step, std::fabs(pts[i].positions[j] - pts[i - 1].positions[j]));
+      }
+    }
+    if (fraction >= 1.0 - 1e-9 && max_step <= 0.2) {
+      trajectory_msg = straight;
+      result.cartesian_fraction = fraction;
+      result.method = "cartesian_preferred";
+      planned = true;
+    } else {
+      result.message = "straight line rejected (fraction=" + std::to_string(fraction) +
+        ", max_joint_step=" + std::to_string(max_step) + " rad); ";
+    }
+    mg.setStartState(*start);
+  }
+  if (planned) {
+    mg.clearPathConstraints();
+    result.planning_time_s =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+  } else if (request.mode == MotionMode::FREE_SPACE) {
+    result.method = "ompl";
+    mg.clearPoseTargets();
+    mg.setPoseTarget(goal_msg, impl_->options.end_effector_link);
+    moveit::planning_interface::MoveGroupInterface::Plan plan;
+    const auto code = mg.plan(plan);
+    mg.clearPoseTargets();
+    mg.clearPathConstraints();
+    result.planning_time_s =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    if (code != moveit::core::MoveItErrorCode::SUCCESS) {
+      result.reason = "NO_PLAN";
+      result.message += "MoveIt plan() returned " + moveit::core::errorCodeToString(code);
+      return result;
+    }
+    trajectory_msg = plan.trajectory;
+  } else {
+    result.method = "cartesian";
+    const std::vector<geometry_msgs::msg::Pose> waypoints{goal_msg.pose};
+    const double fraction = mg.computeCartesianPath(
+      waypoints, request.cartesian_step_m, trajectory_msg, path_constraints,
+      request.avoid_collisions);
+    mg.clearPathConstraints();
+    result.planning_time_s =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    result.cartesian_fraction = fraction;
+    if (!(fraction >= request.min_cartesian_fraction - 1e-9)) {
+      result.reason = "CARTESIAN_INCOMPLETE";
+      result.message = "computeCartesianPath achieved fraction " + std::to_string(fraction) +
+        " < required " + std::to_string(request.min_cartesian_fraction);
+      return result;
+    }
+  }
+
+  robot_trajectory::RobotTrajectory trajectory(impl_->model, impl_->options.planning_group);
+  trajectory.setRobotTrajectoryMsg(*start, trajectory_msg);
+  if (trajectory.getWayPointCount() < 2) {
+    result.reason = "DEGENERATE_TRAJECTORY";
+    result.message = "planner returned fewer than 2 waypoints";
+    return result;
+  }
+  trajectory_processing::TimeOptimalTrajectoryGeneration totg;
+  if (!totg.computeTimeStamps(trajectory, request.velocity_scaling, request.acceleration_scaling)) {
+    result.reason = "TIME_PARAMETERIZATION_FAILED";
+    result.message = "TOTG could not time-parameterize the path";
+    return result;
+  }
+
+  // 末端线速度 / 角速度：按固定间隔采样整条轨迹（含路点之间的插值）。
+  const double duration = trajectory.getDuration();
+  const double dt = std::max(1e-3, impl_->options.speed_sample_dt_s);
+  auto sample = std::make_shared<moveit::core::RobotState>(*start);
+  double max_linear = 0.0;
+  double max_angular = 0.0;
+  std::optional<mtc::core::Pose6D> previous;
+  for (double t = 0.0; ; t = std::min(duration, t + dt)) {
+    trajectory.getStateAtDurationFromStart(t, sample);
+    sample->update();
+    const auto pose = to_pose6d(
+      sample->getGlobalLinkTransform(impl_->options.end_effector_link), impl_->planning_frame);
+    if (previous) {
+      max_linear = std::max(max_linear, distance_between(pose.position, previous->position) / dt);
+      max_angular = std::max(
+        max_angular, angle_between(pose.orientation, previous->orientation) / dt);
+    }
+    previous = pose;
+    if (t >= duration) {
+      break;
+    }
+  }
+  double factor = 1.0;
+  if (request.max_linear_speed_m_s > 0.0) {
+    factor = std::max(factor, max_linear / request.max_linear_speed_m_s);
+  }
+  if (request.max_angular_speed_rad_s > 0.0) {
+    factor = std::max(factor, max_angular / request.max_angular_speed_rad_s);
+  }
+  if (factor > 1.0) {
+    factor *= 1.02;  // 采样误差余量
+  }
+  result.time_scale_applied = factor;
+  result.max_linear_speed_m_s = max_linear / factor;
+  result.max_angular_speed_rad_s = max_angular / factor;
+
+  moveit_msgs::msg::RobotTrajectory out;
+  trajectory.getRobotTrajectoryMsg(out);
+  const auto & jt = out.joint_trajectory;
+  result.trajectory.joint_names = jt.joint_names;
+  for (const auto & point : jt.points) {
+    RawTrajectoryPoint raw;
+    raw.time_from_start_s = rclcpp::Duration(point.time_from_start).seconds() * factor;
+    raw.positions = point.positions;
+    raw.velocities = point.velocities;
+    raw.accelerations = point.accelerations;
+    for (auto & v : raw.velocities) {
+      v /= factor;
+    }
+    for (auto & a : raw.accelerations) {
+      a /= factor * factor;
+    }
+    result.trajectory.points.push_back(std::move(raw));
+  }
+  result.end_state = impl_->snapshot_from(trajectory.getLastWayPoint());
+  result.ok = true;
+  result.message += "ok";
+  return result;
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/src/moveit_planner_port.cpp b/src/mtc_moveit_planner/src/moveit_planner_port.cpp
new file mode 100644
index 0000000..0e476c1
--- /dev/null
+++ b/src/mtc_moveit_planner/src/moveit_planner_port.cpp
@@ -0,0 +1,463 @@
+// Copyright 2026 meituan_challenge_ws contributors
+
+#include "mtc_moveit_planner/moveit_planner_port.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <iomanip>
+#include <sstream>
+#include <utility>
+
+#include "mtc_core_cpp/error_codes.hpp"
+#include "mtc_moveit_planner/pose_math.hpp"
+#include "mtc_moveit_planner/trajectory_conversion.hpp"
+
+namespace mtc
+{
+namespace moveit_planner
+{
+
+namespace
+{
+
+using mtc::core::ErrorCodes;
+using mtc::core::PlanResult;
+using mtc::core::Pose6D;
+
+constexpr double kStartToleranceRad = 1e-3;
+
+std::string fmt(double value)
+{
+  std::ostringstream os;
+  os << std::setprecision(6) << value;
+  return os.str();
+}
+
+bool scaling_ok(double value, double cap)
+{
+  return std::isfinite(value) && value > 0.0 && value <= cap;
+}
+
+/// 轨迹首点与期望起点（按名称）是否一致。
+bool starts_at(const mtc::core::TimedTrajectory & trajectory, const JointStateSnapshot & start)
+{
+  if (trajectory.points.empty()) {
+    return false;
+  }
+  const auto & first = trajectory.points.front().positions_rad;
+  for (size_t i = 0; i < trajectory.joint_names.size(); ++i) {
+    const auto it = std::find(start.names.begin(), start.names.end(), trajectory.joint_names[i]);
+    if (it == start.names.end()) {
+      return false;
+    }
+    const double expected = start.positions[static_cast<size_t>(it - start.names.begin())];
+    if (std::fabs(first[i] - expected) > kStartToleranceRad) {
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+MoveItPlannerPort::MoveItPlannerPort(
+  PlanningBackendPtr backend,
+  PlannerConfig config,
+  mtc::core::ClockPtr clock,
+  bool asynchronous)
+: backend_(std::move(backend)),
+  config_(std::move(config)),
+  clock_(std::move(clock)),
+  asynchronous_(asynchronous)
+{
+}
+
+MoveItPlannerPort::~MoveItPlannerPort()
+{
+  std::map<std::string, std::future<PlanResult>> pending;
+  {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pending.swap(jobs_);
+  }
+  for (auto & entry : pending) {
+    if (entry.second.valid()) {
+      entry.second.wait();
+    }
+  }
+}
+
+std::string MoveItPlannerPort::make_key(const mtc::manipulation::PlanTarget & target)
+{
+  std::ostringstream os;
+  os << std::setprecision(17);
+  os << target.phase << '|' << target.object_id << '|' << target.slot << '|';
+  for (const auto & primitive : target.primitives) {
+    os << primitive.name << ',';
+  }
+  os << '|' << target.has_ring_pose;
+  if (target.has_ring_pose) {
+    const auto & p = target.ring_pose;
+    os << '|' << p.frame_id << ',' << p.stamp_s << ',' << p.position.x << ',' << p.position.y <<
+      ',' << p.position.z << ',' << p.orientation.x << ',' << p.orientation.y << ',' <<
+      p.orientation.z << ',' << p.orientation.w;
+  }
+  return os.str();
+}
+
+std::optional<PlanResult> MoveItPlannerPort::plan(const mtc::manipulation::PlanTarget & target)
+{
+  if (!asynchronous_) {
+    return plan_blocking(target);
+  }
+  const auto key = make_key(target);
+  std::lock_guard<std::mutex> lock(mutex_);
+  const auto found = jobs_.find(key);
+  if (found != jobs_.end()) {
+    if (found->second.wait_for(std::chrono::seconds(0)) != std::future_status::ready) {
+      return std::nullopt;
+    }
+    PlanResult result = found->second.get();
+    jobs_.erase(found);
+    return result;
+  }
+  jobs_.emplace(key, std::async(std::launch::async, [this, target]() {
+      return plan_blocking(target);
+    }));
+  return std::nullopt;
+}
+
+PlanReport MoveItPlannerPort::last_report() const
+{
+  std::lock_guard<std::mutex> lock(mutex_);
+  return last_report_;
+}
+
+PlanResult MoveItPlannerPort::plan_blocking(
+  const mtc::manipulation::PlanTarget & target,
+  const std::optional<JointStateSnapshot> & start_override)
+{
+  std::lock_guard<std::mutex> backend_lock(backend_mutex_);
+
+  PlanReport report;
+  report.phase = target.phase;
+
+  auto finish = [this, &report](PlanResult result) {
+      std::lock_guard<std::mutex> lock(mutex_);
+      last_report_ = report;
+      return result;
+    };
+  auto fail = [&](const std::string & reason, const std::string & primitive,
+      const std::string & detail) {
+      PlanResult failed;
+      failed.ok = false;
+      failed.error_code = ErrorCodes::PLANNING_FAILED;
+      failed.primitives = target.primitives;
+      failed.message = "[" + reason + "] " + (primitive.empty() ? "plan" : primitive) + ": " +
+        detail;
+      report.simulation_only = true;
+      return finish(failed);
+    };
+
+  if (!backend_) {
+    return fail("NO_BACKEND", "", "planning backend is not configured");
+  }
+  report.planning_frame = backend_->planning_frame();
+  report.end_effector_link = backend_->end_effector_link();
+  if (target.primitives.empty()) {
+    return fail("EMPTY_TARGET", "", "PlanTarget has no primitives");
+  }
+  if (!scaling_ok(config_.velocity_scaling, config_.scaling_cap) ||
+    !scaling_ok(config_.acceleration_scaling, config_.scaling_cap) ||
+    config_.joint_names.empty() || !(config_.timeout_factor >= 1.0) ||
+    report.planning_frame.empty())
+  {
+    return fail("INVALID_CONFIG", "",
+             "scaling must be in (0, " + fmt(config_.scaling_cap) +
+             "], timeout_factor >= 1, joint names and planning frame non-empty");
+  }
+
+  std::optional<JointStateSnapshot> start = start_override;
+  if (!start) {
+    start = backend_->current_state();
+  }
+  if (!start || !start->shape_is_valid()) {
+    return fail("NO_CURRENT_STATE", "", "robot state unavailable (is /joint_states published?)");
+  }
+  report.start_state = *start;
+  JointStateSnapshot chain = *start;
+  std::string start_assumption = start_override ? "explicit_start_state" : "current_state";
+
+  std::vector<std::string> uncalibrated;
+  auto accept_calibration = [&](const std::string & item, CalibrationStatus status) {
+      if (status == CalibrationStatus::MEASURED) {
+        return true;
+      }
+      if (status == CalibrationStatus::UNKNOWN || !config_.allow_uncalibrated_geometry) {
+        return false;
+      }
+      const std::string entry = item + "=" + to_string(status);
+      if (std::find(uncalibrated.begin(), uncalibrated.end(), entry) == uncalibrated.end()) {
+        uncalibrated.push_back(entry);
+      }
+      return true;
+    };
+
+  const Transform tcp_to_ee = inverse(config_.ee_to_tcp);
+  double stamp = clock_ ? clock_->now() : 0.0;
+  if (!std::isfinite(stamp) || stamp < 0.0) {
+    stamp = 0.0;
+  }
+
+  std::vector<mtc::core::MotionCommand> commands;
+  for (const auto & primitive : target.primitives) {
+    PrimitivePlanReport entry;
+    entry.primitive_name = primitive.name;
+    entry.start_assumption = start_assumption;
+    auto fail_primitive = [&](const std::string & reason, const std::string & detail) {
+        entry.ok = false;
+        entry.reason = reason;
+        entry.message = detail;
+        report.primitives.push_back(entry);
+        return fail(reason, primitive.name, detail);
+      };
+
+    if (config_.tool_owned_primitives.count(primitive.name) != 0u) {
+      return fail_primitive("TOOL_OWNED_PRIMITIVE",
+               "executed by ToolPort; the planner must not emit a trajectory for it");
+    }
+    const auto spec_it = config_.primitives.find(primitive.name);
+    if (spec_it == config_.primitives.end()) {
+      return fail_primitive("UNKNOWN_PRIMITIVE", "no planning rule for this primitive");
+    }
+    const PrimitiveSpec & spec = spec_it->second;
+    entry.mode = to_string(spec.mode);
+    entry.goal_kind = to_string(spec.goal);
+    entry.contact_intent_only = spec.contact_intent_only;
+    if (!primitive.is_usable()) {
+      return fail_primitive("INVALID_PRIMITIVE",
+               "empty name, non-positive speed limit or unusable target_pose");
+    }
+
+    auto make_request = [&](const std::string & label, MotionMode mode, const Pose6D & goal) {
+        BackendRequest request;
+        request.label = label;
+        request.mode = mode;
+        request.ee_goal = goal;
+        request.start = chain;
+        request.velocity_scaling = config_.velocity_scaling;
+        request.acceleration_scaling = config_.acceleration_scaling;
+        request.max_linear_speed_m_s = primitive.max_linear_speed;
+        request.max_angular_speed_rad_s = primitive.max_angular_speed;
+        request.planning_time_s = config_.planning_time_s;
+        request.cartesian_step_m = config_.cartesian_step_m;
+        request.min_cartesian_fraction = config_.min_cartesian_fraction;
+        request.joint_bounds = config_.joint_position_limits;
+        request.prefer_straight_line =
+          mode == MotionMode::FREE_SPACE && config_.prefer_straight_line_free_space;
+        return request;
+      };
+
+    // ---- 原语前的 ToolPort 动作：只假设其终点，不输出轨迹 ----
+    if (spec.gap_before != ToolGapBefore::NONE) {
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose for tool gap");
+      }
+      const double sign = spec.gap_before == ToolGapBefore::ENGAGE_INSERT ? 1.0 : -1.0;
+      const auto tcp_gap = offset_along_local_axis(
+        apply(*ee_now, config_.ee_to_tcp), config_.insertion_axis, sign * spec.gap_distance_m);
+      const auto gap = backend_->plan(make_request(
+          std::string("simulated_") + to_string(spec.gap_before), MotionMode::CARTESIAN,
+          apply(tcp_gap, tcp_to_ee)));
+      if (!gap.ok || !gap.end_state.shape_is_valid()) {
+        return fail_primitive("TOOL_GAP_SIMULATION_FAILED", gap.reason + ": " + gap.message);
+      }
+      chain = gap.end_state;
+      entry.start_assumption = std::string("simulated ") + to_string(spec.gap_before) + " " +
+        fmt(spec.gap_distance_m) + " m along TCP axis " + std::to_string(config_.insertion_axis) +
+        " (ToolPort motion, not emitted)";
+    }
+
+    // ---- 目标位姿（planning frame 中的 ee_link）----
+    Pose6D ee_goal;
+    if (spec.goal == GoalKind::RING_STANDOFF) {
+      std::optional<Pose6D> ring;
+      if (primitive.target_pose && primitive.target_pose->is_usable()) {
+        ring = *primitive.target_pose;
+      } else if (target.has_ring_pose && target.ring_pose.is_usable()) {
+        ring = target.ring_pose;
+      }
+      if (!ring) {
+        return fail_primitive("TARGET_POSE_MISSING",
+                 "no usable ring pose (valid, frame_id, unit quaternion) in primitive or target");
+      }
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      const auto ring_in_frame = backend_->transform_to_planning_frame(*ring);
+      if (!ring_in_frame) {
+        return fail_primitive("TF_UNAVAILABLE",
+                 "cannot transform ring pose from '" + ring->frame_id + "' to '" +
+                 report.planning_frame + "'");
+      }
+      const auto tcp_goal = offset_along_local_axis(
+        *ring_in_frame, config_.insertion_axis, -spec.distance_m);
+      ee_goal = apply(tcp_goal, tcp_to_ee);
+    } else if (spec.goal == GoalKind::RELATIVE_UP) {
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose at start state");
+      }
+      ee_goal = translate_in_frame(*ee_now, mtc::core::Vector3{0.0, 0.0, spec.distance_m});
+    } else {
+      const std::string & slot_name = target.slot;
+      if (!primitive.target_label.empty() && config_.slots.count(primitive.target_label) != 0u &&
+        primitive.target_label != slot_name)
+      {
+        return fail_primitive("SLOT_MISMATCH",
+                 "primitive targets '" + primitive.target_label + "' but request slot is '" +
+                 slot_name + "'");
+      }
+      const auto slot_it = config_.slots.find(slot_name);
+      if (slot_it == config_.slots.end() ||
+        slot_it->second.status == CalibrationStatus::UNKNOWN)
+      {
+        return fail_primitive("SLOT_POSE_UNKNOWN", "no pose for slot '" + slot_name + "'");
+      }
+      if (!accept_calibration("slot " + slot_name, slot_it->second.status)) {
+        return fail_primitive("SLOT_NOT_CALIBRATED",
+                 "slot '" + slot_name + "' is " + to_string(slot_it->second.status));
+      }
+      if (!accept_calibration("TCP", config_.tcp_status)) {
+        return fail_primitive("TCP_UNKNOWN", "ee_link -> hook_tcp is not available");
+      }
+      if (!slot_it->second.pose.is_usable()) {
+        return fail_primitive("SLOT_POSE_INVALID", "slot pose has no frame or invalid quaternion");
+      }
+      const auto slot_in_frame = backend_->transform_to_planning_frame(slot_it->second.pose);
+      if (!slot_in_frame) {
+        return fail_primitive("TF_UNAVAILABLE",
+                 "cannot transform slot '" + slot_name + "' from '" +
+                 slot_it->second.pose.frame_id + "' to '" + report.planning_frame + "'");
+      }
+      const auto ee_now = backend_->end_effector_pose(chain);
+      if (!ee_now) {
+        return fail_primitive("FK_FAILED", "cannot compute end-effector pose at start state");
+      }
+      // 搬运/落座保持抓取时的工具姿态（不旋转电池），只改变位置。
+      Pose6D tcp_goal = apply(*ee_now, config_.ee_to_tcp);
+      tcp_goal.position = slot_in_frame->position;
+      tcp_goal.position.z += spec.distance_m;
+      ee_goal = apply(tcp_goal, tcp_to_ee);
+    }
+    ee_goal.valid = true;
+    entry.ee_goal = ee_goal;
+
+    // ---- 规划 ----
+    const auto planned = backend_->plan(make_request(primitive.name, spec.mode, ee_goal));
+    entry.planning_time_s = planned.planning_time_s;
+    entry.cartesian_fraction = planned.cartesian_fraction;
+    entry.time_scale_applied = planned.time_scale_applied;
+    entry.max_linear_speed_m_s = planned.max_linear_speed_m_s;
+    entry.max_angular_speed_rad_s = planned.max_angular_speed_rad_s;
+    entry.method = planned.method;
+    entry.message = planned.message;
+    if (!planned.ok) {
+      return fail_primitive(planned.reason.empty() ? "NO_PLAN" : planned.reason, planned.message);
+    }
+
+    auto converted = to_timed_trajectory(
+      planned.trajectory, config_.joint_names, report.planning_frame, stamp);
+    if (!converted.ok) {
+      return fail_primitive("INVALID_TRAJECTORY", converted.error);
+    }
+    const auto & trajectory = converted.trajectory;
+    if (!starts_at(trajectory, chain)) {
+      return fail_primitive("START_STATE_MISMATCH",
+               "trajectory does not start at the expected start state (tolerance " +
+               fmt(kStartToleranceRad) + " rad)");
+    }
+    for (size_t j = 0; j < trajectory.joint_names.size(); ++j) {
+      const auto limit = config_.joint_position_limits.find(trajectory.joint_names[j]);
+      if (limit == config_.joint_position_limits.end()) {
+        continue;
+      }
+      for (const auto & point : trajectory.points) {
+        const double value = point.positions_rad[j];
+        if (value < limit->second.first || value > limit->second.second) {
+          return fail_primitive("JOINT_LIMIT_VIOLATION",
+                   trajectory.joint_names[j] + "=" + fmt(value) + " rad outside [" +
+                   fmt(limit->second.first) + ", " + fmt(limit->second.second) + "]");
+        }
+      }
+    }
+    const double duration = trajectory.duration_s();
+    const auto watchdog_it = config_.state_timeouts.find(spec.executing_state);
+    const double watchdog = watchdog_it != config_.state_timeouts.end() ? watchdog_it->second : 0.0;
+    entry.state_watchdog_s = watchdog;
+    entry.point_count = trajectory.points.size();
+    entry.duration_s = duration;
+    if (watchdog > 0.0 && duration > watchdog * config_.state_timeout_usage) {
+      return fail_primitive("EXCEEDS_STATE_WATCHDOG",
+               "trajectory lasts " + fmt(duration) + " s, more than " +
+               fmt(config_.state_timeout_usage * 100.0) + "% of the " +
+               mtc::manipulation::to_string(spec.executing_state) + " watchdog (" +
+               fmt(watchdog) + " s)");
+    }
+    const auto timeout_ms = static_cast<uint32_t>(
+      std::ceil(duration * config_.timeout_factor * 1000.0)) + config_.timeout_margin_ms;
+    entry.timeout_ms = timeout_ms;
+
+    mtc::core::MotionCommand command;
+    command.joint_names = trajectory.joint_names;
+    command.target_rad.clear();
+    command.velocity_scaling = config_.velocity_scaling;
+    command.acceleration_scaling = config_.acceleration_scaling;
+    command.timeout_ms = timeout_ms;
+    command.primitive_name = primitive.name;
+    command.requires_contact = primitive.requires_contact;
+    command.intent = primitive;
+    command.trajectory = trajectory;
+    commands.push_back(std::move(command));
+
+    entry.ok = true;
+    report.primitives.push_back(entry);
+    chain = planned.end_state.shape_is_valid() ?
+      planned.end_state :
+      JointStateSnapshot{trajectory.joint_names, final_positions(trajectory)};
+    start_assumption = "previous_primitive_end";
+  }
+
+  const bool simulation_only = config_.force_simulation_only || !uncalibrated.empty();
+  for (auto & command : commands) {
+    command.simulation_only = simulation_only;
+  }
+  report.simulation_only = simulation_only;
+  report.uncalibrated_inputs = uncalibrated;
+
+  PlanResult result;
+  result.ok = true;
+  result.error_code = ErrorCodes::OK;
+  result.primitives = target.primitives;
+  result.commands = std::move(commands);
+  std::ostringstream message;
+  message << "planned " << result.commands.size() << " primitive(s) in frame '" <<
+    report.planning_frame << "' for '" << report.end_effector_link <<
+    "'; simulation_only=" << (simulation_only ? "true" : "false");
+  if (!uncalibrated.empty()) {
+    message << " (uncalibrated:";
+    for (const auto & item : uncalibrated) {
+      message << ' ' << item;
+    }
+    message << ')';
+  }
+  result.message = message.str();
+  return finish(result);
+}
+
+}  // namespace moveit_planner
+}  // namespace mtc
diff --git a/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp b/src/mtc_moveit_planner/src/plan_battery_sequence_main.cpp
