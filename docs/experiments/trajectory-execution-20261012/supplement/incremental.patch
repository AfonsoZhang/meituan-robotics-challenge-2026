diff --git a/src/mtc_trajectory_execution_cpp/include/mtc_trajectory_execution_cpp/fjt_motion_port.hpp b/src/mtc_trajectory_execution_cpp/include/mtc_trajectory_execution_cpp/fjt_motion_port.hpp
