+  EXPECT_EQ(r.code, rclcpp_action::ResultCode::ABORTED);
+  EXPECT_EQ(r.result->error_code, ErrorCodes::CANCEL_NOT_CONFIRMED);
+  EXPECT_EQ(r.result->completed_count, 0);
+  auto cleanup = std::make_shared<Pick::Result>();
