+  g = goal(); g.timeout_ms = 0; EXPECT_EQ(send(g), nullptr);
+  g = goal(); g.acceleration_scaling = 1; EXPECT_EQ(send(g), nullptr);
+  EXPECT_EQ(server->mock_call_counts()->executions.load(), 0u);
+}
