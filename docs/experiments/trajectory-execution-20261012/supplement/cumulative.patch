+// Copyright 2026 MTC contributors
+#pragma once
+#include <memory>
+#include <rclcpp/rclcpp.hpp>
+#include <mtc_manipulation_cpp/pick_place_types.hpp>
+#include "mtc_trajectory_execution_cpp/trajectory_validator.hpp"
