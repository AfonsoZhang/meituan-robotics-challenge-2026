+    masks={}
+    for item,payload in zip(result['objects'],views):
+        name='mask_'+item['object_id']+'.png'
+        _png(folder/name,np.uint8(payload['mask'])*255,timing_ms);masks[item['object_id']]=name
+    raw_available=frame.raw_depth is not None
