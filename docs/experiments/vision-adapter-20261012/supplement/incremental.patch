index 0000000..497c2a9
--- /dev/null
+++ b/vision_core/real_data/red_selection.py
@@ -0,0 +1,123 @@
+"""Integrity audit and diverse, time-stratified selection of real red captures."""
+from pathlib import Path
+import hashlib
+import json
+import cv2
+import numpy as np
+import yaml
+from synthetic.io import write_png
+from .dataset import load_raw
+
+
+def inspect_session(session, color_config=None):
+    session = Path(session)
+    color_config = color_config or Path(__file__).resolve().parents[1]/'config'/'realsense_color.yaml'
+    red_ranges = yaml.safe_load(Path(color_config).read_text(encoding='utf-8'))['hsv_ranges']['red']
+    info = json.loads((session/'session.json').read_text(encoding='utf-8'))
+    records, problems = [], []
+    seen = set()
+    for folder in sorted((session/'samples').iterdir()):
+        if not folder.is_dir():
+            continue
+        try:
+            raw_path, metadata_path = folder/'raw.png', folder/'metadata.json'
+            if not raw_path.is_file() or not metadata_path.is_file():
+                raise ValueError('raw.png or metadata.json missing')
+            metadata = json.loads(metadata_path.read_text(encoding='utf-8'))
+            image = load_raw(folder)
+            if metadata['sample_id'] != folder.name or metadata['session_id'] != info['session_id']:
+                raise ValueError('sample/session ID mismatch')
+            if folder.name in seen:
+                raise ValueError('duplicate sample ID')
+            seen.add(folder.name)
+            if metadata['capture_label'] != 'red' or metadata['pixel_format'] != 'BGR8':
+                raise ValueError('capture label or pixel format mismatch')
+            if [image.shape[1], image.shape[0]] != [metadata['image_width'], metadata['image_height']]:
+                raise ValueError('dimensions differ from metadata')
+            if not (folder/'overlay.png').is_file():
+                problems.append({'sample_id': folder.name, 'problem': 'overlay.png missing'})
+            hsv = cv2.cvtColor(image, cv2.COLOR_BGR2HSV)
+            red = np.zeros(hsv.shape[:2], np.uint8)
+            for h0,s0,v0,h1,s1,v1 in red_ranges:
+                red |= cv2.inRange(hsv, (h0,s0,v0), (h1,s1,v1))
+            n, labels, stats, centers = cv2.connectedComponentsWithStats(red)
+            if n > 1:
+                largest = 1 + int(np.argmax(stats[1:, cv2.CC_STAT_AREA]))
+                x,y,w,h,area = stats[largest]
+                u,v = centers[largest]
+            else:
+                x=y=w=h=area=u=v=0
+            thumb = cv2.resize(image, (12, 8), interpolation=cv2.INTER_AREA).astype(float).ravel()/255
+            feature = np.concatenate((thumb,
+                [u/image.shape[1], v/image.shape[0], w/image.shape[1], h/image.shape[0],
+                 area/(image.shape[0]*image.shape[1]),
+                 metadata['image_quality']['metrics']['value_mean']/255,
+                 min(metadata['image_quality']['metrics']['laplacian_variance']/200, 2)]))
+            records.append({'sample_id': folder.name, 'sample_path': str(folder.resolve()),
+                            'frame_number': metadata['frame_number'],
+                            'quality_status': metadata['image_quality']['status'],
+                            'sha256_raw': hashlib.sha256(raw_path.read_bytes()).hexdigest(),
+                            'rough_red_bbox_px': [int(x),int(y),int(w),int(h)],
+                            '_feature': feature, '_image': image})
+        except (ValueError, KeyError, OSError, cv2.error, json.JSONDecodeError) as exc:
+            problems.append({'sample_id': folder.name, 'problem': str(exc)})
+    return info, records, problems
+
+
+def select_representatives(records, count=28):
+    if count < 25 or count > 30:
+        raise ValueError('Representative count must be 25..30')
+    accepted = sorted((r for r in records if r['quality_status'] == 'ACCEPTED'),
+                      key=lambda r: r['frame_number'])
+    if len(accepted) < count:
+        raise ValueError(f'Only {len(accepted)} ACCEPTED frames; need {count}')
+    features = np.vstack([r['_feature'] for r in accepted])
+    scale = np.maximum(features.std(axis=0), .08)
+    normalized = (features-features.mean(axis=0))/scale
+    # Seven temporal bins with farthest-point picks within each bin. Consecutive files
+    # cannot dominate merely because an r burst produced many near-duplicate frames.
+    bins = np.array_split(np.arange(len(accepted)), 7)
+    quotas = [count//7 + (i < count % 7) for i in range(7)]
+    chosen = []
+    for indices, quota in zip(bins, quotas):
+        pool = list(map(int, indices))
+        for _ in range(quota):
+            if not chosen:
+                pick = pool[len(pool)//2]
+            else:
+                distances = [min(float(np.linalg.norm(normalized[i]-normalized[j])) for j in chosen)
+                             for i in pool]
+                pick = pool[int(np.argmax(distances))]
+            chosen.append(pick)
+            pool.remove(pick)
+    return sorted((accepted[i] for i in chosen), key=lambda r: r['frame_number'])
+
+
+def prepare(session, output_dir, count=28):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    info, records, problems = inspect_session(session)
+    selected = select_representatives(records, count)
+    def public(record):
+        return {k:v for k,v in record.items() if not k.startswith('_')}
+    manifest = {'session_id': info['session_id'], 'split': info['split'],
+                'total_samples': len(list((Path(session)/'samples').iterdir())),
+                'verified_samples': len(records), 'problems': problems,
+                'quality_counts': {level: sum(r['quality_status'] == level for r in records)
+                                   for level in ('ACCEPTED','WARNING','REJECTED')},
+                'selection_method': '7 time strata; farthest image appearance, red candidate size/location, brightness and sharpness within each stratum',
+                'selected': [public(r) for r in selected],
+                'warning_samples': [public(r) for r in records if r['quality_status'] == 'WARNING']}
+    (output_dir/'selection.json').write_text(json.dumps(manifest, indent=2), encoding='utf-8')
+    tiles=[]
+    for index, record in enumerate(selected, 1):
+        tile=cv2.resize(record['_image'], (320,180))
+        panel=np.full((205,320,3),20,np.uint8); panel[:180]=tile
+        cv2.putText(panel,f'{index:02d} frame {record["frame_number"]}',(7,198),
+                    cv2.FONT_HERSHEY_SIMPLEX,.5,(255,255,255),1,cv2.LINE_AA)
+        tiles.append(panel)
+    while len(tiles)%4:
+        tiles.append(np.full_like(tiles[0],20))
+    write_png(output_dir/'selected_contact_sheet.png',
+              np.vstack([np.hstack(tiles[i:i+4]) for i in range(0,len(tiles),4)]))
+    return manifest
diff --git a/vision_core/real_data/replay.py b/vision_core/real_data/replay.py
new file mode 100644
index 0000000..32f85fa
--- /dev/null
+++ b/vision_core/real_data/replay.py
@@ -0,0 +1,203 @@
+"""Independent session-level replay with one-to-one mask IoU assignment."""
+from pathlib import Path
+import json
+import shutil
+import cv2
+import numpy as np
+from perception.battery_only import PixelBatteryDetector
+from synthetic.io import write_png
+from .annotation import read_annotation, read_mask
+from .dataset import iter_samples, iter_sessions, load_raw
+
+COLORS = ('red', 'yellow', 'blue', 'green')
+
+
+def contour_mask(shape, contour):
+    mask = np.zeros(shape[:2], np.uint8)
+    cv2.drawContours(mask, [contour], -1, 1, -1)
+    return mask.astype(bool)
+
+
+def mask_iou(a, b):
+    union = np.logical_or(a, b).sum()
+    return float(np.logical_and(a, b).sum()/union) if union else 0.0
+
+
+def yaw_error_180(predicted, measured):
+    return abs((float(predicted)-float(measured)+90) % 180-90)
+
+
+def mask_center(mask):
+    ys, xs = np.nonzero(mask)
+    if len(xs) == 0:
+        raise ValueError('Ground-truth object mask is empty')
+    return float(xs.mean()), float(ys.mean())
+
+
+def match_one_to_one(ground_truth_masks, predictions, shape, threshold=0.3):
+    """Global greedy assignment by descending IoU, independent of predicted color."""
+    predicted_masks = [contour_mask(shape, item.contour) for item in predictions]
+    pairs = [(mask_iou(gt, pred), gi, pi)
+             for gi, gt in enumerate(ground_truth_masks)
+             for pi, pred in enumerate(predicted_masks)]
+    matched, used_gt, used_pred = [], set(), set()
+    for iou, gi, pi in sorted(pairs, reverse=True):
+        if iou < threshold:
+            break
+        if gi not in used_gt and pi not in used_pred:
+            matched.append((gi, pi, iou))
+            used_gt.add(gi); used_pred.add(pi)
+    return matched, set(range(len(ground_truth_masks)))-used_gt, set(range(len(predictions)))-used_pred
+
+
+def overlays(image, objects, masks, predictions):
+    gt_image, pred_image = image.copy(), image.copy()
+    for item, mask in zip(objects, masks):
+        contours, _ = cv2.findContours(mask.astype(np.uint8), cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)
+        cv2.drawContours(gt_image, contours, -1, (0, 255, 255), 2)
+        if contours:
+            x, y, _, _ = cv2.boundingRect(max(contours, key=cv2.contourArea))
+            cv2.putText(gt_image, item['color'], (x, max(y-8, 20)), cv2.FONT_HERSHEY_SIMPLEX, .7, (0, 0, 0), 2)
+    for item in predictions:
+        cv2.drawContours(pred_image, [item.contour], -1, (0, 0, 255), 2)
+        cv2.putText(pred_image, f'{item.color} {item.confidence:.2f}',
+                    (round(item.u), max(round(item.v)-10, 20)), cv2.FONT_HERSHEY_SIMPLEX, .6, (0, 0, 0), 2)
+    return gt_image, pred_image
+
+
+def _save_failure(root, sample, image, objects, masks, predictions, reasons, matches):
+    folder = Path(root)/sample.parent.parent.name/sample.name
+    folder.mkdir(parents=True, exist_ok=True)
+    shutil.copy2(sample/'raw.png', folder/'raw.png')
+    gt_image, pred_image = overlays(image, objects, masks, predictions)
+    write_png(folder/'ground_truth_overlay.png', gt_image)
+    write_png(folder/'prediction_overlay.png', pred_image)
+    (folder/'metadata.json').write_text(json.dumps({
+        'sample_id': sample.name, 'failure_reasons': sorted(set(reasons)),
+        'matches': [{'ground_truth_index': g, 'prediction_index': p, 'iou': iou} for g,p,iou in matches],
+        'predictions': [{'color': d.color, 'u': d.u, 'v': d.v, 'yaw_deg': d.yaw_deg,
+                         'confidence': d.confidence} for d in predictions]}, indent=2), encoding='utf-8')
+    return pred_image
+
+
+def _contact_sheet(images, path):
+    if not images:
+        return
+    thumbs = []
+    for image in images:
+        scale = min(320/image.shape[1], 240/image.shape[0])
+        thumb = cv2.resize(image, (round(image.shape[1]*scale), round(image.shape[0]*scale)))
+        tile = np.full((250, 330, 3), 240, np.uint8)
+        tile[:thumb.shape[0], :thumb.shape[1]] = thumb
+        thumbs.append(tile)
+    rows = []
+    for index in range(0, len(thumbs), 3):
+        row = thumbs[index:index+3]
+        while len(row) < 3:
+            row.append(np.full_like(thumbs[0], 240))
+        rows.append(np.hstack(row))
+    write_png(path, np.vstack(rows))
+
+
+def run_replay(data_root, output_dir, color_config, *, iou_threshold=.3, low_confidence=.5,
+               min_validation_sessions=2, min_annotated_objects=20):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    config = Path(color_config)
+    import yaml
+    provenance = yaml.safe_load(config.read_text(encoding='utf-8')).get('provenance', {})
+    calibration_ids = {info['session_id'] for _, info in iter_sessions(data_root, 'calibration')}
+    source_ids = set(provenance.get('session_ids', []))
+    validation_ids = {info['session_id'] for _, info in iter_sessions(data_root, 'validation')}
+    if calibration_ids & validation_ids or source_ids & validation_ids:
+        raise ValueError('Calibration and validation session overlap')
+    if source_ids and not source_ids <= calibration_ids:
+        raise ValueError('Suggested config source sessions are not assigned to calibration')
+    detector = PixelBatteryDetector(config)
+    counts = {c: {'tp': 0, 'fp': 0, 'fn': 0, 'confidences': []} for c in COLORS}
+    geometry = {c: {'iou': [], 'center_error_px': [], 'yaw_error_deg': []} for c in COLORS}
+    confusion = {actual: {predicted: 0 for predicted in (*COLORS, 'missed')} for actual in COLORS}
+    confusion['background'] = {predicted: 0 for predicted in (*COLORS, 'missed')}
+    reviewed_images = positive_objects = 0
+    failures = []
+    contact_images = []
+    for sample, session in iter_samples(data_root, 'validation'):
+        annotation = read_annotation(sample)
+        if annotation is None:
+            continue
+        image = load_raw(sample)
+        objects = annotation['objects']
+        masks = [read_mask(sample, item) for item in objects]
+        predictions = detector.detect(image)
+        matches, unmatched_gt, unmatched_pred = match_one_to_one(masks, predictions, image.shape, iou_threshold)
+        reviewed_images += 1
+        positive_objects += len(objects)
+        reasons = []
+        for gi, pi, _iou in matches:
+            true, predicted = objects[gi]['color'], predictions[pi].color
+            confusion[true][predicted] += 1
+            cx, cy = mask_center(masks[gi])
+            geometry[true]['iou'].append(float(_iou))
+            geometry[true]['center_error_px'].append(float(np.hypot(predictions[pi].u-cx,
+                                                                  predictions[pi].v-cy)))
+            if objects[gi].get('yaw_gt_deg') is not None:
+                yaw_error=yaw_error_180(predictions[pi].yaw_deg,objects[gi]['yaw_gt_deg'])
+                geometry[true]['yaw_error_deg'].append(yaw_error)
+                if yaw_error > 15:
+                    reasons.append('yaw_failure')
+            if true == predicted:
+                counts[true]['tp'] += 1
+            else:
+                counts[true]['fn'] += 1
+                counts[predicted]['fp'] += 1
+                reasons.append('wrong_color')
+        for gi in unmatched_gt:
+            color = objects[gi]['color']
+            counts[color]['fn'] += 1
+            confusion[color]['missed'] += 1
+            reasons.extend(('false_negative','missed_detection'))
+        for pi in unmatched_pred:
+            color = predictions[pi].color
+            counts[color]['fp'] += 1
+            confusion['background'][color] += 1
+            reasons.append('false_positive')
+            if any(np.logical_and(contour_mask(image.shape,predictions[pi].contour),mask).any()
+                   for mask in masks):
+                reasons.append('bad_contour')
+        for item in predictions:
+            counts[item.color]['confidences'].append(item.confidence)
+            if item.confidence < low_confidence:
+                reasons.append('low_confidence')
+        if reasons:
+            contact_images.append(_save_failure(output_dir/'failures', sample, image, objects,
+                                                masks, predictions, reasons, matches))
+            failures.append({'sample_id': sample.name, 'session_id': session['session_id'],
+                             'reasons': sorted(set(reasons))})
+    sufficient = (calibration_ids and len(validation_ids) >= min_validation_sessions and
+                  positive_objects >= min_annotated_objects)
+    status = 'VALIDATION RUN' if sufficient else 'INSUFFICIENT DATA'
+    metrics = {}
+    for color, count in counts.items():
+        tp, fp, fn = count['tp'], count['fp'], count['fn']
+        g=geometry[color]
+        def distribution(values):
+            return {'mean':float(np.mean(values)),'p95':float(np.percentile(values,95))} if values else None
+        metrics[color] = {**count,
+                          'precision': tp/(tp+fp) if status == 'VALIDATION RUN' and tp+fp else None,
+                          'recall': tp/(tp+fn) if status == 'VALIDATION RUN' and tp+fn else None,
+                          'iou':distribution(g['iou']) if status == 'VALIDATION RUN' else None,
+                          'center_error_px':distribution(g['center_error_px']) if status == 'VALIDATION RUN' else None,
+                          'yaw_error_deg':distribution(g['yaw_error_deg']) if status == 'VALIDATION RUN' else None}
+    report = {'status': status, 'calibration_sessions': sorted(calibration_ids),
+              'validation_sessions': sorted(validation_ids), 'reviewed_images': reviewed_images,
+              'annotated_objects': positive_objects, 'iou_threshold': iou_threshold,
+              'sufficiency_rule': {'min_validation_sessions': min_validation_sessions,
+                                   'min_annotated_objects': min_annotated_objects},
+              'matching': 'one-to-one global greedy descending mask IoU, irrespective of color',
+              'metrics': metrics, 'confusion_matrix': confusion, 'false_positive_count': sum(v['fp'] for v in counts.values()),
+              'failures': failures,
+              'yaw_accuracy': 'MEASURED' if status=='VALIDATION RUN' and any(
+                  geometry[c]['yaw_error_deg'] for c in COLORS) else 'NOT MEASURED: no reliable yaw ground truth'}
+    (output_dir/'replay_report.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+    _contact_sheet(contact_images, output_dir/'failure_contact_sheet.png')
+    return report
diff --git a/vision_core/real_data/rgbd_recording.py b/vision_core/real_data/rgbd_recording.py
new file mode 100644
index 0000000..ca2e0cc
--- /dev/null
+++ b/vision_core/real_data/rgbd_recording.py
@@ -0,0 +1,135 @@
+"""Lossless, one-sample-per-directory RGB-D recording and replay."""
+from dataclasses import asdict
+from pathlib import Path
+import json,hashlib
+from time import perf_counter
+import cv2
+import numpy as np
+from perception.rgbd_geometry import CameraIntrinsics, validate_frame
+from input.realsense_rgbd_source import RGBDFrame
+
+
+def _png(path, image, timing_ms=None):
+    start=perf_counter()
+    ok, data = cv2.imencode('.png', image)
+    if not ok:
+        raise IOError(f'Cannot encode {path}')
+    encoded=perf_counter()
+    data.tofile(str(path))
+    if timing_ms is not None:
+        timing_ms["png_encoding"]=timing_ms.get("png_encoding",0)+(encoded-start)*1000
+        timing_ms["file_write"]=timing_ms.get("file_write",0)+(perf_counter()-encoded)*1000
+
+
+def _read_png(path, flags):
+    image = cv2.imdecode(np.fromfile(str(path), dtype=np.uint8), flags)
+    if image is None:
+        raise IOError(f'Cannot decode {path}')
+    return image
+
+
+def save_ply(path, points_m, rgb, timing_ms=None):
+    points = np.asarray(points_m)
+    rgb = np.asarray(rgb)
+    if points.shape != (len(rgb), 3) or rgb.shape != (len(points), 3):
+        raise ValueError('PLY point and color arrays differ')
+    start=perf_counter()
+    header='ply\nformat ascii 1.0\n'+f'element vertex {len(points)}\n'
+    header+='property float x\nproperty float y\nproperty float z\n'
+    header+='property uchar red\nproperty uchar green\nproperty uchar blue\nend_header\n'
+    body=''.join(f'{p[0]:.8f} {p[1]:.8f} {p[2]:.8f} {int(c[0])} {int(c[1])} {int(c[2])}\n' for p,c in zip(points,rgb))
+    encoded=perf_counter();Path(path).write_text(header+body,encoding='ascii')
+    if timing_ms is not None:
+        timing_ms['ply_encoding']=timing_ms.get('ply_encoding',0)+(encoded-start)*1000
+        timing_ms['file_write']=timing_ms.get('file_write',0)+(perf_counter()-encoded)*1000
+
+
+def _json(path,value,timing_ms=None,strict=False):
+    start=perf_counter();encoded=json.dumps(value,indent=2,allow_nan=not strict);ready=perf_counter()
+    path.write_text(encoded,encoding='utf-8')
+    if timing_ms is not None:
+        timing_ms['json_encoding']=timing_ms.get('json_encoding',0)+(ready-start)*1000
+        timing_ms['file_write']=timing_ms.get('file_write',0)+(perf_counter()-ready)*1000
+
+
+def save_rgbd_sample(folder, frame, result, points_m, rgb, visualization, *, scene_label, timing_ms=None):
+    folder = Path(folder)
