+        for i,item in enumerate(result['objects'][:6]):
+            text(canvas,f"{i+1}. {object_label(item)} | {item['tracking_reliability']} | CAD {item['fit_status']}",22,731+i*19,COLORS[item['color_label']],.42)
+        if not result['objects']:
