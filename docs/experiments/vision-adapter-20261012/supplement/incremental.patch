+++ b/vision_core/real_data/annotation.py
@@ -0,0 +1,92 @@
+"""Reviewed object masks: rectangles, polygons, or hand-painted binary masks."""
+from datetime import datetime, timezone
+from pathlib import Path
+import json
+import uuid
+import cv2
+import numpy as np
+from synthetic.io import write_png
+from .dataset import LABELS, load_raw
+
+
+def roi_mask(shape, mode, *, vertices=None, binary_mask=None):
+    height, width = shape[:2]
+    mask = np.zeros((height, width), np.uint8)
+    if mode in ('rectangle', 'polygon'):
+        points = np.asarray(vertices, dtype=np.int32)
+        minimum = 2 if mode == 'rectangle' else 3
+        if points.ndim != 2 or points.shape[1] != 2 or len(points) < minimum:
+            raise ValueError('ROI has too few vertices')
+        if np.any(points[:, 0] < 0) or np.any(points[:, 0] >= width) or np.any(points[:, 1] < 0) or np.any(points[:, 1] >= height):
+            raise ValueError('ROI extends beyond image')
+        if mode == 'rectangle':
+            cv2.rectangle(mask, tuple(points[0]), tuple(points[1]), 255, -1)
+        else:
+            cv2.fillPoly(mask, [points], 255)
+    elif mode == 'mask':
+        if binary_mask is None or np.asarray(binary_mask).shape != (height, width):
+            raise ValueError('Binary mask size does not match image')
+        mask = (np.asarray(binary_mask) > 0).astype(np.uint8)*255
+    else:
+        raise ValueError('mode must be rectangle, polygon, or mask')
+    if cv2.countNonZero(mask) == 0:
+        raise ValueError('ROI is empty')
+    return mask
+
+
+def annotate(sample, color, mode, *, vertices=None, binary_mask=None,
+             yaw_gt_deg=None, yaw_gt_source=None):
+    if color not in LABELS[:4]:
+        raise ValueError('Object color must be red, yellow, blue, or green')
+    if yaw_gt_deg is not None:
+        if not 0 <= float(yaw_gt_deg) < 180 or not yaw_gt_source:
+            raise ValueError('Yaw ground truth needs a 0..180 degree value and measured source')
+    sample = Path(sample)
+    image = load_raw(sample)
+    mask = roi_mask(image.shape, mode, vertices=vertices, binary_mask=binary_mask)
+    path = sample/'annotation.json'
+    data = json.loads(path.read_text(encoding='utf-8')) if path.exists() else {
+        'sample_id': sample.name, 'raw_image': 'raw.png', 'reviewed': True, 'objects': []}
+    annotation_id = uuid.uuid4().hex
+    mask_name = f'mask_{annotation_id}.png'
+    write_png(sample/mask_name, mask)
+    data['objects'].append({'annotation_id': annotation_id, 'color': color, 'mode': mode,
+                            'vertices_px': np.asarray(vertices).tolist() if vertices is not None else None,
+                            'mask_path': mask_name,
+                            'yaw_gt_deg': float(yaw_gt_deg) if yaw_gt_deg is not None else None,
+                            'yaw_gt_source': yaw_gt_source,
+                            'annotated_at': datetime.now(timezone.utc).isoformat()})
+    path.write_text(json.dumps(data, indent=2), encoding='utf-8')
+    return data['objects'][-1]
+
+
+def mark_negative(sample):
+    sample = Path(sample)
+    metadata = json.loads((sample/'metadata.json').read_text(encoding='utf-8'))
+    if metadata['capture_label'] != 'negative':
+        raise ValueError('Only a negative capture can be marked as reviewed empty ground truth')
+    data = {'sample_id': sample.name, 'raw_image': 'raw.png', 'reviewed': True,
+            'objects': [], 'annotated_at': datetime.now(timezone.utc).isoformat()}
+    path = sample/'annotation.json'
+    if path.exists():
+        raise FileExistsError(path)
+    path.write_text(json.dumps(data, indent=2), encoding='utf-8')
+    return data
+
+
+def read_annotation(sample):
+    path = Path(sample)/'annotation.json'
+    if not path.exists():
+        return None
+    data = json.loads(path.read_text(encoding='utf-8'))
+    if not data.get('reviewed'):
+        return None
+    return data
+
+
+def read_mask(sample, item):
+    encoded = np.fromfile(str(Path(sample)/item['mask_path']), np.uint8)
+    mask = cv2.imdecode(encoded, cv2.IMREAD_GRAYSCALE)
+    if mask is None:
+        raise ValueError('Cannot read annotation mask')
+    return mask > 0
diff --git a/vision_core/real_data/calibration.py b/vision_core/real_data/calibration.py
new file mode 100644
index 0000000..ed6651d
--- /dev/null
+++ b/vision_core/real_data/calibration.py
@@ -0,0 +1,166 @@
+"""Session-isolated HSV summaries and provisional threshold suggestions."""
+from datetime import datetime, timezone
+from pathlib import Path
+import csv
+import json
+import cv2
+import numpy as np
+import yaml
+from .annotation import read_annotation, read_mask
+from .dataset import iter_samples, load_raw
+
+COLORS = ('red', 'yellow', 'blue', 'green')
+
+
+def hue_arc(hues, percentile=5):
+    """Small circular percentile arc on OpenCV's 180-step hue wheel."""
+    values = np.asarray(hues, dtype=float)
+    if values.size == 0:
+        raise ValueError('Empty hue sample')
+    angles = values*2*np.pi/180
+    center = (np.arctan2(np.sin(angles).mean(), np.cos(angles).mean()) * 180/(2*np.pi)) % 180
+    unwrapped = ((values-center+90) % 180)-90
+    low = int(np.floor((center+np.percentile(unwrapped, percentile)) % 180))
+    high = int(np.ceil((center+np.percentile(unwrapped, 100-percentile)) % 180)) % 180
+    if low <= high:
+        return [(low, high)]
+    return [(0, high), (low, 179)]
+
+
+def describe(values):
+    if len(values) == 0:
+        return None
+    arr = np.asarray(values)
+    return {name: float(value) for name, value in zip(
+        ('min', 'max', 'median', 'p01', 'p05', 'p10', 'p90', 'p95', 'p99'),
+        (arr.min(), arr.max(), np.median(arr), *[np.percentile(arr, q) for q in (1, 5, 10, 90, 95, 99)]))}
+
+
+def _sample_pixels(hsv, mask, cap=30000):
+    pixels = hsv[mask]
+    if len(pixels) > cap:
+        pixels = pixels[np.linspace(0, len(pixels)-1, cap, dtype=int)]
+    return pixels
+
+
+def calibration_pixels(root):
+    by_color = {color: [] for color in COLORS}
+    negatives = []
+    sessions = set()
+    counts = {color: {'objects': 0, 'images': set(), 'pixels': 0} for color in COLORS}
+    for sample, session in iter_samples(root, 'calibration'):
+        annotation = read_annotation(sample)
+        if annotation is None:
+            continue
+        metadata = json.loads((sample/'metadata.json').read_text(encoding='utf-8'))
+        if metadata['image_quality']['status'] == 'REJECTED':
+            continue
+        hsv = cv2.cvtColor(load_raw(sample), cv2.COLOR_BGR2HSV)
+        sessions.add(session['session_id'])
+        if session['capture_label'] == 'negative' and not annotation['objects']:
+            negatives.append(_sample_pixels(hsv, np.ones(hsv.shape[:2], bool)))
+        for item in annotation['objects']:
+            color = item['color']
+            pixels = _sample_pixels(hsv, read_mask(sample, item))
+            if len(pixels):
+                by_color[color].append(pixels)
+                counts[color]['objects'] += 1
+                counts[color]['images'].add(sample.name)
+                counts[color]['pixels'] += len(pixels)
+    return by_color, negatives, counts, sorted(sessions)
+
+
+def _within(hsv, ranges):
+    found = np.zeros(len(hsv), bool)
+    for h0, s0, v0, h1, s1, v1 in ranges:
+        found |= ((hsv[:, 0] >= h0) & (hsv[:, 0] <= h1) &
+                  (hsv[:, 1] >= s0) & (hsv[:, 1] <= s1) &
+                  (hsv[:, 2] >= v0) & (hsv[:, 2] <= v1))
+    return found
+
+
+def suggest_ranges(positive, other):
+    """Choose a quantile candidate by pixel F1 against other colors/background."""
+    if len(positive) == 0:
+        return None, None
+    best = None
+    for trim in (1, 5, 10):
+        arcs = hue_arc(positive[:, 0], trim)
+        s0 = int(np.floor(np.percentile(positive[:, 1], trim)))
+        v0 = int(np.floor(np.percentile(positive[:, 2], trim)))
+        ranges = [[h0, s0, v0, h1, 255, 255] for h0, h1 in arcs]
+        tp = int(_within(positive, ranges).sum())
+        fp = int(_within(other, ranges).sum()) if len(other) else 0
+        fn = len(positive)-tp
+        f1 = 2*tp/max(2*tp+fp+fn, 1)
+        candidate = (f1, -fp, ranges, {'trim_percentile': trim, 'calibration_pixel_f1': f1,
+                                       'positive_covered': tp, 'other_pixels_accepted': fp,
+                                       'other_pixel_count': len(other)})
+        if best is None or candidate[:2] > best[:2]:
+            best = candidate
+    return best[2], best[3]
+
+
+def _histogram_image(values, bins, title):
+    canvas = np.full((270, 550, 3), 255, np.uint8)
+    hist = np.bincount(values.astype(np.uint8), minlength=bins).astype(float)[:bins]
+    if hist.max() > 0:
+        hist /= hist.max()
+    for index, fraction in enumerate(hist):
+        x = 20 + round(index*510/bins)
+        cv2.line(canvas, (x, 235), (x, 235-round(fraction*195)), (90, 75, 35), 2)
+    cv2.putText(canvas, title, (20, 25), cv2.FONT_HERSHEY_SIMPLEX, .7, (0, 0, 0), 2)
+    return canvas
+
+
+def run_calibration(root, output_dir, base_config):
+    output_dir = Path(output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+    by_color, negatives, counts, sessions = calibration_pixels(root)
+    arrays = {color: np.concatenate(items) if items else np.empty((0, 3), np.uint8)
+              for color, items in by_color.items()}
+    background = np.concatenate(negatives) if negatives else np.empty((0, 3), np.uint8)
+    report = {'status': 'PROVISIONAL' if any(len(a) for a in arrays.values()) else 'INSUFFICIENT DATA',
+              'source_dataset': str(Path(root).resolve()), 'session_ids': sessions,
+              'generated_at': datetime.now(timezone.utc).isoformat(), 'colors': {}}
+    base = yaml.safe_load(Path(base_config).read_text(encoding='utf-8'))
+    suggested = dict(base)
+    suggested['hsv_ranges'] = dict(base['hsv_ranges'])
+    for color, pixels in arrays.items():
+        if len(pixels) == 0:
+            report['colors'][color] = {'status': 'NOT MEASURED', 'sample_count': 0}
+            continue
+        others = [array for name, array in arrays.items() if name != color and len(array)]
+        if len(background):
+            others.append(background)
+        other = np.concatenate(others) if others else np.empty((0, 3), np.uint8)
+        ranges, score = suggest_ranges(pixels, other)
+        suggested['hsv_ranges'][color] = ranges
+        report['colors'][color] = {'status': 'PROVISIONAL',
+                                   'sample_count': counts[color]['objects'],
+                                   'image_count': len(counts[color]['images']),
+                                   'pixel_count': counts[color]['pixels'],
+                                   'hsv': {channel: describe(pixels[:, i]) for i, channel in enumerate('hsv')},
+                                   'hue_circular_arc_p05_p95': hue_arc(pixels[:, 0], 5),
+                                   'histograms': {channel: np.bincount(pixels[:, i], minlength=bins)[:bins].tolist()
+                                                  for i, (channel, bins) in enumerate((('h', 180), ('s', 256), ('v', 256)))},
+                                   'suggested_ranges': ranges, 'calibration_pixel_screen': score}
+        for i, (channel, bins) in enumerate((('h', 180), ('s', 256), ('v', 256))):
+            from synthetic.io import write_png
+            write_png(output_dir/f'{color}_{channel}_hist.png', _histogram_image(pixels[:, i], bins, f'{color.upper()} {channel.upper()}'))
+    suggested['provenance'] = {'config_version': report['generated_at'],
+                               'status': 'provisional', 'validation_status': 'NOT RUN',
+                               'source_dataset': report['source_dataset'], 'session_ids': sessions,
+                               'sample_counts': {color: counts[color]['objects'] for color in COLORS},
+                               'method': 'circular hue percentile candidates scored against other annotated colors and reviewed negative background'}
+    (output_dir/'hsv_statistics.json').write_text(json.dumps(report, indent=2), encoding='utf-8')
+    with (output_dir/'hsv_statistics.csv').open('w', newline='', encoding='utf-8-sig') as stream:
+        writer = csv.writer(stream)
+        writer.writerow(('color', 'channel', 'min', 'max', 'median', 'p01', 'p05', 'p10', 'p90', 'p95', 'p99', 'pixel_count'))
+        for color, item in report['colors'].items():
+            if item['status'] == 'NOT MEASURED':
+                continue
+            for channel, stats in item['hsv'].items():
+                writer.writerow((color, channel, *[stats[key] for key in ('min','max','median','p01','p05','p10','p90','p95','p99')], item['pixel_count']))
+    (output_dir/'suggested_realsense_color.yaml').write_text(yaml.safe_dump(suggested, sort_keys=False, allow_unicode=True), encoding='utf-8')
+    return report
diff --git a/vision_core/real_data/continuous_rgbd.py b/vision_core/real_data/continuous_rgbd.py
new file mode 100644
index 0000000..ea66721
--- /dev/null
+++ b/vision_core/real_data/continuous_rgbd.py
@@ -0,0 +1,115 @@
+"""Bounded asynchronous lossless RGB-D writer with explicit drop/integrity logs."""
+from collections import deque
+from dataclasses import asdict
+from pathlib import Path
+from threading import Condition,Thread
+from time import monotonic,time
+import hashlib,json
+import cv2,numpy as np
+from perception.rgbd_geometry import validate_frame
+
+class ContinuousRGBDRecorder:
+    def __init__(self,folder,max_seconds=30.,max_frames=450,queue_capacity=16,writer_workers=2,png_compression=0):
+        if max_seconds<=0 or max_frames<=0 or queue_capacity<=0 or writer_workers not in (1,2,3,4) or not 0<=png_compression<=9:
+            raise ValueError('Invalid recorder bounds or PNG settings')
+        self.folder=Path(folder);self.max_seconds=max_seconds;self.max_frames=max_frames
+        self.capacity=queue_capacity;self.worker_count=writer_workers;self.png_compression=png_compression
+        self.cv=Condition();self.queue=deque();self.thread=None;self.threads=[]
+        self.started=None;self.closed=False;self.offered=0;self.saved=0;self.dropped=0;self.error=None
+        self.detected=0;self.records=[];self.manifest=[];self.drop_events=[];self.queue_peak=0;self.finalized=None
+    def start(self):
+        if self.folder.exists():raise FileExistsError(self.folder)
+        self.folder.mkdir(parents=True);self.started=monotonic()
+        self.threads=[Thread(target=self._run,name=f'rgbd-writer-{i}') for i in range(self.worker_count)]
+        self.thread=self.threads[0]
+        for worker in self.threads:worker.start()
+    def offer(self,source_frame_id,frame):
+        with self.cv:
+            if self.closed:return False
+            if monotonic()-self.started>=self.max_seconds or self.offered>=self.max_frames:
+                self.closed=True;self.cv.notify_all();return False
+            self.offered+=1
+            if len(self.queue)>=self.capacity:
+                sequence,identity,_,_=self.queue.popleft();self.dropped+=1
+                self.drop_events.append(dict(sequence=sequence,source_frame_id=identity,reason='WRITER_QUEUE_FULL',timestamp=time()))
+            self.queue.append((self.offered,source_frame_id,frame,monotonic()))
+            self.queue_peak=max(self.queue_peak,len(self.queue));self.cv.notify_all();return True
+    def add_detection(self,source_frame_id,result):
+        record=dict(source_frame_id=source_frame_id,capture_timestamp=result['capture_timestamp'],
+            capture_timestamp_source=result.get('capture_timestamp_source','UNAVAILABLE'),
+            result_timestamp=result['result_timestamp'],processing_latency_ms=result['processing_latency_ms'],
+            capture_to_display_call_ms=result.get('capture_to_display_call_ms'),
+            camera_motion_proxy=result.get('camera_motion_proxy'),observation=result.get('observation'),
+            capture_dropped_frames=result.get('capture_dropped_frames'),cad_queue_dropped=result.get('cad_queue_dropped'),
+            objects=[{k:o.get(k) for k in ('object_id','color_label','confidence','bbox','pixel_center','surface_depth_z','candidate_state','tracking_status')} for o in result['objects']],
+            tracking_status=result['tracking_status'])
+        with self.cv:
+            if self.finalized is None:self.records.append(record);self.detected+=1
+    def _write(self,sequence,identity,frame,queued_at):
+        started=monotonic();validate_frame(frame.color_bgr,frame.aligned_depth,frame.intrinsics,frame.depth_scale)
+        temporary=self.folder/f'.partial_{sequence:04d}';temporary.mkdir()
+        images={'raw_color.png':frame.color_bgr,'aligned_depth.png':frame.aligned_depth}
+        if frame.raw_depth is not None:
+            if frame.raw_depth.dtype!=np.uint16:raise ValueError('Raw depth must be uint16')
+            images['raw_depth.png']=frame.raw_depth
+        checksums={};encoding_ms=0.;writing_ms=0.
+        for name,im in images.items():
+            start=monotonic();ok,data=cv2.imencode('.png',im,[cv2.IMWRITE_PNG_COMPRESSION,self.png_compression])
+            if not ok:raise IOError('PNG encode failed: '+name)
+            encoding_ms+=(monotonic()-start)*1000
+            checksums[name]=dict(sha256=hashlib.sha256(data).hexdigest(),bytes=int(data.nbytes),dtype=str(im.dtype),shape=list(im.shape))
+            start=monotonic();data.tofile(str(temporary/name));writing_ms+=(monotonic()-start)*1000
+            if (temporary/name).stat().st_size!=data.nbytes:raise IOError('Incomplete PNG write: '+name)
+        metadata=dict(source_frame_id=identity,sequence=sequence,depth_scale_m_per_unit=frame.depth_scale,
+            timestamps=frame.timestamps,stream_profiles=frame.stream_profiles,alignment_metadata=frame.alignment_metadata,
+            camera_configuration=frame.camera_configuration,
+            raw_depth_intrinsics=asdict(frame.raw_depth_intrinsics) if frame.raw_depth_intrinsics else None,
+            pixel_format='BGR8',aligned_depth_format='Z16_RAW_ALIGNED_TO_COLOR',png_compression=self.png_compression)
+        for name,value in [('camera_intrinsics.json',asdict(frame.intrinsics)),('metadata.json',metadata)]:
+            encoded=json.dumps(value,separators=(',',':'),allow_nan=False).encode('utf-8');(temporary/name).write_bytes(encoded)
+            checksums[name]=dict(sha256=hashlib.sha256(encoded).hexdigest(),bytes=len(encoded))
+        (temporary/'integrity.json').write_text(json.dumps(dict(complete=True,files=checksums),indent=2),encoding='utf-8')
+        target=self.folder/f'frame_{sequence:04d}';temporary.rename(target)
+        return dict(sequence=sequence,source_frame_id=identity,directory=target.name,status='COMPLETE',
+            queue_wait_ms=(started-queued_at)*1000,encoding_ms=encoding_ms,file_write_ms=writing_ms,
+            total_write_ms=(monotonic()-started)*1000,encoded_bytes=sum(v['bytes'] for v in checksums.values()))
+    def _run(self):
+        while True:
+            with self.cv:
+                while not self.queue and not self.closed:self.cv.wait(.2)
+                if not self.queue:return
+                sequence,identity,frame,queued_at=self.queue.popleft()
+            try:
+                record=self._write(sequence,identity,frame,queued_at)
+                with self.cv:self.saved+=1;self.manifest.append(record)
+            except Exception as exc:
+                with self.cv:
+                    self.error=f'{type(exc).__name__}: {exc}';self.dropped+=1
+                    self.drop_events.append(dict(sequence=sequence,source_frame_id=identity,reason='WRITE_FAILED',error=self.error,timestamp=time()))
+    def close(self,capture_dropped=0,timeout=30):
+        with self.cv:
+            if self.finalized is not None:return self.finalized
+            self.closed=True;self.cv.notify_all()
+        deadline=monotonic()+timeout
+        for worker in self.threads:
+            worker.join(max(0,deadline-monotonic()))
+            if worker.is_alive():raise RuntimeError('Recorder did not stop')
+        for name,rows in [('detections.jsonl',self.records),('frame_manifest.jsonl',sorted(self.manifest,key=lambda x:x['sequence'])),('dropped_frames.jsonl',self.drop_events)]:
+            with (self.folder/name).open('w',encoding='utf-8') as stream:
+                for row in rows:stream.write(json.dumps(row,allow_nan=False)+'\n')
+        def stats(key):
+            values=[r[key] for r in self.manifest]
+            return dict(mean_ms=float(np.mean(values)),p95_ms=float(np.percentile(values,95))) if values else None
+        saved_ids={r['source_frame_id'] for r in self.manifest};detected_ids={r['source_frame_id'] for r in self.records}
+        summary=dict(offered=self.offered,saved=self.saved,recorder_dropped=self.dropped,
+            capture_dropped=capture_dropped,detection_rows=self.detected,
+            saved_frames_without_detection=len(saved_ids-detected_ids),saved_frames_without_detection_status='NOT_PROCESSED',
